-- // ====================================================================
-- // THE REANIMATE FUNCTION (Directly from Script 2)
-- // ====================================================================
local c=nil
local function reanimate(customAccessories)
    if cdsb and replicatesignal then
        replicatesignal(cdsb)
        pdloadedtime=osclock()+rst
    end
    
    c=insGet(lp,"Character")
    if not (c and IsDescendantOf(c,ws)) then return end

    local rootpart=FindFirstChildWhichIsA(c,"BasePart")
    if not rootpart then return end

    -- Handle Camera
    local cam = ws.CurrentCamera
    local camcf=insGet(cam,"CFrame")
    insSet(cam,"CameraType",e.CameraType.Scriptable)
    
    local Yvel=0
    local cfr=insGet(rootpart,"CFrame")
    local pos=cfGet(cfr,"Position")
    cfr=cfl(pos,pos+cfGet(cfr,"LookVector")*v3_101)
    
    -- Map Neko Accessories to Gun Script Logic
    -- Script 2 expects {meshid, textureid, Name, C0}
    local accessorylimbs = {}
    
    -- Add Standard R6/R15 Parts so Neko rig attaches correctly
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Head"}) -- Dummy ID to catch Head
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Torso"})
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Left Arm"})
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Right Arm"})
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Left Leg"})
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="Right Leg"})
    table.insert(accessorylimbs, {meshid="1", textureid="1", Name="HumanoidRootPart"})

    -- Import Neko Accessories
    if customAccessories then
        for _, acc in pairs(customAccessories) do
            table.insert(accessorylimbs, {
                meshid = acc.MeshId,
                textureid = acc.TextureId,
                Name = acc.Name,
                C0 = acc.CoordinateFrame or cf_0 -- Convert CoordinateFrame to C0
            })
        end
    end

    local cframes={}
    local joints={}
    local raycastparams=rp()
    raycastparams.FilterType=e.RaycastFilterType.Exclude

    -- // Main Helper Functions //
    local getPart=function(name)
        for i,v in next,cframes do
            if i.Name==name then return i end
        end
        return nil
    end

    local function makePartCons(p, t)
        local con = Connect(GetPropertyChangedSignal(p,"Anchored"),function()
            if insGet(p,"Anchored") and t.p==p then
                t.p=nil
            elseif not t.p then
                t.p=p
            end
        end)
    end

    local function ondes(v)
        if c and IsA(v,"Attachment") and IsDescendantOf(c,ws) then
            local p=insGet(v,"Parent")
            local meshid, textureid = "", ""
            
            if IsA(p,"MeshPart") then
                meshid=insGet(p,"MeshId")
                textureid=insGet(p,"TextureID")
            elseif IsA(p,"BasePart") then
                local sm=FindFirstChildOfClass(p,"SpecialMesh")
                if sm then
                    meshid=insGet(sm,"MeshId")
                    textureid=insGet(sm,"TextureId")
                end
            end
            
            -- Matching Logic
            for i,l in next,accessorylimbs do
                if (not l.p) and (sfind(meshid, l.meshid) or l.meshid=="1") then
                   -- Simplified matching for Neko specific parts
                   if l.meshid == "1" and p.Name ~= l.Name then
                       -- Skip if generic and name doesn't match
                   else
                       local t={Name=l.Name, l=insGet(p,"Position"), m=meshid, t=textureid, p=p}
                       makePartCons(p,t)
                       
                       -- Setup CFrame Table
                       cframes[t]=insGet(p,"CFrame")
                       l.p=t -- Mark as claimed
                       return
                   end
                end
            end
        end
    end

    local function oncharacter()
        local newc = lp.Character
        if newc and newc~=c then
            c = newc
            
            -- // THE WEIRD TP LOGIC (Exactly as requested) //
            local hrp = newc:WaitForChild("HumanoidRootPart", 5)
            if hrp then
                if respawntp==3 then
                    local t=osclock()+0.17
                    if pdloadedtime and pdloadedtime>t then
                        t=pdloadedtime
                    end
                    -- This simulates the underground/sky TP glitch
                    local startcf=cfAdd(cfMul(cfGet(cfr,"Rotation"),angles(1.5707963267948966,0,0)),pos*v3_101+v3_010*min(fpdh+30,v3Get(pos,"Y")-5))
                    while twait() do
                        insSet(hrp,"CFrame",startcf)
                        insSet(hrp,"AssemblyLinearVelocity",v3_0)
                        insSet(hrp,"AssemblyAngularVelocity",v3_0)
                        if osclock()>t then break end
                    end
                end
                
                -- Break Joints / Kill
                local h = newc:FindFirstChild("Humanoid")
                if h then h.Health = 0 end
                
                -- Scan Descendants
                for i,v in next,GetDescendants(newc) do ondes(v) end
                Connect(insGet(newc,"DescendantAdded"),ondes)
            end
        end
    end
    
    Connect(GetPropertyChangedSignal(lp,"Character"), oncharacter)
    oncharacter() -- Initial call

    -- // HEARTBEAT LOOP: PHYSICS ENGINE //
    local con = Connect(heartbeat, function()
        sine=osclock()
        local delta=sine-sine -- 0 delta for stability or calc real delta
        
        -- Logic to keep parts claiming
        for i,v in next,cframes do
            local part=i.p
            if part and part.Parent then
               if insGet(part,"ReceiveAge")==0 then
                   local targetCF = v -- This 'v' is set by the Neko script via the cframes table
                   
                   -- Velocity Calculation (The "FDless" part)
                   local claimpos = part.Position
                   local lastpos = i.l or claimpos
                   local vel = (targetCF.Position - lastpos) / 0.016 -- approx delta
                   
                   -- Anti-Void
                   if novoid and targetCF.Y < novoid then
                       targetCF = targetCF + v3_010 * (novoid - targetCF.Y)
                   end

                   i.l = targetCF.Position
                   
                   -- Apply Velocity
                   local vel1 = vel 
                   if v3Get(vel1,"Magnitude") > 25.01 then
                       insSet(part,"AssemblyLinearVelocity",v3Get(vel1,"Unit")*v3_xzL+v3_net)
                   else
                       insSet(part,"AssemblyLinearVelocity",vel1*v3_xz+v3_net)
                   end
                   
                   insSet(part,"CFrame",targetCF)
                   insSet(part,"AssemblyAngularVelocity",v3_0)
               else
                   -- If we lost the part, reset
                   i.l = part.Position
               end
            end
        end
        
        -- Fix Simulation Radius
        sethiddenproperty(lp,"SimulationRadius", 2147483647)
    end)
    
    return cframes -- Return the table that controls the parts
end


-- // ====================================================================
-- // MYWORLDLIBRARY.START (The Bridge)
-- // ====================================================================

function MyWorldLibrary.Start(options)
    -- 1. Run the Gun Script Reanimate
    local ControlledCFrames = reanimate(options.Accessories)
    
    -- 2. Create the Visual Rig for Neko Script
    local Rig = i("Model")
    Rig.Name = "Rig"
    
    -- Helper to build dummy parts
    local function makeDummyPart(name, size)
        local p = i("Part")
        p.Name = name
        p.Size = size
        p.Transparency = 1 
        p.CanCollide = false
        p.Parent = Rig
        return p
    end
    
    -- Create Standard R6 Parts for Rig
    local Head = makeDummyPart("Head", v3(1,1,1))
    local Torso = makeDummyPart("Torso", v3(2,2,1))
    local Root = makeDummyPart("HumanoidRootPart", v3(2,2,1))
    local LA = makeDummyPart("Left Arm", v3(1,2,1))
    local RA = makeDummyPart("Right Arm", v3(1,2,1))
    local LL = makeDummyPart("Left Leg", v3(1,2,1))
    local RL = makeDummyPart("Right Leg", v3(1,2,1))
    
    local Hum = i("Humanoid")
    Hum.Parent = Rig
    
    Rig.Parent = ws
    lp.Character = Rig -- Trick Neko script into thinking this is our char
    ws.CurrentCamera.CameraSubject = Hum

    -- 3. Create Neko Accessory Dummies
    local AccessoryMap = {} -- [DummyPart] = ReanimateTableEntry
    
    if options.Accessories then
        for _, acc in pairs(options.Accessories) do
            local handle = makeDummyPart(acc.Name, v3(1,1,1)) -- Create a dummy part representing the accessory
            
            -- Find the corresponding entry in the reanimate system
            for tbl, cframe in next, ControlledCFrames do
                -- Match based on mesh/texture/name
                if tbl.Name == acc.Name and (tbl.m == acc.MeshId or tbl.m == "") then
                    AccessoryMap[handle] = tbl
                    break
                end
            end
        end
    end
    
    -- Map Base Parts
    for tbl, _ in next, ControlledCFrames do
        local visualPart = Rig:FindFirstChild(tbl.Name)
        if visualPart then
            AccessoryMap[visualPart] = tbl
        end
    end

    -- 4. THE BRIDGE LOOP
    -- Neko script moves the Dummy Rig. We copy Dummy Rig CFrames to the Gun Script Engine.
    game:GetService("RunService").RenderStepped:Connect(function()
        for visualPart, controlTable in next, AccessoryMap do
            -- Update the target CFrame in the reanimate engine
            ControlledCFrames[controlTable] = visualPart.CFrame
        end
    end)
    
    -- 5. Fling Function (Required by Neko script)
    local function FlingFunc(target)
        -- Placeholder for fling logic if needed
    end

    return {
        Rig = Rig,
        Fling = FlingFunc
    }
end

return MyWorldLibrary
