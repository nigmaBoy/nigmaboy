        local topFrame = Create("Frame", {Name="Top", Size=UDim2.new(1,0,0,FreakyGui.Theme.ElementHeight/1.5), BackgroundTransparency=1, Parent=cf})
        local cl = _CreateBaseLabel(topFrame, {Text=t, Size=UDim2.new(1,-FreakyGui.Theme.Padding*2 - 20,1,0), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0)}, "Text", "_Lbl")
        local previewSize = FreakyGui.Theme.ElementHeight/1.5 - 4
        local cp = Create("Frame",{Name="Preview", Size=UDim2.new(0,previewSize,0,previewSize), Position=UDim2.new(1,-previewSize-FreakyGui.Theme.Padding,0.5,-previewSize/2), BackgroundColor3=defaultColor, BorderSizePixel=0, Parent=topFrame})
        ApplyCorner(cp, 3); ApplyStroke(cp) -- Apply stroke for border

        local sliderFrame = Create("Frame",{Name="Sliders", Size=UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=cf})
        local sliderLayout = Create("UIListLayout",{Parent=sliderFrame, Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder})

        local r, g, b = defaultColor.R*255, defaultColor.G*255, defaultColor.B*255 -- Store as 0-255 for sliders
        local sliders = {}
        local currentColor = defaultColor

        -- *** FIX: Create a temporary object with the correct Window reference for the sliders ***
        local colorPickerInternalObject = { Elements = {}, Window = parentObject.Window }
        if not parentObject.Window then warn("FreakyGui Warning: Parent object for ColorPickerElement '"..t.."' doesn't have a Window reference!") end

        local function updateColor(sourceSliderVal) -- Callback receives the new value
            local rVal = sliders.R and sliders.R:Get() or r
            local gVal = sliders.G and sliders.G:Get() or g
            local bVal = sliders.B and sliders.B:Get() or b
            currentColor = Color3.fromRGB(rVal, gVal, bVal)
            r, g, b = rVal, gVal, bVal -- Update 0-255 values
            cp.BackgroundColor3 = currentColor
            pcall(cb, currentColor)
        end

        -- Use ElementFunctions directly, passing the corrected internal object
        sliders.R = ElementFunctions.AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="R", Min=0, Max=255, Increment=1, Default=r, Callback=updateColor})
        sliders.G = ElementFunctions.AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="G", Min=0, Max=255, Increment=1, Default=g, Callback=updateColor})
        sliders.B = ElementFunctions.AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="B", Min=0, Max=255, Increment=1, Default=b, Callback=updateColor})

        local colorPickerObj = { Frame=cf, Preview=cp, Get=function() return currentColor end, Set=function(newColor, instant)
                newColor = newColor or Color3.new(1,1,1)
                currentColor = newColor; cp.BackgroundColor3 = currentColor;
                r,g,b = math.floor(newColor.R * 255 + 0.5), math.floor(newColor.G * 255 + 0.5), math.floor(newColor.B * 255 + 0.5)
                if sliders.R then sliders.R:Set(r, instant) end
                if sliders.G then sliders.G:Set(g, instant) end
                if sliders.B then sliders.B:Set(b, instant) end
            end
        }
        parentObject.Elements[t] = colorPickerObj; return colorPickerObj
    end

    --[[ Dropdown ]]
    function ElementFunctions:AddDropdown(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Dropdown"; local items=opts.Items or{}; local def=opts.Default or items[1]; local cb=opts.Callback or function(sel)print(t.." selected:"..tostring(sel))end;
        local window = parentObject.Window
        if not window then warn("FreakyGui Error: Dropdown needs a window reference passed down from its parent (Tab/GroupBox)!"); return end

        local df = _CreateBaseFrame(parentContainer, parentLayout, opts, nil, "_DDFrm")
        df.ClipsDescendants = false -- Allow list to overflow
        df.ZIndex = opts.ZIndex or 2 -- Ensure dropdown button is above normal elements
        ApplyTooltip(df, opts.Tooltip)

        local button = Create("TextButton",{Name="Selector", Size=UDim2.new(1,0,1,0), BackgroundColor3=FreakyGui.Theme.Secondary, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Text=" "..(def or ""), Parent=df, AutoButtonColor=false, TextXAlignment = Enum.TextXAlignment.Left})
        ApplyCorner(button); local stroke = ApplyStroke(button)
        CollectionService:AddTag(button, "FreakyGui_Theme_Secondary_BG"); CollectionService:AddTag(button, "FreakyGui_Theme_Text")
        local arrow = _CreateBaseLabel(button, {Name="Arrow", Text="▼", Size=UDim2.new(0,20,1,0), Position=UDim2.new(1,-20,0,0), Align=Enum.TextXAlignment.Center}, "Text", "")

        local listFrame = Create("ScrollingFrame",{Name="List", Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,FreakyGui.Theme.Padding/2), BackgroundColor3=FreakyGui.Theme.DropdownBackground, BorderSizePixel=0, Visible=false, ClipsDescendants=true, CanvasSize=UDim2.new(0,0,0,0), ScrollBarThickness=4, ScrollBarImageColor3=FreakyGui.Theme.Primary, ZIndex=df.ZIndex + 100, Parent=df}) -- High ZIndex
        ApplyCorner(listFrame); ApplyStroke(listFrame)
        CollectionService:AddTag(listFrame, "FreakyGui_Theme_DropdownBackground_BG"); -- Stroke tagged by ApplyStroke
        CollectionService:AddTag(listFrame, "FreakyGui_Theme_Primary_ScrollBar")
        local listLayout = Create("UIListLayout",{Parent=listFrame, Padding=UDim.new(0,0), SortOrder=Enum.SortOrder.LayoutOrder})
        local listPadding = Create("UIPadding", {Parent=listFrame, PaddingLeft=UDim.new(0,3), PaddingRight=UDim.new(0,3), PaddingTop=UDim.new(0,3), PaddingBottom=UDim.new(0,3)})

        local currentSelection = def
        local isOpen = false
        local outsideClickListener = nil

        local function closeDropdown()
            if not isOpen then return end
            isOpen = false
            if FreakyGui.ActiveDropdown and FreakyGui.ActiveDropdown.Button == button then
                 FreakyGui.ActiveDropdown = nil
            end
            arrow.Text = "▼"
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Outline")
            stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1
            listFrame.Visible = false
            if outsideClickListener then outsideClickListener:Disconnect(); outsideClickListener = nil end
            ReleaseInput(window, button) -- Release input capture
        end

        local function openDropdown()
            if isOpen then return end
            -- Try to capture input FIRST, only open if successful
            if not CaptureInput(window, button) then return end

            if FreakyGui.ActiveDropdown then FreakyGui.ActiveDropdown:Close() end -- Close other dropdowns first

            isOpen = true
            FreakyGui.ActiveDropdown = { Button=button, Close=closeDropdown } -- Register this as active
            arrow.Text = "▲"
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Primary") -- Use primary for highlight
            stroke.Color = FreakyGui.Theme.Primary; stroke.Thickness = 1.5
            listFrame.Visible = true
            listFrame.CanvasPosition = Vector2.zero -- Reset scroll
            -- Adjust height dynamically (up to max)
            local contentHeight = listLayout.AbsoluteContentSize.Y + listPadding.PaddingTop.Offset + listPadding.PaddingBottom.Offset
            local listHeight = math.min(contentHeight, FreakyGui.Theme.DropdownMaxHeight)
            listFrame.Size = UDim2.new(1, 0, 0, listHeight)

            -- Handle clicking outside to close
            outsideClickListener = UserInputService.InputBegan:Connect(function(input)
                if not isOpen then if outsideClickListener then outsideClickListener:Disconnect(); outsideClickListener = nil end; return end -- Safety disconnect if closed elsewhere
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    local mousePos = UserInputService:GetMouseLocation()
                    -- Check if mouse is over the button OR the list frame
                    local buttonRect = Rect.new(button.AbsolutePosition, button.AbsolutePosition + button.AbsoluteSize)
                    local listRect = Rect.new(listFrame.AbsolutePosition, listFrame.AbsolutePosition + listFrame.AbsoluteSize)
                    if not buttonRect:Contains(mousePos) and not listRect:Contains(mousePos) then
                        closeDropdown()
                    end
                end
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape and isOpen then
                     closeDropdown()
                end
            end)
        end

        button.MouseButton1Click:Connect(function()
            if isOpen then closeDropdown() else openDropdown() end
        end)

        -- Populate List
        local itemButtons = {}
        local function createItemButton(item)
            local itemText = tostring(item)
            local itemBtn = Create("TextButton",{Name=itemText, Size=UDim2.new(1,0,0,FreakyGui.Theme.ElementHeight-4), BackgroundTransparency=1, Text="  "..itemText, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Parent=listFrame, AutoButtonColor=false, TextXAlignment=Enum.TextXAlignment.Left})
            CollectionService:AddTag(itemBtn, "FreakyGui_Theme_Text")

            itemBtn.MouseEnter:Connect(function() itemBtn.BackgroundColor3 = FreakyGui.Theme.DropdownHover end)
            itemBtn.MouseLeave:Connect(function() itemBtn.BackgroundColor3=Color3.new(); itemBtn.BackgroundTransparency = 1 end) -- Reset BG fully
            itemBtn.MouseButton1Click:Connect(function()
                currentSelection = item
                button.Text = "  "..itemText
                closeDropdown()
                pcall(cb, currentSelection)
            end)
            table.insert(itemButtons, itemBtn)
            return itemBtn
        end

        local function repopulateItems()
             for _, btn in pairs(itemButtons) do btn:Destroy() end; table.clear(itemButtons)
             for _, item in ipairs(items) do createItemButton(item) end
             task.wait() -- Wait for layout calculation
             listFrame.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y)
             -- Update button text if current selection is no longer valid
             local foundCurrent = false
             for _, item in ipairs(items) do if item == currentSelection then foundCurrent = true; break end end
             if not foundCurrent then
                 currentSelection = items[1] -- Select first item
                 button.Text = "  "..(currentSelection or "")
             end
        end
        repopulateItems() -- Initial population

        local dropdownObj = {
            Frame=df, Button=button, ListFrame=listFrame,
            Get=function()return currentSelection end,
            Set=function(newItem)
                local found=false;
                for _,i in pairs(items) do if i==newItem then found=true; break end end;
                if found then currentSelection=newItem; button.Text="  "..tostring(newItem); pcall(cb,currentSelection)
                else warn("FreakyGui Warning: Item not found in dropdown:", newItem) end
            end,
            AddItem=function(item)
                table.insert(items, item);
                repopulateItems()
            end,
            RemoveItem=function(itemToRemove)
                local removed = false
                for i=#items, 1, -1 do
                    if items[i] == itemToRemove then
                        table.remove(items, i)
                        removed = true
                    end
                end
                if removed then repopulateItems() end
            end,
            SetItems=function(newItemsTable)
                 items = newItemsTable or {}
                 repopulateItems()
            end
        }
        parentObject.Elements[t]=dropdownObj; return dropdownObj
    end

end -- End ElementFunctions Scope


