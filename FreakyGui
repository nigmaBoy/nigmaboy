--[[
    MySexyGui - Basic GUI Library v0.1
    A starting point for a custom Roblox GUI library.
]]

-- Services
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

-- Main Library Table
local MySexyGui = {}
MySexyGui.Elements = {} -- Store references if needed later

-- Default Theme (Customize these colors and fonts)
MySexyGui.Theme = {
    Background = Color3.fromRGB(35, 35, 45),
    Primary = Color3.fromRGB(80, 120, 220), -- Accent color
    Secondary = Color3.fromRGB(50, 50, 60), -- Slightly lighter background
    Outline = Color3.fromRGB(20, 20, 25),
    Text = Color3.fromRGB(230, 230, 230),
    TextDisabled = Color3.fromRGB(120, 120, 130),
    Header = Color3.fromRGB(45, 45, 55),
    WindowWidth = 500,
    WindowHeight = 350,
    Font = Enum.Font.GothamSemibold,
    FontSize = 14,
    TitleFontSize = 16,
    CornerRadius = 4,
    ElementHeight = 30,
    SliderHeight = 20, -- Sliders can be shorter
    Padding = 5,
    TabHeight = 30,
}

-- Internal Helper Functions
local function CreateElement(elementType, properties)
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        element[prop] = value
    end
    return element
end

local function ApplyCorner(guiObject)
    local corner = Instance.new("UICorner", guiObject)
    corner.CornerRadius = UDim.new(0, MySexyGui.Theme.CornerRadius)
    return corner
end

local function ApplyStroke(guiObject, color, thickness)
    local stroke = Instance.new("UIStroke", guiObject)
    stroke.Color = color or MySexyGui.Theme.Outline
    stroke.Thickness = thickness or 1
    return stroke
end

-- Window Creation
function MySexyGui:CreateWindow(options)
    options = options or {}
    local windowTitle = options.Title or "MySexyGui Window"
    local width = options.Width or MySexyGui.Theme.WindowWidth
    local height = options.Height or MySexyGui.Theme.WindowHeight

    -- Main ScreenGui
    local screenGui = CreateElement("ScreenGui", {
        Name = "MySexyGui_Window",
        Parent = CoreGui, -- Or gethui() if available/needed
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        ResetOnSpawn = false, -- Keep GUI persistent
    })

    -- Main Window Frame
    local windowFrame = CreateElement("Frame", {
        Name = "WindowFrame",
        Size = UDim2.new(0, width, 0, height),
        Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
        BackgroundColor3 = MySexyGui.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = screenGui,
        Active = true, -- For dragging
        Visible = options.AutoShow == nil or options.AutoShow, -- Show by default unless specified otherwise
    })
    ApplyCorner(windowFrame)
    ApplyStroke(windowFrame)

    -- Top Bar for Title and Dragging
    local topBar = CreateElement("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = MySexyGui.Theme.Header,
        BorderSizePixel = 0,
        Parent = windowFrame,
    })
    local topBarCornerFix = CreateElement("Frame", { -- Fixes top corners
        Name = "TopBarCornerFix",
        Size = UDim2.new(1, 0, 0, MySexyGui.Theme.CornerRadius),
        Position = UDim2.new(0, 0, 1, -MySexyGui.Theme.CornerRadius),
        BackgroundColor3 = MySexyGui.Theme.Header,
        BorderSizePixel = 0,
        ZIndex = topBar.ZIndex -1,
        Parent = topBar,
    })


    -- Title Label
    local titleLabel = CreateElement("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -40, 1, 0), -- Leave space for close button
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Font = MySexyGui.Theme.Font,
        TextSize = MySexyGui.Theme.TitleFontSize,
        TextColor3 = MySexyGui.Theme.Text,
        Text = windowTitle,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = topBar,
    })

    -- Close Button (Simple)
    local closeButton = CreateElement("TextButton", {
        Name = "CloseButton",
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(1, -25, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(200, 50, 50),
        Text = "X",
        Font = MySexyGui.Theme.Font,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Parent = topBar,
    })
    ApplyCorner(closeButton)
    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy() -- Simple close action
    end)

    -- Tab Bar Container
    local tabBar = CreateElement("Frame", {
        Name = "TabBar",
        Size = UDim2.new(1, 0, 0, MySexyGui.Theme.TabHeight),
        Position = UDim2.new(0, 0, 0, topBar.Size.Y.Offset),
        BackgroundTransparency = 1, -- Transparent, background comes from main frame
        BorderSizePixel = 0,
        Parent = windowFrame,
    })
    local tabLayout = CreateElement("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, MySexyGui.Theme.Padding),
        Parent = tabBar,
    })
    local tabLine = CreateElement("Frame", { -- Line below tabs
        Name = "TabLine",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0,0,1,0),
        BackgroundColor3 = MySexyGui.Theme.Outline,
        BorderSizePixel = 0,
        Parent = tabBar,
    })

    -- Main Content Area (holds tab pages)
    local contentArea = CreateElement("Frame", {
        Name = "ContentArea",
        Size = UDim2.new(1, 0, 1, -(topBar.Size.Y.Offset + tabBar.Size.Y.Offset)),
        Position = UDim2.new(0, 0, 0, topBar.Size.Y.Offset + tabBar.Size.Y.Offset),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = windowFrame,
    })

    -- Make Window Draggable
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = windowFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
            local delta = input.Position - dragStart
            windowFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Window Object to return
    local window = {}
    window.ScreenGui = screenGui
    window.Frame = windowFrame
    window.ContentArea = contentArea
    window.TabBar = tabBar
    window.Tabs = {}       -- Store tab pages
    window.TabButtons = {} -- Store tab buttons
    window.ActiveTab = nil

    -- Method to add tabs
    function window:AddTab(tabName)
        local tabIndex = #self.TabButtons + 1

        -- Create Tab Button
        local tabButton = CreateElement("TextButton", {
            Name = tabName .. "_Button",
            Size = UDim2.new(0, 100, 1, 0), -- Auto-size might be better later
            Text = tabName,
            Font = MySexyGui.Theme.Font,
            TextSize = MySexyGui.Theme.FontSize,
            TextColor3 = MySexyGui.Theme.TextDisabled,
            BackgroundColor3 = MySexyGui.Theme.Secondary,
            BorderSizePixel = 0,
            LayoutOrder = tabIndex,
            Parent = self.TabBar,
        })
        local tbCorner = ApplyCorner(tabButton)

        -- Create Tab Content Page (ScrollingFrame)
        local tabPage = CreateElement("ScrollingFrame", {
            Name = tabName .. "_Page",
            Size = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Visible = false, -- Hide initially
            CanvasSize = UDim2.new(0, 0, 0, 0), -- Auto-adjust later
            ScrollBarImageColor3 = MySexyGui.Theme.Primary,
            ScrollBarThickness = 4,
            Parent = self.ContentArea,
        })
        local pageLayout = CreateElement("UIListLayout", {
            Parent = tabPage,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, MySexyGui.Theme.Padding),
        })
        -- Auto-adjust CanvasSize based on content
        pageLayout.Changed:Connect(function()
            tabPage.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y)
        end)

        -- Tab Object
        local tab = {}
        tab.Name = tabName
        tab.Page = tabPage
        tab.Button = tabButton
        tab.Layout = pageLayout
        tab.Elements = {} -- Store elements added to this tab

        self.Tabs[tabName] = tab
        self.TabButtons[tabIndex] = tab

        -- Tab Button Click Logic
        tabButton.MouseButton1Click:Connect(function()
            if self.ActiveTab == tab then return end -- Don't switch if already active

            -- Deactivate old tab
            if self.ActiveTab then
                self.ActiveTab.Page.Visible = false
                self.ActiveTab.Button.BackgroundColor3 = MySexyGui.Theme.Secondary
                self.ActiveTab.Button.TextColor3 = MySexyGui.Theme.TextDisabled
                 ApplyStroke(self.ActiveTab.Button, MySexyGui.Theme.Outline, 0) -- Hide stroke
            end

            -- Activate new tab
            tab.Page.Visible = true
            tabButton.BackgroundColor3 = MySexyGui.Theme.Background -- Match window background
            tabButton.TextColor3 = MySexyGui.Theme.Text
            ApplyStroke(tabButton, MySexyGui.Theme.Outline, 1) -- Show stroke
            self.ActiveTab = tab
        end)

        -- Activate the first tab added
        if not self.ActiveTab then
            tabButton.BackgroundColor3 = MySexyGui.Theme.Background
            tabButton.TextColor3 = MySexyGui.Theme.Text
            ApplyStroke(tabButton, MySexyGui.Theme.Outline, 1)
            tabPage.Visible = true
            self.ActiveTab = tab
        end

        -- Methods for the Tab object (add elements here)
        local elementIndex = 0

        function tab:AddButton(buttonOptions)
            buttonOptions = buttonOptions or {}
            local text = buttonOptions.Text or "Button"
            local callback = buttonOptions.Callback or function() print(text .. " clicked") end
            elementIndex = elementIndex + 1

            local button = CreateElement("TextButton", {
                Name = text .. "_Button",
                Size = UDim2.new(1, 0, 0, MySexyGui.Theme.ElementHeight),
                Text = text,
                BackgroundColor3 = MySexyGui.Theme.Primary,
                TextColor3 = MySexyGui.Theme.Text,
                Font = MySexyGui.Theme.Font,
                TextSize = MySexyGui.Theme.FontSize,
                LayoutOrder = elementIndex,
                Parent = self.Page,
            })
            ApplyCorner(button)

            button.MouseButton1Click:Connect(function()
                pcall(callback) -- Wrap callback in pcall for safety
            end)

            -- Hover effect
            button.MouseEnter:Connect(function() button.BackgroundTransparency = 0.3 end)
            button.MouseLeave:Connect(function() button.BackgroundTransparency = 0 end)

            self.Elements[text] = button -- Store reference
            return button -- Return the instance if needed
        end

        function tab:AddToggle(toggleOptions)
            toggleOptions = toggleOptions or {}
            local text = toggleOptions.Text or "Toggle"
            local defaultValue = toggleOptions.Default or false
            local callback = toggleOptions.Callback or function(state) print(text .. " state: " .. tostring(state)) end
            elementIndex = elementIndex + 1

            local toggleFrame = CreateElement("Frame", {
                Name = text .. "_ToggleFrame",
                Size = UDim2.new(1, 0, 0, MySexyGui.Theme.ElementHeight),
                BackgroundTransparency = 1,
                LayoutOrder = elementIndex,
                Parent = self.Page,
            })

            local toggleLabel = CreateElement("TextLabel", {
                Name = "Label",
                Size = UDim2.new(0.8, -MySexyGui.Theme.Padding, 1, 0), -- Adjust size as needed
                Position = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
                Font = MySexyGui.Theme.Font,
                TextSize = MySexyGui.Theme.FontSize,
                TextColor3 = MySexyGui.Theme.Text,
                Text = text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = toggleFrame,
            })

            local switchSize = 40
            local switchHeight = 20
            local switch = CreateElement("TextButton", { -- Using TextButton for click detection
                Name = "Switch",
                Size = UDim2.new(0, switchSize, 0, switchHeight),
                Position = UDim2.new(1, -switchSize - MySexyGui.Theme.Padding, 0.5, -switchHeight/2),
                BackgroundColor3 = MySexyGui.Theme.Secondary,
                Text = "", -- No text needed
                Parent = toggleFrame,
            })
            ApplyCorner(switch)

            local nubSize = switchHeight - 4
            local nub = CreateElement("Frame", {
                Name = "Nub",
                Size = UDim2.new(0, nubSize, 0, nubSize),
                Position = UDim2.new(0, 2, 0.5, -nubSize/2), -- Start Left
                BackgroundColor3 = MySexyGui.Theme.TextDisabled,
                BorderSizePixel = 0,
                Parent = switch,
            })
            ApplyCorner(nub)

            local state = defaultValue
            local function updateVisuals()
                local targetColor = state and MySexyGui.Theme.Primary or MySexyGui.Theme.Secondary
                local targetNubColor = state and MySexyGui.Theme.Text or MySexyGui.Theme.TextDisabled
                local targetNubPos = state and UDim2.new(1, -nubSize - 2, 0.5, -nubSize/2) or UDim2.new(0, 2, 0.5, -nubSize/2)

                TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
                TweenService:Create(nub, TweenInfo.new(0.2), {BackgroundColor3 = targetNubColor, Position = targetNubPos}):Play()
            end

            switch.MouseButton1Click:Connect(function()
                state = not state
                updateVisuals()
                pcall(callback, state)
            end)

            -- Initial state
            updateVisuals()

            self.Elements[text] = {Frame = toggleFrame, Set = function(newState) state = newState; updateVisuals() end, Get = function() return state end}
            return self.Elements[text]
        end

         function tab:AddSlider(sliderOptions)
            sliderOptions = sliderOptions or {}
            local text = sliderOptions.Text or "Slider"
            local minVal = sliderOptions.Min or 0
            local maxVal = sliderOptions.Max or 100
            local defaultValue = sliderOptions.Default or minVal
            local increment = sliderOptions.Increment or 1
            local suffix = sliderOptions.Suffix or ""
            local callback = sliderOptions.Callback or function(value) print(text .. " value: " .. value) end
            elementIndex = elementIndex + 1

            local sliderFrame = CreateElement("Frame", {
                Name = text .. "_SliderFrame",
                Size = UDim2.new(1, 0, 0, MySexyGui.Theme.SliderHeight + MySexyGui.Theme.FontSize + 2), -- Bar height + Label height
                BackgroundTransparency = 1,
                LayoutOrder = elementIndex,
                Parent = self.Page,
            })

            local sliderLabel = CreateElement("TextLabel", {
                Name = "Label",
                Size = UDim2.new(0.7, 0, 0, MySexyGui.Theme.FontSize),
                Position = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
                Font = MySexyGui.Theme.Font,
                TextSize = MySexyGui.Theme.FontSize,
                TextColor3 = MySexyGui.Theme.Text,
                Text = text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = sliderFrame,
            })

            local valueLabel = CreateElement("TextLabel", {
                Name = "ValueLabel",
                Size = UDim2.new(0.3, -MySexyGui.Theme.Padding, 0, MySexyGui.Theme.FontSize),
                Position = UDim2.new(0.7, MySexyGui.Theme.Padding, 0, 0),
                BackgroundTransparency = 1,
                Font = MySexyGui.Theme.Font,
                TextSize = MySexyGui.Theme.FontSize,
                TextColor3 = MySexyGui.Theme.TextDisabled,
                Text = "", -- Updated later
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = sliderFrame,
            })

            local sliderBar = CreateElement("Frame", {
                Name = "Bar",
                Size = UDim2.new(1, 0, 0, MySexyGui.Theme.SliderHeight / 2.5), -- Thinner bar
                Position = UDim2.new(0, 0, 0, MySexyGui.Theme.FontSize + 5),
                BackgroundColor3 = MySexyGui.Theme.Secondary,
                BorderSizePixel = 0,
                Parent = sliderFrame,
            })
            ApplyCorner(sliderBar)

            local sliderFill = CreateElement("Frame", {
                Name = "Fill",
                Size = UDim2.new(0, 0, 1, 0), -- Starts empty
                BackgroundColor3 = MySexyGui.Theme.Primary,
                BorderSizePixel = 0,
                Parent = sliderBar,
            })
             ApplyCorner(sliderFill) -- Apply to fill too

            local sliderNub = CreateElement("Frame", {
                Name = "Nub",
                Size = UDim2.new(0, 8, 0, MySexyGui.Theme.SliderHeight), -- Nub slightly taller than bar
                Position = UDim2.new(0, -4, 0.5, -MySexyGui.Theme.SliderHeight / 2),
                BackgroundColor3 = MySexyGui.Theme.Text,
                BorderSizePixel = 0,
                ZIndex = sliderBar.ZIndex + 1,
                Parent = sliderBar,
            })
             ApplyCorner(sliderNub)

            local currentValue = defaultValue
            local isDragging = false

            local function roundToIncrement(value)
                return math.floor(value / increment + 0.5) * increment
            end

            local function updateVisuals(value)
                value = math.clamp(value, minVal, maxVal)
                local percentage = (value - minVal) / (maxVal - minVal)
                if maxVal == minVal then percentage = 0 end -- Avoid division by zero

                local roundedValue = roundToIncrement(value)
                local roundedPercentage = (roundedValue - minVal) / (maxVal - minVal)
                if maxVal == minVal then roundedPercentage = 0 end

                sliderFill.Size = UDim2.new(roundedPercentage, 0, 1, 0)
                sliderNub.Position = UDim2.new(roundedPercentage, -sliderNub.AbsoluteSize.X/2 , 0.5, -sliderNub.AbsoluteSize.Y / 2)
                valueLabel.Text = string.format("%.*f", increment < 1 and string.match(tostring(increment), "%.(0*)") and #string.match(tostring(increment), "%.(0*)")+1 or 0, roundedValue) .. suffix
                currentValue = roundedValue -- Store the rounded value
            end

            local function updateFromInput(input)
                local mouseX = input.Position.X
                local barStartX = sliderBar.AbsolutePosition.X
                local barWidth = sliderBar.AbsoluteSize.X
                local percentage = math.clamp((mouseX - barStartX) / barWidth, 0, 1)
                local newValue = minVal + percentage * (maxVal - minVal)
                local roundedValue = roundToIncrement(newValue)

                if roundedValue ~= currentValue then
                    updateVisuals(roundedValue)
                    pcall(callback, currentValue)
                end
            end

             -- Use invisible button for better dragging detection
            local dragArea = CreateElement("TextButton",{
                Name = "DragArea",
                Size = UDim2.new(1,0,1.5,0), -- Make slightly taller than visual bar
                Position = UDim2.new(0,0,0.5, -MySexyGui.Theme.SliderHeight*0.75), -- Center vertically
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = sliderNub.ZIndex + 1,
                Parent = sliderBar
            })

            dragArea.InputBegan:Connect(function(input)
                 if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    updateFromInput(input) -- Update on initial click
                    input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            isDragging = false
                        end
                    end)
                end
            end)

             dragArea.InputChanged:Connect(function(input)
                 if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and isDragging then
                     updateFromInput(input)
                 end
             end)

            -- Initial state
            updateVisuals(currentValue)

            self.Elements[text] = {Frame = sliderFrame, Set = function(newValue) updateVisuals(newValue) end, Get = function() return currentValue end}
            return self.Elements[text]
        end

        -- Add more element types here (Label, Input, etc.)

        return tab
    end

    -- Method to destroy the window
    function window:Destroy()
        if self.ScreenGui then
            self.ScreenGui:Destroy()
        end
    end

    return window
end

-- Return the main library object when loaded
return MySexyGui
