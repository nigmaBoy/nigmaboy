    local function GetNextLayoutOrder(parentLayout) return #parentLayout:GetChildren() + 1 end

    --[[ Base creation helpers (internal) ]]
    local function _CreateBaseFrame(parentContainer, parentLayout, opts, defaultSize, nameSuffix)
        opts = opts or {}
        local order = GetNextLayoutOrder(parentLayout)
        local frame = Create("Frame", {
            Name = (opts.Text or opts.Title or "Element") .. nameSuffix, -- Use Text or Title for name
            Size = opts.Size or defaultSize or UDim2.new(1, -(FreakyGui.Theme.Padding * 2), 0, FreakyGui.Theme.ElementHeight),
            Position = opts.Position, -- Allow overriding position if needed
            BackgroundTransparency = opts.BackgroundTransparency or 1,
            LayoutOrder = order,
            Parent = parentContainer,
            ClipsDescendants = opts.ClipsDescendants or false,
            AutomaticSize = opts.AutomaticSize or Enum.AutomaticSize.None,
        })
        return frame
    end

    local function _CreateBaseLabel(parent, opts, themeColorKey, nameSuffix)
        opts = opts or {}
        local lbl = Create("TextLabel", {
            Name = (opts.Name or "Label") .. nameSuffix,
