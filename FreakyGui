        local sb=Create("Frame",{Name="Bar", Size=UDim2.new(1,-FreakyGui.Theme.Padding*2,0,FreakyGui.Theme.SliderBarHeight), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize+FreakyGui.Theme.Padding*0.2), BackgroundColor3=FreakyGui.Theme.Secondary, BorderSizePixel=0, Parent=sf}); ApplyCorner(sb, FreakyGui.Theme.SliderBarHeight/2)
        CollectionService:AddTag(sb, "FreakyGui_Theme_Secondary_BG")

        local sfll=Create("Frame",{Name="Fill", Size=UDim2.new(0,0,1,0), BackgroundColor3=FreakyGui.Theme.Primary, BorderSizePixel=0, Parent=sb}); ApplyCorner(sfll, FreakyGui.Theme.SliderBarHeight/2)
        CollectionService:AddTag(sfll, "FreakyGui_Theme_Primary_BG")

        local nubSize = FreakyGui.Theme.SliderNubSize
        local sn=Create("Frame",{Name="Nub", Size=UDim2.new(0,nubSize,0,nubSize), Position=UDim2.new(0,-nubSize/2,0.5,-nubSize/2), BackgroundColor3=FreakyGui.Theme.TextActive, BorderSizePixel=0, ZIndex=sb.ZIndex+1, Parent=sb}); ApplyCorner(sn, nubSize*0.4) -- Slightly less round nub
        CollectionService:AddTag(sn, "FreakyGui_Theme_TextActive_BG")

        local cv=def; local isDragging=false; local mouseMoveConn=nil; local mouseReleaseConn=nil
        local function rti(v) if inc==0 then return v end; local iv=1/(inc or 1); return math.floor(v*iv+0.5)/iv end
        local decimalPlaces = 0; if inc > 0 and inc < 1 then local s = tostring(inc); local dot = s:find("%."); if dot then decimalPlaces = math.max(0, #s - dot) end end

        local function uv(v, fromDrag)
            v=math.clamp(v,min,max);local rv=rti(v);
            local p=(max==min)and 0 or((rv-min)/(max-min));
            local tf=UDim2.new(p,0,1,0);
            local tn=UDim2.new(p,-nubSize/2,0.5,-nubSize/2);
            vl.Text=string.format("%."..decimalPlaces.."f",rv)..sfx;
            if cv == rv and not fromDrag then return end -- No visual update needed if value same and not dragging
            cv=rv
            if fromDrag then sfll.Size=tf; sn.Position=tn; else
                local ti=TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
                TweenService:Create(sfll,ti,{Size=tf}):Play();
                TweenService:Create(sn,ti,{Position=tn}):Play();
            end
        end
        local function updateFromInputPos(inputPos)
            local barStartX=sb.AbsolutePosition.X; local barWidth=sb.AbsoluteSize.X; if barWidth<=0 then return end;
            local p=math.clamp((inputPos.X-barStartX)/barWidth,0,1);
            local nv=min+p*(max-min);
            uv(nv,true); -- Update visual instantly during drag
        end
        local function finalizeValue() -- Call callback only when drag ends or clicked
            pcall(cb,cv)
        end
        local function onMouseMove() if isDragging then local mousePos=UserInputService:GetMouseLocation(); updateFromInputPos(mousePos) else if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn=nil end end end
        local function onMouseRelease(input)
            if isDragging and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
                isDragging=false;
                if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn=nil end;
                if mouseReleaseConn then mouseReleaseConn:Disconnect(); mouseReleaseConn=nil end
                ReleaseInput(parentObject.Window, sn)
                TweenService:Create(sn, TweenInfo.new(0.1), {BackgroundColor3=FreakyGui.Theme.TextActive, Size=UDim2.new(0,nubSize,0,nubSize)}):Play() -- Revert nub style
                finalizeValue()
            end
        end

        -- Invisible Drag Area, slightly larger than bar+nub for easier grabbing
        local da=Create("TextButton",{Name="DrgArea", Size=UDim2.new(1,nubSize,0,nubSize*1.5), Position=UDim2.new(0,-nubSize/2,0.5,-(nubSize*1.5)/2), BackgroundTransparency=1, Text="", ZIndex=sn.ZIndex+1, Parent=sb})

        da.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
