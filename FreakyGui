        if not MyWindow or not MyWindow.Frame then warn("Window not found!") return end
        print("Applying Dark Theme...")
        for key, value in pairs(darkThemePreset) do
             FreakyGui.Theme[key] = value
        end
        MyWindow:RefreshTheme()
    end})

    -- Window Control
    tabTheme:AddSeparatorWithText({ Text = "Window Control" })
    tabTheme:AddButton({ Text = "Hide Window (Use Keybind)", Tooltip = "Hides the window. Use "..tostring(MyWindow.Keybind).." to reopen.", Callback = function()
         if MyWindow and MyWindow.Frame then MyWindow:SetVisibility(false) end
    end})
    tabTheme:AddButton({ Text = "Show Window", Callback = function()
         if MyWindow and MyWindow.Frame then MyWindow:SetVisibility(true) end
    end})
    tabTheme:AddButton({ Text = "DESTROY GUI", Tooltip = "Permanently removes this GUI instance.", Callback = function()
        if MyWindow and MyWindow.Destroy then
            MyWindow:Destroy()
            MyWindow = nil -- Clear the reference, important for re-execution
            elements = {} -- Clear element references
            print("FreakyGui Example: Window Destroyed.")
             warn("FreakyGui Example: GUI Destroyed. Re-execute the script to create it again.")
        else
             warn("FreakyGui Example: Window already destroyed or reference lost.")
        end
    end})

end

print("------------------------------------------------------")
print("FreakyGui Executor Example: Setup Complete.")
if MyWindow and MyWindow.Keybind then -- Check if window exists before accessing keybind
    print("Keybind to toggle: " .. tostring(MyWindow.Keybind))
else
    print("Window was not created or already destroyed.")
end
print("------------------------------------------------------")
