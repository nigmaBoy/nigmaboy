    -- Tab Scrolling Update Logic
    local function updateTabBarScroll()
        task.wait() -- Allow layout to update
        local canvasWidth = tabLayout.AbsoluteContentSize.X
        local visibleWidth = tabBar.AbsoluteSize.X
        local scrollButtonsWidth = 0
        local canScrollLeft = tabBar.CanvasPosition.X > 5 -- Add tolerance
        local canScrollRight = tabBar.CanvasPosition.X < math.max(0, canvasWidth - visibleWidth) - 5 -- Add tolerance

        leftScroll.Visible = canScrollLeft
        rightScroll.Visible = canScrollRight
        if canScrollLeft then scrollButtonsWidth = scrollButtonsWidth + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING end
        if canScrollRight then scrollButtonsWidth = scrollButtonsWidth + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING end

        tabBar.Size = UDim2.new(1, -(TAB_AREA_PADDING * 2 + scrollButtonsWidth + SETTINGS_TAB_WIDTH + TAB_AREA_PADDING), 1, 0)
        tabBar.Position = UDim2.new(0, TAB_AREA_PADDING + (canScrollLeft and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING or 0), 0, 0)
        rightScroll.Position = UDim2.new(1, -TAB_AREA_PADDING*2 - SETTINGS_TAB_WIDTH - (canScrollRight and SCROLL_BUTTON_WIDTH or 0), 0, 0)
    end

