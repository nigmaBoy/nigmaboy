            paddingElement.PaddingTop = UDim.new(0, FreakyGui.Theme.GroupBoxTitleHeight + FreakyGui.Theme.GroupBoxPadding)
        end

        local groupBox = {
            Name = title or "GroupBox_"..order, Frame = groupBoxFrame, ContentContainer = contentContainer,
            Layout = contentLayout, Elements = {}, Window = parentObject.Window -- Pass window reference down
        }
