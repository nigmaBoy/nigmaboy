             if closeRect:Contains(Vector2.new(mousePos.X, mousePos.Y)) then return end -- Don't drag if close button clicked

             isWindowDragging=true;windowDragStartMouse=UserInputService:GetMouseLocation();windowDragStartPos=windowFrame.Position;
             if windowMouseMoveConn then windowMouseMoveConn:Disconnect() end; if windowMouseReleaseConn then windowMouseReleaseConn:Disconnect() end;
             windowMouseMoveConn=RunService.RenderStepped:Connect(onWindowMouseMove);
             windowMouseReleaseConn=UserInputService.InputEnded:Connect(onWindowMouseRelease)
         end
    end)

    -- Window Object Definition
    local window = { ScreenGui=screenGui, Frame=windowFrame, ContentArea=contentArea, TabBar=tabBar, TabLayout=tabLayout, Tabs={}, TabButtons={}, ActiveTab=nil, Keybind=keybindCode, IsVisible=screenGui.Enabled, SettingsTab=nil, Elements = {} }
