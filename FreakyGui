-- Globals (Internal)
local TooltipLabel = nil -- Single instance for tooltips

-- Internal Helper Functions
local function GetScreenSize()
    local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1024, 768)
    return viewportSize
end

local function Create(elementType, properties) -- Short alias
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        pcall(function() element[prop] = value end)
    end
    return element
end

local function ApplyCorner(guiObject, radius)
    if not guiObject then return end
    local corner = guiObject:FindFirstChildWhichIsA("UICorner")
    if not corner then corner = Create("UICorner", { Name = "UICorner", Parent = guiObject }) end
    corner.CornerRadius = UDim.new(0, radius or FreakyGui.Theme.CornerRadius); return corner
end

local function ApplyStroke(guiObject, color, thickness)
    if not guiObject then return end
    local stroke = guiObject:FindFirstChildWhichIsA("UIStroke")
    if not stroke then stroke = Create("UIStroke", { Name = "UIStroke", Parent = guiObject }) end
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or FreakyGui.Theme.Outline
    stroke.Thickness = thickness or 1
    stroke.Enabled = (thickness or 1) > 0
    CollectionService:AddTag(stroke, "FreakyGui_Theme_Outline")
    return stroke
end

local function ApplyGradient(guiObject, themeColorKey, themeEnabledKey, themeGradientColorKey, themeGradientTransparencyKey)
    if not guiObject then return end
    local grad = guiObject:FindFirstChildWhichIsA("UIGradient")
    local enabled = FreakyGui.Theme[themeEnabledKey]

    if not enabled then
        if grad then grad:Destroy() end
        return
    end

    if not grad then grad = Create("UIGradient", { Name = "UIGradient", Parent = guiObject }) end

    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, FreakyGui.Theme[themeGradientColorKey]),
        ColorSequenceKeypoint.new(1, FreakyGui.Theme[themeColorKey]) -- Base color at the bottom
    })
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, FreakyGui.Theme[themeGradientTransparencyKey]), -- Top transparency
        NumberSequenceKeypoint.new(1, 0) -- Fully opaque at bottom
    })
    grad.Rotation = 90 -- Top to bottom
    CollectionService:AddTag(grad, "FreakyGui_Theme_Gradient_" .. themeColorKey) -- Tag for updates
end

local function ApplyTooltip(guiObject, text)
    if not text or text == "" then return end -- Only apply if text exists

    guiObject.MouseEnter:Connect(function(x, y)
        if not TooltipLabel then return end -- Should exist, but safety check
        TooltipLabel.Text = text
        local textSize = TextService:GetTextSize(text, FreakyGui.Theme.TooltipFontSize, FreakyGui.Theme.Font, Vector2.new(300, math.huge)) -- Max width 300
        TooltipLabel.Size = UDim2.new(0, textSize.X + FreakyGui.Theme.Padding, 0, textSize.Y + FreakyGui.Theme.Padding / 2)
        TooltipLabel.Position = UDim2.fromOffset(x + 15, y + 10) -- Position below and right of mouse
        -- Ensure tooltip stays on screen (basic implementation)
        local screen = GetScreenSize()
        local absPos = TooltipLabel.AbsolutePosition
        local absSize = TooltipLabel.AbsoluteSize
        local newX, newY = TooltipLabel.Position.X.Offset, TooltipLabel.Position.Y.Offset
        if absPos.X + absSize.X > screen.X - 10 then newX = screen.X - absSize.X - 10 end
        if absPos.Y + absSize.Y > screen.Y - 10 then newY = y - absSize.Y - 10 end -- Move above mouse if below screen
        TooltipLabel.Position = UDim2.fromOffset(newX, newY)
        TooltipLabel.Visible = true
    end)

    guiObject.MouseLeave:Connect(function()
        if TooltipLabel then TooltipLabel.Visible = false end
    end)
end

local function CaptureInput(window, element)
    if not window or not window.ScreenGui then return end
    if FreakyGui.ActiveDropdown and element ~= FreakyGui.ActiveDropdown.Button then return end -- Prevent capture if dropdown is open unless it's the dropdown itself
    FreakyGui.InputCaptureConnections[window.ScreenGui] = element or true
end

local function ReleaseInput(window, element)
    if not window or not window.ScreenGui then return end
    if FreakyGui.InputCaptureConnections[window.ScreenGui] == element then
        FreakyGui.InputCaptureConnections[window.ScreenGui] = nil
    end
end

