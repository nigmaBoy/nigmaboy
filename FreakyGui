                     windowFrame.BackgroundTransparency = 0
                 end
             end)
        end

        if not v then
            if FreakyGui.ActiveDropdown then FreakyGui.ActiveDropdown:Close() end -- Close dropdown on UI hide
            if FreakyGui.InputCaptureConnections[screenGui] then -- If hiding while input is captured (e.g. keybind picker)
                if typeof(FreakyGui.InputCaptureConnections[screenGui]) == "Instance" and FreakyGui.InputCaptureConnections[screenGui]:IsA("TextButton") then
                     -- Attempt to reset keybind picker visually
