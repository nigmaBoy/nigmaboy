    -- Theme Refresh Function
    function window:RefreshTheme()
        print("FreakyGui: Refreshing theme...")
        local startTime = tick()
        -- Iterate through ALL descendants and update based on tags/attributes
        for _, descendant in ipairs(window.Frame:GetDescendants()) do
            if not descendant:IsA("GuiObject") then continue end -- Skip non-GUI

            local tags = CollectionService:GetTags(descendant)
            local handled = false

            -- Handle Backgrounds (BG)
            for _, tag in ipairs(tags) do
                if string.sub(tag, -3) == "_BG" then
                    local themeKey = string.gsub(tag, "FreakyGui_Theme_", "")
                    themeKey = string.gsub(themeKey, "_BG", "")
                    local stateKey = descendant:GetAttribute("ThemeColorKey_BG") -- Check for state-specific override
                    pcall(UpdateElementThemeColor, descendant, "BackgroundColor3", stateKey or themeKey)
                    handled = true; break
                end
            end

            -- Handle Text Colors
            if not handled and descendant:IsA("GuiLabel") then -- TextLabel or TextButton
                 for _, tag in ipairs(tags) do
                     if string.find(tag, "FreakyGui_Theme_") and not string.find(tag, "_BG") and not string.find(tag, "_Outline") and not string.find(tag, "_ScrollBar") and not string.find(tag, "_Gradient") then
                        local themeKey = string.gsub(tag, "FreakyGui_Theme_", "")
                        local stateKey = descendant:GetAttribute("ThemeColorKey_Text")
                        pcall(UpdateElementThemeColor, descendant, "TextColor3", stateKey or themeKey)
                        handled = true; break
                     end
                 end
            end

            -- Handle Strokes (Outline)
            if not handled and descendant:IsA("UIStroke") then
                for _, tag in ipairs(tags) do
                     if string.find(tag, "FreakyGui_Theme_Outline") or string.find(tag, "FreakyGui_Theme_Primary", 1, true) or string.find(tag, "FreakyGui_Theme_TextActive", 1, true) then -- Check for state keys used by some strokes
                        local themeKey = string.gsub(tag, "FreakyGui_Theme_", "")
                        local stateKey = descendant:GetAttribute("ThemeColorKey") -- Strokes use general ThemeColorKey attribute
                        pcall(UpdateElementThemeColor, descendant, "Color", stateKey or themeKey)
                        handled = true; break
                     end
                 end
            end

            -- Handle ScrollBars
            if not handled and descendant:IsA("ScrollingFrame") then
                 for _, tag in ipairs(tags) do
                     if string.find(tag, "_ScrollBar") then
                        local themeKey = string.gsub(tag, "FreakyGui_Theme_", "")
                        themeKey = string.gsub(themeKey, "_ScrollBar", "")
                        pcall(UpdateElementThemeColor, descendant, "ScrollBarImageColor3", themeKey)
                        handled = true; break
                     end
                 end
            end

             -- Handle Gradients
            if not handled and descendant:IsA("UIGradient") then
                 for _, tag in ipairs(tags) do
                     if string.find(tag, "_Gradient_") then
                         local parts = string.split(tag, "_")
                         local baseKey = parts[4] -- e.g., Background
                         local enabled = FreakyGui.Theme[baseKey.."_Gradient_Enabled"]
                         if enabled then
                             descendant.Color = ColorSequence.new({
                                 ColorSequenceKeypoint.new(0, FreakyGui.Theme[baseKey.."_Gradient_Color"]),
                                 ColorSequenceKeypoint.new(1, FreakyGui.Theme[baseKey])
                             })
                             descendant.Transparency = NumberSequence.new({
                                 NumberSequenceKeypoint.new(0, FreakyGui.Theme[baseKey.."_Gradient_Transparency"]),
                                 NumberSequenceKeypoint.new(1, 0)
                             })
                         else
                             descendant.Enabled = false -- Disable gradient if theme flag is off
                         end
                         handled = true; break
                     end
                 end
            end

             -- Special case: Active tab button stroke needs to match outline
             if descendant == window.ActiveTab.Button:FindFirstChildWhichIsA("UIStroke") then
                 descendant.Color = FreakyGui.Theme.Outline
             end
              -- Special case: Active tab button needs background color refresh
             if descendant == window.ActiveTab.Button then
                 descendant.BackgroundColor3 = FreakyGui.Theme.Background
             end
        end
        -- Update singleton tooltip too
        if TooltipLabel then
             TooltipLabel.BackgroundColor3 = FreakyGui.Theme.TooltipBackground
             TooltipLabel.TextColor3 = FreakyGui.Theme.TooltipText
             local stroke = TooltipLabel:FindFirstChildWhichIsA("UIStroke"); if stroke then stroke.Color = FreakyGui.Theme.Outline end
        end
        print("FreakyGui: Theme refresh complete in "..string.format("%.3f", tick()-startTime).."s")
    end

