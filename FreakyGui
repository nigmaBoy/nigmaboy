        if FreakyGui.KeybindConnections[screenGui] then pcall(FreakyGui.KeybindConnections[screenGui].Disconnect, FreakyGui.KeybindConnections[screenGui]); FreakyGui.KeybindConnections[screenGui]=nil; end
