        -- Disconnect keybind listener associated with this window
        if FreakyGui.KeybindConnections[screenGuiRef] then
            pcall(FreakyGui.KeybindConnections[screenGuiRef].Disconnect, FreakyGui.KeybindConnections[screenGuiRef]);
            FreakyGui.KeybindConnections[screenGuiRef]=nil;
        end
        -- Clear input capture state for this window
        if FreakyGui.InputCaptureConnections[screenGuiRef] then
            FreakyGui.InputCaptureConnections[screenGuiRef] = nil
        end
        -- Clear active dropdown if it belonged to this window
        if FreakyGui.ActiveDropdown and FreakyGui.ActiveDropdown.Button and FreakyGui.ActiveDropdown.Button:IsDescendantOf(screenGuiRef) then
            FreakyGui.ActiveDropdown = nil
        end
        -- Disconnect window dragging listeners if active
        if windowMouseMoveConn then pcall(windowMouseMoveConn.Disconnect, windowMouseMoveConn); windowMouseMoveConn = nil end
        if windowMouseReleaseConn then pcall(windowMouseReleaseConn.Disconnect, windowMouseReleaseConn); windowMouseReleaseConn = nil end

        -- Destroy the ScreenGui itself
        pcall(function() screenGuiRef:Destroy() end);

