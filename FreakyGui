-- Internal Helper Functions
local function CreateElement(elementType, properties)
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        element[prop] = value
    end
    return element
end

-- Corrected ApplyCorner function
local function ApplyCorner(guiObject, radius)
    local corner = guiObject:FindFirstChildWhichIsA("UICorner")
    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = guiObject -- Set parent *after* creation
    end
    corner.CornerRadius = UDim.new(0, radius or MySexyGui.Theme.CornerRadius)
    return corner
end

local function ApplyStroke(guiObject, color, thickness)
     local stroke = guiObject:FindFirstChildWhichIsA("UIStroke")
     if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Parent = guiObject
     end
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or MySexyGui.Theme.Outline
    stroke.Thickness = thickness or 1
    stroke.Enabled = (thickness or 1) > 0 -- Enable only if thickness > 0
    return stroke
end

