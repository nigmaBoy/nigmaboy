        local tl = _CreateBaseLabel(tf, { Text=t, Size=UDim2.new(1,0,0,FreakyGui.Theme.FontSize), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0) }, "Text", "_Lbl")
        local tb=Create("TextBox",{Name="Input", Size=UDim2.new(1,-FreakyGui.Theme.Padding*2,0,FreakyGui.Theme.TextboxHeight), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize + FreakyGui.Theme.Padding*0.2), BackgroundColor3=FreakyGui.Theme.Secondary, BorderSizePixel=0, Font=FreakyGui.Theme.Font, Text=placeholder, TextColor3=FreakyGui.Theme.TextDisabled, TextSize=FreakyGui.Theme.FontSize, ClearTextOnFocus=clear, TextXAlignment=Enum.TextXAlignment.Left, Parent=tf})
        ApplyCorner(tb); local stroke = ApplyStroke(tb)
        CollectionService:AddTag(tb, "FreakyGui_Theme_Secondary_BG")
        CollectionService:AddTag(tb, "FreakyGui_Theme_TextDisabled") -- Initial text color tag

        local hasFocused = false
        tb.Focused:Connect(function()
            if not hasFocused and tb.Text == placeholder then
                -- Don't clear if ClearTextOnFocus is false, just change color
                if clear then tb.Text = "" end
                tb.TextColor3 = FreakyGui.Theme.Text
                CollectionService:AddTag(tb, "FreakyGui_Theme_Text")
                CollectionService:RemoveTag(tb, "FreakyGui_Theme_TextDisabled")
                hasFocused = true
            elseif tb.Text ~= placeholder then -- Already has text or was cleared
                 tb.TextColor3 = FreakyGui.Theme.Text
                 CollectionService:AddTag(tb, "FreakyGui_Theme_Text")
                 CollectionService:RemoveTag(tb, "FreakyGui_Theme_TextDisabled")
            end
            stroke.Color = FreakyGui.Theme.Primary; stroke.Thickness = 1.5
            CollectionService:AddTag(stroke, "FreakyGui_Theme_Primary") -- Focused stroke uses Primary
            CollectionService:RemoveTag(stroke, "FreakyGui_Theme_Outline")
            CaptureInput(parentObject.Window, tb)
        end)
        tb.FocusLost:Connect(function(enterPressed)
             if tb.Text == "" then
                 tb.Text = placeholder
                 tb.TextColor3 = FreakyGui.Theme.TextDisabled
                 CollectionService:AddTag(tb, "FreakyGui_Theme_TextDisabled")
                 CollectionService:RemoveTag(tb, "FreakyGui_Theme_Text")
                 hasFocused = false
             end
             stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1
             CollectionService:AddTag(stroke, "FreakyGui_Theme_Outline")
             CollectionService:RemoveTag(stroke, "FreakyGui_Theme_Primary")
             if enterPressed then pcall(cb, tb.Text) end
             ReleaseInput(parentObject.Window, tb)
        end)

        local textboxObj = {Frame=tf, Textbox=tb, Set=function(newText) tb.Text=newText; if newText ~= "" and newText ~= placeholder then tb.TextColor3 = FreakyGui.Theme.Text; CollectionService:AddTag(tb, "FreakyGui_Theme_Text"); CollectionService:RemoveTag(tb, "FreakyGui_Theme_TextDisabled"); hasFocused = true else tb.TextColor3 = FreakyGui.Theme.TextDisabled; CollectionService:AddTag(tb, "FreakyGui_Theme_TextDisabled"); CollectionService:RemoveTag(tb, "FreakyGui_Theme_Text"); hasFocused = false end end, Get=function() return (tb.Text ~= placeholder and tb.Text) or "" end}
        parentObject.Elements[t]=textboxObj; return textboxObj
    end

