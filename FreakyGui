            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = FreakyGui.Theme.Secondary,
            BorderSizePixel = 0,
            LayoutOrder = order,
            Parent = parentContainer,
            ClipsDescendants = false, -- Usually false for groupboxes unless explicitly needed
        })
        ApplyCorner(groupBoxFrame); ApplyStroke(groupBoxFrame)
        CollectionService:AddTag(groupBoxFrame, "FreakyGui_Theme_Secondary_BG")
        ApplyTooltip(groupBoxFrame, opts.Tooltip) -- Tooltip on whole box

        local verticalLayout = Create("UIListLayout", {
            Parent = groupBoxFrame, SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, FreakyGui.Theme.GroupBoxPadding), FillDirection = Enum.FillDirection.Vertical,
            HorizontalAlignment = opts.HorizontalAlign or Enum.HorizontalAlignment.Center, -- Default to center align content? Or Left? Let's stick to Left for now.
            VerticalAlignment = opts.VerticalAlign or Enum.VerticalAlignment.Top,
        })
         local paddingElement = Create("UIPadding", {
             Parent = groupBoxFrame,
             PaddingTop = UDim.new(0, FreakyGui.Theme.GroupBoxPadding), PaddingBottom = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
             PaddingLeft = UDim.new(0, FreakyGui.Theme.GroupBoxPadding), PaddingRight = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
         })

        if title then
            local titleFrame = Create("Frame", {
                Name = "TitleFrame", Size = UDim2.new(1, 0, 0, FreakyGui.Theme.GroupBoxTitleHeight),
                BackgroundColor3 = FreakyGui.Theme.GroupBoxHeader, BorderSizePixel = 0,
                LayoutOrder = 0, Parent = groupBoxFrame, ClipsDescendants = true,
            })
            -- Apply corner only to top corners visually
            ApplyCorner(titleFrame, FreakyGui.Theme.CornerRadius)
            local bottomFix = Create("Frame", { Name="BottomFix", Size=UDim2.new(1,0,0,FreakyGui.Theme.CornerRadius/2), Position=UDim2.new(0,0,1,-FreakyGui.Theme.CornerRadius/2), BackgroundColor3=FreakyGui.Theme.GroupBoxHeader, BorderSizePixel=0, ZIndex=titleFrame.ZIndex-1, Parent=titleFrame})
            CollectionService:AddTag(titleFrame, "FreakyGui_Theme_GroupBoxHeader_BG")
            CollectionService:AddTag(bottomFix, "FreakyGui_Theme_GroupBoxHeader_BG")

            _CreateBaseLabel(titleFrame, { Name = "TitleLabel", Text = title, Size = UDim2.new(1, -FreakyGui.Theme.Padding*2, 1, 0), Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, 0), TextSize=FreakyGui.Theme.FontSize-1 }, "Text", "") -- Slightly smaller title text

            -- Adjust main padding to account for title bar
            paddingElement.PaddingTop = UDim.new(0, FreakyGui.Theme.GroupBoxTitleHeight + FreakyGui.Theme.GroupBoxPadding)
        end

        -- The content container IS the groupbox frame itself, layout manages children
        local groupBox = {
            Name = title or "GroupBox_"..order, Frame = groupBoxFrame, ContentContainer = groupBoxFrame,
            Layout = verticalLayout, Elements = {},
            Window = parentObject.Window -- *** IMPORTANT: Pass window reference down ***
        }
        -- Add element functions to this group box instance
        for funcName, func in pairs(ElementFunctions) do
            -- Use a closure to capture the correct 'groupBox' instance
            groupBox[funcName] = function(passedOpts)
                return func(groupBox, groupBox.ContentContainer, groupBox.Layout, passedOpts)
            end
        end

        parentObject.Elements[groupBox.Name] = groupBox;
        return groupBox
    end

    --[[ Keybind Picker ]]
    function ElementFunctions:AddKeybindPicker(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Keybind"; local def=opts.Default or Enum.KeyCode.RightShift; local cb=opts.Callback or function(kc)print(t.." key:"..tostring(kc))end;
        local window = parentObject.Window
        if not window then warn("FreakyGui Error: KeybindPicker needs a window reference passed down from its parent (Tab/GroupBox)!"); return end

        local kf = _CreateBaseFrame(parentContainer, parentLayout, opts, nil, "_KeyFrm")
        ApplyTooltip(kf, opts.Tooltip)
        local kl = _CreateBaseLabel(kf, {Text=t, Size=UDim2.new(0.5,-FreakyGui.Theme.Padding,1,0), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0)}, "Text", "_Lbl")
        local kb = Create("TextButton",{Name="SetBtn", Size=UDim2.new(0.5,-FreakyGui.Theme.Padding,1,0), Position=UDim2.new(0.5,FreakyGui.Theme.Padding,0,0), BackgroundColor3=FreakyGui.Theme.Secondary, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Text="...", Parent=kf, AutoButtonColor=false}) -- Start with ...
        ApplyCorner(kb); local stroke = ApplyStroke(kb)
        CollectionService:AddTag(kb, "FreakyGui_Theme_Secondary_BG"); CollectionService:AddTag(kb, "FreakyGui_Theme_Text")

        local currentKey = def; local isListening = false; local inputConn = nil

        local function updateButtonText()
             kb.Text = isListening and "Press key..." or "Set: "..tostring(currentKey):gsub("KeyCode.","")
        end

        local function stopListening(fireCallback, newKey)
            if not isListening then return end
            if inputConn then inputConn:Disconnect(); inputConn = nil end
            isListening = false

            if newKey then currentKey = newKey end -- Update key if one was provided

            updateButtonText()
            CollectionService:SetAttribute(kb, "ThemeColorKey_BG", "Secondary") -- State attribute
            kb.BackgroundColor3 = FreakyGui.Theme.Secondary
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Outline") -- State attribute
            stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1
            ReleaseInput(window, kb)

            if fireCallback and newKey then pcall(cb, currentKey) end
        end

        kb.MouseButton1Click:Connect(function()
            if isListening then
                stopListening(false) -- Cancel listening if clicked again
            else
                if not CaptureInput(window, kb) then return end -- Try to capture input
                isListening = true
                updateButtonText()
                CollectionService:SetAttribute(kb, "ThemeColorKey_BG", "Primary") -- State attribute
                kb.BackgroundColor3 = FreakyGui.Theme.Primary
                CollectionService:SetAttribute(stroke, "ThemeColorKey", "TextActive") -- State attribute
                stroke.Color = FreakyGui.Theme.TextActive; stroke.Thickness = 1.5

                inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if not gameProcessed and isListening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            local newKey = input.KeyCode
                            if newKey ~= Enum.KeyCode.Unknown and newKey ~= Enum.KeyCode.NoKey then
                                if newKey == Enum.KeyCode.Escape then
                                    stopListening(false) -- Cancel on Escape
                                else
                                    stopListening(true, newKey) -- Stop and set new key
                                end
                            end
                        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                            -- Check if the click was OUTSIDE the button
                            local mousePos = UserInputService:GetMouseLocation()
                            local absPos, absSize = kb.AbsolutePosition, kb.AbsoluteSize
                            if not (mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y) then
                                 stopListening(false) -- Click outside cancels
                            end
                        end
                    end
                end)
            end
        end)
        updateButtonText() -- Set initial text

        local keybindObj = { Frame=kf, Button=kb, Get=function() return currentKey end, Set=function(newKey) currentKey = newKey; updateButtonText(); if not isListening then pcall(cb, currentKey) end end }
        parentObject.Elements[t]=keybindObj; return keybindObj
    end

     --[[ Color Picker Element (Usable in any tab/groupbox) ]]
    function ElementFunctions:AddColorPickerElement(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Color"; local defaultColor=opts.Default or Color3.new(1,1,1); local cb=opts.Callback or function(clr)print(t.." color:",clr)end;

        local cf = _CreateBaseFrame(parentContainer, parentLayout, opts, UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,0), "_ClrFrm")
