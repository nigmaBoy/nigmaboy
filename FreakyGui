    -- Helper to update tab bar scrolling state
    local function updateTabBarScroll()
        local canvasWidth = tabLayout.AbsoluteContentSize.X
        local visibleWidth = tabBar.AbsoluteSize.X
        local maxScroll = math.max(0, canvasWidth - visibleWidth)

        local canScrollLeft = tabBar.CanvasPosition.X > 0
        local canScrollRight = tabBar.CanvasPosition.X < maxScroll

        leftScroll.Visible = canScrollLeft
        rightScroll.Visible = canScrollRight

        -- Adjust tab bar size dynamically based on scroll button visibility
        local scrollButtonVisibleWidth = (canScrollLeft and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING or 0) + (canScrollRight and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING or 0)
        tabBar.Size = UDim2.new(1, -(TAB_AREA_PADDING * 2 + scrollButtonVisibleWidth + SETTINGS_TAB_WIDTH + TAB_AREA_PADDING), 1, 0)
        tabBar.Position = UDim2.new(0, TAB_AREA_PADDING + (canScrollLeft and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING or 0), 0, 0)
        rightScroll.Position = UDim2.new(1, -TAB_AREA_PADDING - SETTINGS_TAB_WIDTH - TAB_AREA_PADDING - (canScrollRight and SCROLL_BUTTON_WIDTH or 0) , 0, 0)
    end

    -- Connect scroll buttons
    leftScroll.MouseButton1Click:Connect(function()
        local currentPos = tabBar.CanvasPosition.X
        local targetPos = math.max(0, currentPos - MySexyGui.Theme.TabScrollStep)
        TweenService:Create(tabBar, TweenInfo.new(0.2), { CanvasPosition = Vector2.new(targetPos, 0) }):Play()
        task.wait(0.21) updateTabBarScroll() -- Update after tween
    end)
    rightScroll.MouseButton1Click:Connect(function()
        local currentPos = tabBar.CanvasPosition.X
        local canvasWidth = tabLayout.AbsoluteContentSize.X
        local visibleWidth = tabBar.AbsoluteSize.X
        local maxScroll = math.max(0, canvasWidth - visibleWidth)
        local targetPos = math.min(maxScroll, currentPos + MySexyGui.Theme.TabScrollStep)
        TweenService:Create(tabBar, TweenInfo.new(0.2), { CanvasPosition = Vector2.new(targetPos, 0) }):Play()
        task.wait(0.21) updateTabBarScroll() -- Update after tween
    end)

    -- Update scroll state when content size changes
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabBar.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X, 0, 0)
        updateTabBarScroll()
    end)
    -- Initial check
    task.wait() updateTabBarScroll()

    -- Function to set active tab
    function window:SetActiveTab(tabToActivate)
        if self.ActiveTab == tabToActivate then return end

        -- Deactivate old tab
        if self.ActiveTab then
            self.ActiveTab.Page.Visible = false
            self.ActiveTab.Button.BackgroundColor3 = MySexyGui.Theme.Secondary
            self.ActiveTab.Button.TextColor3 = MySexyGui.Theme.TextDisabled
            ApplyStroke(self.ActiveTab.Button, MySexyGui.Theme.Outline, 0)
        end

        -- Activate new tab
        tabToActivate.Page.Visible = true
        tabToActivate.Button.BackgroundColor3 = MySexyGui.Theme.Background -- Match window background
        tabToActivate.Button.TextColor3 = MySexyGui.Theme.TextActive
        ApplyStroke(tabToActivate.Button, MySexyGui.Theme.Outline, 1)

        self.ActiveTab = tabToActivate
    end

