        if v then
            self.ScreenGui.Enabled=v
            windowFrame.Visible=false -- Hide initially
            -- Optional: Add entry animation
            windowFrame.Position = UDim2.new(0.5, -width/2, 0.45, -height/2) -- Start slightly up
            windowFrame.BackgroundTransparency = 0.5
            windowFrame.Visible = true
            TweenService:Create(windowFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -width/2, 0.5, -height/2), BackgroundTransparency = 0}):Play()
