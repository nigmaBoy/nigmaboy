    -- Tab Bar Scrolling Logic
    local function updateTabBarScroll()
        task.wait(); -- Allow layout to update
        if not tabBar or not tabBar.Parent then return end -- Stop if destroyed
        local cw=tabLayout.AbsoluteContentSize.X;
        local vw=tabBar.AbsoluteSize.X;
        local maxS=math.max(0,cw-vw);
        local currentCanvasX = tabBar.CanvasPosition.X
        local canL=currentCanvasX > 5;
        local canR=currentCanvasX < maxS - 5;

        leftScroll.Visible=canL; rightScroll.Visible=canR;

        local leftWidth = canL and (SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING) or 0
        local rightWidth = canR and (SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING) or 0
        local settingsWidth = SETTINGS_TAB_WIDTH + TAB_AREA_PADDING

        local totalReservedWidth = TAB_AREA_PADDING + leftWidth + rightWidth + settingsWidth + TAB_AREA_PADDING -- Padding L, ScrollL, ScrollR, Settings, Padding R
        tabBar.Size=UDim2.new(1,-totalReservedWidth,1,0);
        tabBar.Position=UDim2.new(0, TAB_AREA_PADDING + leftWidth, 0, 0);
        rightScroll.Position=UDim2.new(1, -(TAB_AREA_PADDING + settingsWidth + rightWidth), 0, 0)
        settingsTabButton.Position=UDim2.new(1, -(TAB_AREA_PADDING + settingsWidth), 0, 0)
    end
    leftScroll.MouseButton1Click:Connect(function() if not tabBar or not tabBar.Parent then return end local t=TweenService:Create(tabBar,TweenInfo.new(0.2),{CanvasPosition=Vector2.new(math.max(0,tabBar.CanvasPosition.X-FreakyGui.Theme.TabScrollStep),0)});t:Play();t.Completed:Connect(updateTabBarScroll) end)
    rightScroll.MouseButton1Click:Connect(function() if not tabBar or not tabBar.Parent then return end local maxS=math.max(0,tabLayout.AbsoluteContentSize.X-tabBar.AbsoluteSize.X);local t=TweenService:Create(tabBar,TweenInfo.new(0.2),{CanvasPosition=Vector2.new(math.min(maxS,tabBar.CanvasPosition.X+FreakyGui.Theme.TabScrollStep),0)});t:Play();t.Completed:Connect(updateTabBarScroll) end)
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() if tabBar and tabBar.Parent then tabBar.CanvasSize=UDim2.new(0,tabLayout.AbsoluteContentSize.X,0,0);updateTabBarScroll() end end)
    windowFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateTabBarScroll);
    task.delay(0.1, updateTabBarScroll) -- Initial calculation

    -- Set Active Tab Logic (Updated for theme tagging/attributes)
    function window:SetActiveTab(tabToActivate)
        if not tabToActivate or self.ActiveTab == tabToActivate then return end

        -- Deactivate previous tab
        if self.ActiveTab then
            self.ActiveTab.Page.Visible=false
            if self.ActiveTab.Button then -- Check if button exists (might be settings tab)
                CollectionService:SetAttribute(self.ActiveTab.Button, "ThemeColorKey_BG", "Secondary")
                CollectionService:SetAttribute(self.ActiveTab.Button, "ThemeColorKey_Text", "TextDisabled")
                self.ActiveTab.Button.BackgroundColor3=FreakyGui.Theme.Secondary
                self.ActiveTab.Button.TextColor3=FreakyGui.Theme.TextDisabled
                local stroke = self.ActiveTab.Button:FindFirstChildWhichIsA("UIStroke"); if stroke then stroke.Enabled = false end
            end
        end

        -- Activate new tab
        tabToActivate.Page.Visible=true
        if tabToActivate.Button then
            CollectionService:SetAttribute(tabToActivate.Button, "ThemeColorKey_BG", "Background") -- Active tab matches window BG
            CollectionService:SetAttribute(tabToActivate.Button, "ThemeColorKey_Text", "TextActive")
            tabToActivate.Button.BackgroundColor3=FreakyGui.Theme.Background
            tabToActivate.Button.TextColor3=FreakyGui.Theme.TextActive
            local stroke = tabToActivate.Button:FindFirstChildWhichIsA("UIStroke") or ApplyStroke(tabToActivate.Button) -- Ensure stroke exists
            stroke.Color = FreakyGui.Theme.Outline -- Use outline for active tab border
            stroke.Thickness = 1
            stroke.Enabled = true
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Outline") -- Ensure stroke uses Outline color
        end

        self.ActiveTab=tabToActivate
        -- Ensure the active tab is visible in the scroll frame
        if self.ActiveTab and self.ActiveTab.Button and self.TabBar and self.TabBar.Parent then
            pcall(function() self.TabBar:ScrollToInstance(self.ActiveTab.Button) end)
            task.delay(0.05, updateTabBarScroll) -- Update scroll buttons after scrolling
        end
    end

    -- Theme Refresh Function (Detailed Implementation)
    function window:RefreshTheme()
        if not window or not window.Frame or not window.Frame.Parent then
             print("FreakyGui: Cannot refresh theme, window seems destroyed.")
             return
        end
        print("FreakyGui: Refreshing theme...")
        local startTime = tick()
        local theme = FreakyGui.Theme -- Cache for minor performance

        -- Update base window elements first
        pcall(function()
            windowFrame.BackgroundColor3 = theme.Background
            ApplyStroke(windowFrame, theme.Outline, 1)
            ApplyGradient(windowFrame, "Background", "Background_Gradient_Enabled", "Background_Gradient_Color", "Background_Gradient_Transparency")
            topBar.BackgroundColor3 = theme.Header
            topBarFix.BackgroundColor3 = theme.Header
            ApplyGradient(topBar, "Header", "Header_Gradient_Enabled", "Header_Gradient_Color", "Header_Gradient_Transparency")
            titleLabel.TextColor3 = theme.Text
            titleLabel.Font = theme.Font
            titleLabel.TextSize = theme.TitleFontSize
            tabLine.BackgroundColor3 = theme.Outline
        end)

        -- Iterate through ALL relevant descendants and update based on tags/attributes
        for _, descendant in ipairs(window.Frame:GetDescendants()) do
            if not pcall(function() local _ = descendant.Name end) then continue end -- Skip if object is invalid/destroyed mid-loop
            if not descendant:IsA("GuiObject") and not descendant:IsA("UILayout") then continue end -- Skip non-GUI/Layout

            local tags = CollectionService:GetTags(descendant)
            if #tags == 0 and not descendant:IsA("UIGradient") and not descendant:IsA("UIStroke") then -- Ignore untagged unless it's a stroke/gradient potentially managed by parent
                continue
            end

            -- 1. Background Colors (Frames, Buttons, TextBoxes)
            if descendant:IsA("Frame") or descendant:IsA("TextButton") or descendant:IsA("TextBox") or descendant:IsA("ImageButton") then
                local baseKey = nil
                for _, tag in ipairs(tags) do
                    if string.sub(tag, -3) == "_BG" then
                        baseKey = string.gsub(tag, "FreakyGui_Theme_", "")
                        baseKey = string.gsub(baseKey, "_BG", "")
                        break
                    end
                end
                if baseKey then
                    local stateKey = descendant:GetAttribute("ThemeColorKey_BG") -- Check for state override
                    UpdateElementThemeColor(descendant, "BackgroundColor3", stateKey or baseKey)
                end
            end

            -- 2. Text Colors (Labels, Buttons, TextBoxes)
            if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                 local baseKey = nil
                 for _, tag in ipairs(tags) do
                     -- Match tags like FreakyGui_Theme_Text, FreakyGui_Theme_TextDisabled, FreakyGui_Theme_TextActive
                     if string.find(tag, "FreakyGui_Theme_Text", 1, true) then
                         baseKey = string.gsub(tag, "FreakyGui_Theme_", "")
                         break
                     end
                 end
                 if baseKey then
                     local stateKey = descendant:GetAttribute("ThemeColorKey_Text") -- Check for state override (e.g., textbox focus)
                     UpdateElementThemeColor(descendant, "TextColor3", stateKey or baseKey)
                 end
                 -- Update Font and Size (Less likely to change dynamically, but good practice)
                 pcall(function() descendant.Font = theme.Font end)
                 if descendant:IsA("TextLabel") and descendant.Name ~= "Title" and descendant.Name ~= "SeparatorLabel" then -- Don't override Title/Separator size unless specifically tagged
                     pcall(function() descendant.TextSize = theme.FontSize end)
                 end
                  if descendant:IsA("TextButton") and descendant.Name ~= "CloseButton" and descendant.Name ~= "LeftScroll" and descendant.Name ~= "RightScroll" then
                      pcall(function() descendant.TextSize = theme.FontSize end)
                  end
            end

            -- 3. Strokes (UIStroke)
            if descendant:IsA("UIStroke") then
                local baseKey = nil
                 for _, tag in ipairs(tags) do
                     -- Only match the Outline tag as the *base* intended color
                     if string.find(tag, "FreakyGui_Theme_Outline", 1, true) then
                         baseKey = "Outline"
                         break
                     end
                 end
                 if baseKey then
                     local stateKey = descendant:GetAttribute("ThemeColorKey") -- General state key for strokes (e.g., Primary, TextActive)
                     UpdateElementThemeColor(descendant, "Color", stateKey or baseKey)
                     -- Re-apply thickness based on state or default
                     local parent = descendant.Parent
                     if parent and parent:IsA("TextBox") and parent:GetAttribute("ThemeColorKey") == "Primary" then
                         descendant.Thickness = 1.5 -- Focused textbox
                     elseif parent and parent:IsA("TextButton") and parent:GetAttribute("ThemeColorKey_BG") == "Primary" then
                          descendant.Thickness = 1.5 -- Keybind listening
                     else
                         descendant.Thickness = 1 -- Default thickness
                     end
                 end
            end

            -- 4. ScrollBars (ScrollingFrame)
            if descendant:IsA("ScrollingFrame") then
                 local baseKey = nil
                 for _, tag in ipairs(tags) do
                     if string.find(tag, "_ScrollBar") then
                        baseKey = string.gsub(tag, "FreakyGui_Theme_", "")
                        baseKey = string.gsub(baseKey, "_ScrollBar", "")
                        break
                     end
                 end
                 if baseKey then
                    UpdateElementThemeColor(descendant, "ScrollBarImageColor3", baseKey)
                    descendant.ScrollBarThickness = 4 -- Ensure thickness reset
                 end
            end

             -- 5. Gradients (UIGradient)
            if descendant:IsA("UIGradient") then
                 local baseKey = nil
                 for _, tag in ipairs(tags) do
                     if string.find(tag, "_Gradient_") then
                         local parts = string.split(tag, "_")
                         if #parts >= 4 then baseKey = parts[4] end -- e.g., Background
                         break
                     end
                 end
                 if baseKey then
                     local enabledKey = baseKey.."_Gradient_Enabled"
                     local colorKey = baseKey.."_Gradient_Color"
                     local transKey = baseKey.."_Gradient_Transparency"
                     local enabled = theme[enabledKey]

                     if enabled and theme[colorKey] and theme[baseKey] and theme[transKey] then
                         descendant.Enabled = true
                         descendant.Color = ColorSequence.new({
                             ColorSequenceKeypoint.new(0, theme[colorKey]),
                             ColorSequenceKeypoint.new(1, theme[baseKey])
                         })
                         descendant.Transparency = NumberSequence.new({
                             NumberSequenceKeypoint.new(0, theme[transKey]),
                             NumberSequenceKeypoint.new(1, 0)
                         })
                         descendant.Rotation = 90
                     else
                         descendant.Enabled = false -- Disable gradient if theme flag is off or keys missing
                     end
                 end
            end

            -- 6. Layouts (Padding, Spacing) - Apply relevant theme values
            if descendant:IsA("UIPadding") then
                 -- Apply default padding unless it's clearly overridden (e.g., GroupBox padding)
                 if descendant.Parent == window.ContentArea or (descendant.Parent:IsA("ScrollingFrame") and descendant.Parent.Name:find("_Page")) then
                     descendant.PaddingTop = UDim.new(0,theme.Padding); descendant.PaddingBottom = UDim.new(0,theme.Padding)
                     descendant.PaddingLeft = UDim.new(0,theme.Padding); descendant.PaddingRight = UDim.new(0,theme.Padding)
                 elseif descendant.Parent:IsA("Frame") and descendant.Parent.Name:find("_Frame") and descendant.Parent.Parent ~= window.ContentArea then -- Assume GroupBox padding
                     descendant.PaddingTop = UDim.new(0, theme.GroupBoxPadding); descendant.PaddingBottom = UDim.new(0, theme.GroupBoxPadding)
                     descendant.PaddingLeft = UDim.new(0, theme.GroupBoxPadding); descendant.PaddingRight = UDim.new(0, theme.GroupBoxPadding)
                     -- Re-check if title bar exists and adjust top padding
                     local titleFrame = descendant.Parent:FindFirstChild("TitleFrame")
                     if titleFrame then descendant.PaddingTop = UDim.new(0, theme.GroupBoxTitleHeight + theme.GroupBoxPadding) end
                 end
            elseif descendant:IsA("UIListLayout") then
                 if descendant.Parent == window.ContentArea or (descendant.Parent:IsA("ScrollingFrame") and descendant.Parent.Name:find("_Page")) then
                     descendant.Padding = UDim.new(0,theme.Padding) -- Padding between elements in main page/settings
                 elseif descendant.Parent:IsA("Frame") and descendant.Parent.Name:find("_Frame") then -- GroupBox List Layout
                     descendant.Padding = UDim.new(0,theme.GroupBoxPadding) -- Padding between elements in groupbox
                 end
            end

        end -- End descendant loop

        -- Special handling for the currently active tab button after general refresh
        if window.ActiveTab and window.ActiveTab.Button and window.ActiveTab.Button.Parent then
             window.ActiveTab.Button.BackgroundColor3 = theme.Background
             window.ActiveTab.Button.TextColor3 = theme.TextActive
             local stroke = window.ActiveTab.Button:FindFirstChildWhichIsA("UIStroke")
             if stroke then
                 stroke.Color = theme.Outline
                 stroke.Thickness = 1
                 stroke.Enabled = true
             end
        end

         -- Update singleton tooltip too
        if TooltipLabel and TooltipLabel.Parent == screenGui then -- Ensure it belongs to this window's GUI
             TooltipLabel.BackgroundColor3 = theme.TooltipBackground
             TooltipLabel.TextColor3 = theme.TooltipText
             TooltipLabel.Font = theme.Font
             TooltipLabel.TextSize = theme.TooltipFontSize
             local stroke = TooltipLabel:FindFirstChildWhichIsA("UIStroke"); if stroke then stroke.Color = theme.Outline; stroke.Thickness = 0.5 end
        end
        print("FreakyGui: Theme refresh complete in "..string.format("%.3f", tick()-startTime).."s")
    end

    -- Settings Tab Setup (Now uses GroupBoxes)
    local settingsPage = Create("ScrollingFrame",{Name="Settings_Page",Size=UDim2.new(1,0,1,0),Position=UDim2.new(0,0,0,0),BackgroundTransparency=1,BorderSizePixel=0,Visible=false,CanvasSize=UDim2.new(0,0,0,0),ScrollBarImageColor3=FreakyGui.Theme.Primary,ScrollBarThickness=4,Parent=contentArea})
    CollectionService:AddTag(settingsPage, "FreakyGui_Theme_Primary_ScrollBar")
    local settingsPageLayout = Create("UIListLayout",{Parent=settingsPage,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,FreakyGui.Theme.Padding)});settingsPageLayout.Changed:Connect(function() if settingsPage and settingsPage.Parent then settingsPage.CanvasSize=UDim2.new(0,0,0,settingsPageLayout.AbsoluteContentSize.Y + FreakyGui.Theme.Padding*2) end end) -- Extra padding at bottom
    Create("UIPadding", { Parent=settingsPage, PaddingTop=UDim.new(0,FreakyGui.Theme.Padding), PaddingBottom=UDim.new(0,FreakyGui.Theme.Padding), PaddingLeft=UDim.new(0,FreakyGui.Theme.Padding), PaddingRight=UDim.new(0,FreakyGui.Theme.Padding) })

    window.SettingsTab = {Name="Settings", Page=settingsPage, Button=settingsTabButton, Layout=settingsPageLayout, Elements={}, Window = window} -- Pass window ref
    window.Tabs["Settings"]=window.SettingsTab
    settingsTabButton.MouseButton1Click:Connect(function()window:SetActiveTab(window.SettingsTab)end)
    settingsTabButton.MouseEnter:Connect(function()if window.ActiveTab~=window.SettingsTab then settingsTabButton.BackgroundColor3=Color3.Lerp(FreakyGui.Theme.Secondary,FreakyGui.Theme.Background,0.3)end end)
    settingsTabButton.MouseLeave:Connect(function()if window.ActiveTab~=window.SettingsTab then settingsTabButton.BackgroundColor3=FreakyGui.Theme.Secondary end end)

    -- Assign element functions to the Settings Tab object
    for name,func in pairs(ElementFunctions) do
        window.SettingsTab[name] = function(passedOpts) return func(window.SettingsTab, window.SettingsTab.Page, window.SettingsTab.Layout, passedOpts) end
    end

