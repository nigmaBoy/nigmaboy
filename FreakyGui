     --[[ Textbox ]]
    function ElementFunctions:AddTextbox(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Input"; local placeholder=opts.Placeholder or"Enter text..."; local clear=opts.ClearOnFocus == nil and true or opts.ClearOnFocus; local cb=opts.Callback or function(txt)print(t.." text:"..txt)end;
        local fh = FreakyGui.Theme.TextboxHeight + FreakyGui.Theme.FontSize + FreakyGui.Theme.Padding * 0.5
        local tf = _CreateBaseFrame(parentContainer, parentLayout, opts, UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,fh), "_TxtFrm")
        ApplyTooltip(tf, opts.Tooltip)

        local tl = _CreateBaseLabel(tf, {Text=t, Size=UDim2.new(1,0,0,FreakyGui.Theme.FontSize), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0) }, "Text", "_Lbl")
        local tb=Create("TextBox",{Name="Input", Size=UDim2.new(1,-FreakyGui.Theme.Padding*2,0,FreakyGui.Theme.TextboxHeight), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize + FreakyGui.Theme.Padding*0.2), BackgroundColor3=FreakyGui.Theme.Secondary, BorderSizePixel=0, Font=FreakyGui.Theme.Font, Text=placeholder, TextColor3=FreakyGui.Theme.TextDisabled, TextSize=FreakyGui.Theme.FontSize, ClearTextOnFocus=false, -- IMPORTANT: Disable built-in clear, handle manually
        TextXAlignment=Enum.TextXAlignment.Left, Parent=tf})
        ApplyCorner(tb); local stroke = ApplyStroke(tb)
        CollectionService:AddTag(tb, "FreakyGui_Theme_Secondary_BG")
        CollectionService:AddTag(tb, "FreakyGui_Theme_TextDisabled") -- Initial text color tag

        local hasFocused = false -- Track if focus occurred since text was placeholder
        tb.Focused:Connect(function()
            if not CaptureInput(parentObject.Window, tb) then return end -- Attempt to capture input

            local currentText = tb.Text
            local isPlaceholder = (currentText == placeholder and not hasFocused)

            if isPlaceholder and clear then
                tb.Text = ""
                CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "Text")
                tb.TextColor3 = FreakyGui.Theme.Text
            elseif isPlaceholder and not clear then
                -- Don't clear text, just change color if it was placeholder
                 CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "Text")
                 tb.TextColor3 = FreakyGui.Theme.Text
            else -- Already has user text
                 CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "Text")
                 tb.TextColor3 = FreakyGui.Theme.Text
            end
            hasFocused = true -- Mark as focused at least once

            -- Update stroke
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Primary") -- Focused stroke uses Primary
            stroke.Color = FreakyGui.Theme.Primary; stroke.Thickness = 1.5
        end)

        tb.FocusLost:Connect(function(enterPressed)
             local currentText = tb.Text
             if currentText == "" then
                 tb.Text = placeholder
                 CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "TextDisabled") -- Set attribute for refresh
                 tb.TextColor3 = FreakyGui.Theme.TextDisabled
                 hasFocused = false -- Reset focus tracking if empty
             else
                 -- Ensure text color remains 'Text' even if focus lost with text
                 CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "Text")
                 tb.TextColor3 = FreakyGui.Theme.Text
             end

             -- Update stroke back to default
             CollectionService:SetAttribute(stroke, "ThemeColorKey", "Outline")
             stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1

             if enterPressed then pcall(cb, currentText) end -- Use currentText before it's potentially replaced by placeholder
             ReleaseInput(parentObject.Window, tb)
        end)

        local textboxObj = {
            Frame=tf, Textbox=tb,
            Set=function(newText)
                newText = tostring(newText)
                tb.Text = newText
                if newText ~= "" and newText ~= placeholder then
                    tb.TextColor3 = FreakyGui.Theme.Text
                    CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "Text")
                    hasFocused = true
                else -- Empty or effectively placeholder
                    tb.Text = placeholder -- Ensure placeholder if empty
                    tb.TextColor3 = FreakyGui.Theme.TextDisabled
                    CollectionService:SetAttribute(tb, "ThemeColorKey_Text", "TextDisabled")
                    hasFocused = false
                end
                -- If textbox currently focused, keep focused style even after Set
                if UserInputService:GetFocusedTextBox() == tb then
                     CollectionService:SetAttribute(stroke, "ThemeColorKey", "Primary")
                     stroke.Color = FreakyGui.Theme.Primary; stroke.Thickness = 1.5
                end
            end,
            Get=function() return (tb.Text ~= placeholder and tb.Text) or "" end
        }
        parentObject.Elements[t]=textboxObj; return textboxObj
    end

