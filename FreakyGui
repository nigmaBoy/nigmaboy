    --[[ Keybind Picker ]]
    function ElementFunctions:AddKeybindPicker(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Keybind"; local def=opts.Default or Enum.KeyCode.RightShift; local cb=opts.Callback or function(kc)print(t.." key:"..tostring(kc))end;
        local window = parentObject.Window
        if not window then warn("KeybindPicker needs a window reference!") return end

        local kf = _CreateBaseFrame(parentContainer, parentLayout, opts, nil, "_KeyFrm")
        ApplyTooltip(kf, opts.Tooltip)
        local kl = _CreateBaseLabel(kf, {Text=t, Size=UDim2.new(0.5,-FreakyGui.Theme.Padding,1,0), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0)}, "Text", "_Lbl")
        local kb = Create("TextButton",{Name="SetBtn", Size=UDim2.new(0.5,-FreakyGui.Theme.Padding,1,0), Position=UDim2.new(0.5,FreakyGui.Theme.Padding,0,0), BackgroundColor3=FreakyGui.Theme.Secondary, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Text="Set: "..tostring(def):gsub("KeyCode.",""), Parent=kf, AutoButtonColor=false})
        ApplyCorner(kb); local stroke = ApplyStroke(kb)
        CollectionService:AddTag(kb, "FreakyGui_Theme_Secondary_BG"); CollectionService:AddTag(kb, "FreakyGui_Theme_Text")

        local currentKey = def; local isListening = false; local inputConn = nil

        local function stopListening()
            if inputConn then inputConn:Disconnect(); inputConn = nil end
            isListening = false
            kb.Text = "Set: "..tostring(currentKey):gsub("KeyCode.","")
            kb.BackgroundColor3 = FreakyGui.Theme.Secondary
            CollectionService:SetAttribute(kb, "ThemeColorKey_BG", "Secondary")
            stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1
            CollectionService:SetAttribute(stroke, "ThemeColorKey", "Outline")
            ReleaseInput(window, kb)
        end

        kb.MouseButton1Click:Connect(function()
            if isListening then stopListening()
            else
                if FreakyGui.InputCaptureConnections[window.ScreenGui] then return end -- Don't start if something else has capture
                isListening = true
                kb.Text = "Press key..."
                kb.BackgroundColor3 = FreakyGui.Theme.Primary
                CollectionService:SetAttribute(kb, "ThemeColorKey_BG", "Primary")
                stroke.Color = FreakyGui.Theme.TextActive; stroke.Thickness = 1.5
                CollectionService:SetAttribute(stroke, "ThemeColorKey", "TextActive")
                CaptureInput(window, kb)

                inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if not gameProcessed and isListening then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            local newKey = input.KeyCode
                            if newKey ~= Enum.KeyCode.Unknown and newKey ~= Enum.KeyCode.NoKey and newKey ~= Enum.KeyCode.Escape then -- Escape cancels
                                currentKey = newKey
                                pcall(cb, currentKey)
                                stopListening()
                            elseif newKey == Enum.KeyCode.Escape then
                                stopListening() -- Cancel without changing
                            end
                        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                            stopListening() -- Click off cancels
                        end
                    end
                end)
            end
        end)
        local keybindObj = { Frame=kf, Button=kb, Get=function() return currentKey end, Set=function(newKey) currentKey = newKey; kb.Text = "Set: "..tostring(currentKey):gsub("KeyCode.",""); pcall(cb, currentKey) end }
        parentObject.Elements[t]=keybindObj; return keybindObj
    end

     --[[ Color Picker Element (Usable in any tab/groupbox) ]]
    function ElementFunctions:AddColorPickerElement(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Color"; local defaultColor=opts.Default or Color3.new(1,1,1); local cb=opts.Callback or function(clr)print(t.." color:",clr)end;

        local cf = _CreateBaseFrame(parentContainer, parentLayout, opts, UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,0), "_ClrFrm")
        cf.AutomaticSize = Enum.AutomaticSize.Y
        ApplyTooltip(cf, opts.Tooltip)

        local topFrame = Create("Frame", {Name="Top", Size=UDim2.new(1,0,0,FreakyGui.Theme.ElementHeight/1.5), BackgroundTransparency=1, Parent=cf})
        local cl = _CreateBaseLabel(topFrame, {Text=t, Size=UDim2.new(1,-FreakyGui.Theme.Padding*2 - 20,1,0), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,0)}, "Text", "_Lbl")
        local previewSize = FreakyGui.Theme.ElementHeight/1.5 - 4
        local cp = Create("Frame",{Name="Preview", Size=UDim2.new(0,previewSize,0,previewSize), Position=UDim2.new(1,-previewSize-FreakyGui.Theme.Padding,0.5,-previewSize/2), BackgroundColor3=defaultColor, BorderSizePixel=1, BorderColor3=FreakyGui.Theme.Outline, Parent=topFrame})
        ApplyCorner(cp, 3); ApplyStroke(cp)
        CollectionService:AddTag(cp:FindFirstChildWhichIsA("UIStroke"), "FreakyGui_Theme_Outline")

        local sliderFrame = Create("Frame",{Name="Sliders", Size=UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=cf})
        local sliderLayout = Create("UIListLayout", {Parent=sliderFrame, Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder})

        local r, g, b = defaultColor.R, defaultColor.G, defaultColor.B -- Store as 0-1
        local sliders = {}
        local currentColor = defaultColor

        -- Need to pass the correct parentObject (which has the Window ref)
        local colorPickerInternalObject = { Elements = {}, Window = parentObject.Window }

        local function updateColor(sourceSlider)
            local rVal = sliders.R:Get()
            local gVal = sliders.G:Get()
            local bVal = sliders.B:Get()
            currentColor = Color3.fromRGB(rVal, gVal, bVal)
            r, g, b = currentColor.R, currentColor.G, currentColor.B -- Update 0-1 values
            cp.BackgroundColor3 = currentColor
            pcall(cb, currentColor)
        end

        sliders.R = self:AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="R", Min=0, Max=255, Increment=1, Default=r*255, Callback=updateColor})
        sliders.G = self:AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="G", Min=0, Max=255, Increment=1, Default=g*255, Callback=updateColor})
        sliders.B = self:AddSlider(colorPickerInternalObject, sliderFrame, sliderLayout, {Text="B", Min=0, Max=255, Increment=1, Default=b*255, Callback=updateColor})

        local colorPickerObj = { Frame=cf, Preview=cp, Get=function() return currentColor end, Set=function(newColor)
                currentColor = newColor; cp.BackgroundColor3 = currentColor; r,g,b = newColor.R, newColor.G, newColor.B
                sliders.R:Set(r * 255, true); sliders.G:Set(g * 255, true); sliders.B:Set(b * 255, true)
            end
        }
        parentObject.Elements[t] = colorPickerObj; return colorPickerObj
    end

    --[[ Dropdown ]]
    function ElementFunctions:AddDropdown(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Dropdown"; local items=opts.Items or{}; local def=opts.Default or items[1]; local cb=opts.Callback or function(sel)print(t.." selected:"..tostring(sel))end;

        local df = _CreateBaseFrame(parentContainer, parentLayout, opts, nil, "_DDFrm")
        df.ClipsDescendants = false -- Allow list to overflow
        df.ZIndex = opts.ZIndex or 2 -- Ensure dropdown button is above normal elements
        ApplyTooltip(df, opts.Tooltip)

        local button = Create("TextButton",{Name="Selector", Size=UDim2.new(1,0,1,0), BackgroundColor3=FreakyGui.Theme.Secondary, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Text=" "..(def or ""), Parent=df, AutoButtonColor=false, TextXAlignment = Enum.TextXAlignment.Left})
        ApplyCorner(button); local stroke = ApplyStroke(button)
        CollectionService:AddTag(button, "FreakyGui_Theme_Secondary_BG"); CollectionService:AddTag(button, "FreakyGui_Theme_Text")
        local arrow = _CreateBaseLabel(button, {Name="Arrow", Text="▼", Size=UDim2.new(0,20,1,0), Position=UDim2.new(1,-20,0,0), Align=Enum.TextXAlignment.Center}, "Text", "")

        local listFrame = Create("ScrollingFrame",{Name="List", Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,FreakyGui.Theme.Padding/2), BackgroundColor3=FreakyGui.Theme.DropdownBackground, BorderSizePixel=1, BorderColor3=FreakyGui.Theme.Outline, Visible=false, ClipsDescendants=true, CanvasSize=UDim2.new(0,0,0,0), ScrollBarThickness=4, ScrollBarImageColor3=FreakyGui.Theme.Primary, ZIndex=df.ZIndex + 100, Parent=df}) -- High ZIndex
        ApplyCorner(listFrame); ApplyStroke(listFrame)
        CollectionService:AddTag(listFrame, "FreakyGui_Theme_DropdownBackground_BG"); CollectionService:AddTag(listFrame:FindFirstChildWhichIsA("UIStroke"), "FreakyGui_Theme_Outline")
        CollectionService:AddTag(listFrame, "FreakyGui_Theme_Primary_ScrollBar")
        local listLayout = Create("UIListLayout",{Parent=listFrame, Padding=UDim.new(0,0), SortOrder=Enum.SortOrder.LayoutOrder})
        local listPadding = Create("UIPadding", {Parent=listFrame, PaddingLeft=UDim.new(0,3), PaddingRight=UDim.new(0,3), PaddingTop=UDim.new(0,3), PaddingBottom=UDim.new(0,3)})

        local currentSelection = def
        local isOpen = false

        local function closeDropdown()
            if not isOpen then return end
            isOpen = false
            FreakyGui.ActiveDropdown = nil
            arrow.Text = "▼"
            stroke.Thickness = 1
            listFrame.Visible = false
            ReleaseInput(parentObject.Window, button) -- Release input capture
        end

        local function openDropdown()
            if isOpen then return end
            if FreakyGui.ActiveDropdown then FreakyGui.ActiveDropdown:Close() end -- Close other dropdowns

            isOpen = true
            FreakyGui.ActiveDropdown = { Button=button, Close=closeDropdown }
            arrow.Text = "▲"
            stroke.Thickness = 1.5
            listFrame.Visible = true
            listFrame.CanvasPosition = Vector2.zero -- Reset scroll
            -- Adjust height dynamically (up to max)
            local contentHeight = listLayout.AbsoluteContentSize.Y + listPadding.PaddingTop.Offset + listPadding.PaddingBottom.Offset
            local listHeight = math.min(contentHeight, FreakyGui.Theme.DropdownMaxHeight)
            listFrame.Size = UDim2.new(1, 0, 0, listHeight)
            CaptureInput(parentObject.Window, button) -- Capture input while open
        end

        button.MouseButton1Click:Connect(function()
            if isOpen then closeDropdown() else openDropdown() end
        end)

        -- Populate List
        local function createItemButton(item)
            local itemText = tostring(item)
            local itemBtn = Create("TextButton",{Name=itemText, Size=UDim2.new(1,0,0,FreakyGui.Theme.ElementHeight-4), BackgroundTransparency=1, Text="  "..itemText, TextColor3=FreakyGui.Theme.Text, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Parent=listFrame, AutoButtonColor=false, TextXAlignment=Enum.TextXAlignment.Left})
            CollectionService:AddTag(itemBtn, "FreakyGui_Theme_Text")

            itemBtn.MouseEnter:Connect(function() itemBtn.BackgroundColor3 = FreakyGui.Theme.DropdownHover end)
            itemBtn.MouseLeave:Connect(function() itemBtn.BackgroundTransparency = 1; itemBtn.BackgroundColor3=Color3.new(0,0,0) end) -- Reset BG
            itemBtn.MouseButton1Click:Connect(function()
                currentSelection = item
                button.Text = "  "..itemText
                closeDropdown()
                pcall(cb, currentSelection)
            end)
            return itemBtn
        end

        for _, item in ipairs(items) do
            createItemButton(item)
        end
        listFrame.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y)

        -- Handle clicking outside to close
        local function checkClickOutside(input)
            if not isOpen then return end
            local mousePos = UserInputService:GetMouseLocation()
            -- Check if mouse is over the button OR the list frame
            local buttonRect = Rect.new(button.AbsolutePosition, button.AbsolutePosition + button.AbsoluteSize)
            local listRect = Rect.new(listFrame.AbsolutePosition, listFrame.AbsolutePosition + listFrame.AbsoluteSize)

            if not buttonRect:Contains(mousePos) and not listRect:Contains(mousePos) then
                closeDropdown()
            end
        end
        UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                 checkClickOutside(input)
            end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Escape and isOpen then
                 closeDropdown()
            end
        end)

        local dropdownObj = {Frame=df, Button=button, ListFrame=listFrame, Get=function()return currentSelection end, Set=function(newItem) local found=false; for _,i in pairs(items) do if i==newItem then found=true; break end end; if found then currentSelection=newItem; button.Text="  "..tostring(newItem); pcall(cb,currentSelection) else warn("Item not found in dropdown:", newItem) end end, AddItem=function(item) table.insert(items, item); createItemButton(item); listFrame.CanvasSize = UDim2.new(0,0,0,listLayout.AbsoluteContentSize.Y); end}
        parentObject.Elements[t]=dropdownObj; return dropdownObj
    end

end -- End ElementFunctions Scope


