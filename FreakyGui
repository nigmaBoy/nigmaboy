    --[[ Slider ]]
    function ElementFunctions:AddSlider(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{};local t=opts.Text or"Slider";local min=opts.Min or 0;local max=opts.Max or 100;local def=opts.Default or min;local inc=opts.Increment or 1;local sfx=opts.Suffix or"";local cb=opts.Callback or function(v)print(t.." value:"..v)end;
        local fh=FreakyGui.Theme.SliderBarHeight+FreakyGui.Theme.FontSize+FreakyGui.Theme.Padding*0.5
        local sf = _CreateBaseFrame(parentContainer, parentLayout, opts, UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,fh), "_SldFrm")
