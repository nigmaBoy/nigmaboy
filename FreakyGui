    --[[ Button ]]
    function ElementFunctions:AddButton(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Button"; local cb=opts.Callback or function()print(t.." clicked")end;
        local order = GetNextLayoutOrder(parentLayout)
        local b=Create("TextButton",{Name=t.."_Button", Size=UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,FreakyGui.Theme.ElementHeight), BackgroundColor3=FreakyGui.Theme.Primary, TextColor3=FreakyGui.Theme.TextActive, Font=FreakyGui.Theme.Font, TextSize=FreakyGui.Theme.FontSize, Text=t, LayoutOrder=order, Parent=parentContainer, AutoButtonColor=false})
        ApplyCorner(b); ApplyStroke(b)
        CollectionService:AddTag(b, "FreakyGui_Theme_Primary_BG"); CollectionService:AddTag(b, "FreakyGui_Theme_TextActive") -- Text on buttons is usually active
        ApplyTooltip(b, opts.Tooltip)

        local originalColor = FreakyGui.Theme.Primary -- Store initial, might change with theme refresh
        local hoverColor = FreakyGui.Theme.ButtonHover
        local pressColor = FreakyGui.Theme.ButtonPress

        b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = FreakyGui.Theme.ButtonHover }):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.15), { BackgroundColor3 = FreakyGui.Theme.Primary }):Play() end) -- Use current Primary
        b.MouseButton1Down:Connect(function() TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = FreakyGui.Theme.ButtonPress, Size = UDim2.new(1,-(FreakyGui.Theme.Padding*2 + 4),0,FreakyGui.Theme.ElementHeight-2) }):Play() end) -- Slight shrink+darken
        b.MouseButton1Up:Connect(function()
            -- Check if mouse is still over button before tweening back to hover state
            local mousePos = UserInputService:GetMouseLocation()
            local absPos = b.AbsolutePosition
            local absSize = b.AbsoluteSize
            local isHovering = mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
            local targetColor = isHovering and FreakyGui.Theme.ButtonHover or FreakyGui.Theme.Primary
            TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = targetColor, Size = UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,FreakyGui.Theme.ElementHeight) }):Play();
            pcall(cb)
        end)
        -- b.MouseButton1Click:Connect(function() end) -- Consume click if needed, Up handles action

        parentObject.Elements[t]=b; return b
    end

    --[[ Toggle ]]
    function ElementFunctions:AddToggle(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{}; local t=opts.Text or"Toggle"; local d=opts.Default or false; local cb=opts.Callback or function(s)print(t.." state:"..tostring(s))end;
        local tf = _CreateBaseFrame(parentContainer, parentLayout, opts, nil, "_TogFrm")
        local tl = _CreateBaseLabel(tf, { Text = t, Size = UDim2.new(1, -60 - FreakyGui.Theme.Padding, 1, 0), Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, 0) }, "Text", "_Lbl")
        ApplyTooltip(tf, opts.Tooltip) -- Apply tooltip to frame

        local sws=40; local sh=20;
        local sw=Create("TextButton",{Name="Sw", Size=UDim2.new(0,sws,0,sh), Position=UDim2.new(1,-sws-FreakyGui.Theme.Padding,0.5,-sh/2), BackgroundColor3=FreakyGui.Theme.Secondary, Text="", Parent=tf, AutoButtonColor=false}); ApplyCorner(sw); ApplyStroke(sw, FreakyGui.Theme.Outline, 0.5)
        CollectionService:AddTag(sw, "FreakyGui_Theme_Secondary_BG") -- Base tag is secondary

        local nbs=sh-5;
        local nb=Create("Frame",{Name="Nb", Size=UDim2.new(0,nbs,0,nbs), Position=UDim2.new(0,2.5,0.5,-nbs/2), BackgroundColor3=FreakyGui.Theme.TextDisabled, BorderSizePixel=0, Parent=sw}); ApplyCorner(nb, FreakyGui.Theme.CornerRadius/2)
        CollectionService:AddTag(nb, "FreakyGui_Theme_TextDisabled_BG") -- Base tag is disabled

        local st=d;
        local function upd(instant)
            local bgThemeKey = st and "Primary" or "Secondary"
            local nubThemeKey = st and "TextActive" or "TextDisabled"
            local tc = FreakyGui.Theme[bgThemeKey]
            local tnc = FreakyGui.Theme[nubThemeKey]
            local tnp=st and UDim2.new(1,-nbs-2.5,0.5,-nbs/2) or UDim2.new(0,2.5,0.5,-nbs/2);

            CollectionService:SetAttribute(sw, "ThemeColorKey_BG", bgThemeKey) -- Store state for refresh
            CollectionService:SetAttribute(nb, "ThemeColorKey_BG", nubThemeKey) -- Store state for refresh

            if instant then
                 sw.BackgroundColor3 = tc
                 nb.BackgroundColor3 = tnc
                 nb.Position = tnp
            else
                 local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                 TweenService:Create(sw,tweenInfo,{BackgroundColor3=tc}):Play();
                 TweenService:Create(nb,tweenInfo,{BackgroundColor3=tnc,Position=tnp}):Play();
            end
        end
        sw.MouseButton1Click:Connect(function()st=not st;upd(false);pcall(cb,st)end); upd(true)

        local toggleObj = { Frame=tf, Set=function(ns, instant) ns = not not ns; if st~=ns then st=ns;upd(instant or false);pcall(cb,st)end end, Get=function()return st end };
        parentObject.Elements[t]=toggleObj; return toggleObj
    end

    --[[ Slider ]]
    function ElementFunctions:AddSlider(parentObject, parentContainer, parentLayout, opts)
        opts=opts or{};local t=opts.Text or"Slider";local min=opts.Min or 0;local max=opts.Max or 100;local def=opts.Default or min;local inc=opts.Increment or 1;local sfx=opts.Suffix or"";local cb=opts.Callback or function(v)print(t.." value:"..v)end;
        local fh=FreakyGui.Theme.SliderBarHeight+FreakyGui.Theme.FontSize+FreakyGui.Theme.Padding*0.5
        local sf = _CreateBaseFrame(parentContainer, parentLayout, opts, UDim2.new(1,-(FreakyGui.Theme.Padding*2),0,fh), "_SldFrm")
        ApplyTooltip(sf, opts.Tooltip)

        local sl = _CreateBaseLabel(sf, { Text = t, Size = UDim2.new(0.7,-FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize), Position = UDim2.new(0,FreakyGui.Theme.Padding,0,0) }, "Text", "_Lbl")
        local vl = _CreateBaseLabel(sf, { Size = UDim2.new(0.3,-FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize), Position = UDim2.new(0.7,FreakyGui.Theme.Padding,0,0), Align = Enum.TextXAlignment.Right }, "TextDisabled", "_ValLbl")

        local sb=Create("Frame",{Name="Bar", Size=UDim2.new(1,-FreakyGui.Theme.Padding*2,0,FreakyGui.Theme.SliderBarHeight), Position=UDim2.new(0,FreakyGui.Theme.Padding,0,FreakyGui.Theme.FontSize+FreakyGui.Theme.Padding*0.2), BackgroundColor3=FreakyGui.Theme.Secondary, BorderSizePixel=0, Parent=sf}); ApplyCorner(sb, FreakyGui.Theme.SliderBarHeight/2)
        CollectionService:AddTag(sb, "FreakyGui_Theme_Secondary_BG")

        local sfll=Create("Frame",{Name="Fill", Size=UDim2.new(0,0,1,0), BackgroundColor3=FreakyGui.Theme.Primary, BorderSizePixel=0, Parent=sb}); ApplyCorner(sfll, FreakyGui.Theme.SliderBarHeight/2)
        CollectionService:AddTag(sfll, "FreakyGui_Theme_Primary_BG")

        local nubSize = FreakyGui.Theme.SliderNubSize
        local sn=Create("Frame",{Name="Nub", Size=UDim2.new(0,nubSize,0,nubSize), Position=UDim2.new(0,-nubSize/2,0.5,-nubSize/2), BackgroundColor3=FreakyGui.Theme.TextActive, BorderSizePixel=0, ZIndex=sb.ZIndex+1, Parent=sb}); ApplyCorner(sn, nubSize*0.4) -- Slightly less round nub
        CollectionService:AddTag(sn, "FreakyGui_Theme_TextActive_BG")

        local cv=def; local isDragging=false; local mouseMoveConn=nil; local mouseReleaseConn=nil
        local function rti(v) if inc==0 then return v end; local iv=1/(inc or 1); return math.floor(v*iv+0.5)/iv end
        local decimalPlaces = 0; if inc > 0 and inc < 1 then local s = tostring(inc); local dot = s:find("%."); if dot then decimalPlaces = math.max(0, #s - dot) end end

        local function uv(v, fromDrag)
            v=math.clamp(v,min,max);local rv=rti(v);
            local p=(max==min)and 0 or((rv-min)/(max-min));
            local tf=UDim2.new(p,0,1,0);
            local tn=UDim2.new(p,-nubSize/2,0.5,-nubSize/2);
            vl.Text=string.format("%."..decimalPlaces.."f",rv)..sfx;
            vl.TextColor3 = FreakyGui.Theme.TextDisabled -- Always use disabled color for value label
            if cv == rv and not fromDrag then return end -- No visual update needed if value same and not dragging
            cv=rv
            if fromDrag then
                sfll.Size=tf; sn.Position=tn;
            else
                local ti=TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
                TweenService:Create(sfll,ti,{Size=tf}):Play();
                TweenService:Create(sn,ti,{Position=tn}):Play();
            end
        end
        local function updateFromInputPos(inputPos)
            local barStartX=sb.AbsolutePosition.X; local barWidth=sb.AbsoluteSize.X; if barWidth<=0 then return end;
            local p=math.clamp((inputPos.X-barStartX)/barWidth,0,1);
            local nv=min+p*(max-min);
            uv(nv,true); -- Update visual instantly during drag
        end
        local function finalizeValue() -- Call callback only when drag ends or clicked
            pcall(cb,cv)
        end
        local function onMouseMove()
             if isDragging then
                 local mousePos=UserInputService:GetMouseLocation();
                 updateFromInputPos(mousePos)
            else
                -- Safety disconnect if somehow still connected without dragging
                if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn=nil end
            end
        end
        local function onMouseRelease(input)
            if isDragging and (input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch) then
                isDragging=false;
                if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn=nil end;
                if mouseReleaseConn then mouseReleaseConn:Disconnect(); mouseReleaseConn=nil end
                ReleaseInput(parentObject.Window, sn)
                -- Revert nub style using current theme colors
                TweenService:Create(sn, TweenInfo.new(0.1), {BackgroundColor3=FreakyGui.Theme.TextActive, Size=UDim2.new(0,nubSize,0,nubSize)}):Play()
                finalizeValue()
            end
        end

        -- Invisible Drag Area, slightly larger than bar+nub for easier grabbing
        local da=Create("TextButton",{Name="DrgArea", Size=UDim2.new(1,nubSize,0,nubSize*1.5), Position=UDim2.new(0,-nubSize/2,0.5,-(nubSize*1.5)/2), BackgroundTransparency=1, Text="", ZIndex=sn.ZIndex+1, Parent=sb})

        da.InputBegan:Connect(function(input)
            if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
                if not CaptureInput(parentObject.Window, sn) then return end -- Attempt to capture input
                isDragging=true;

                updateFromInputPos(input.Position); -- Initial position set
                uv(cv, true) -- Ensure visual matches exactly
                -- Highlight nub using current theme colors
                TweenService:Create(sn, TweenInfo.new(0.1), {BackgroundColor3=FreakyGui.Theme.SliderNubDragging, Size=UDim2.new(0,nubSize*1.1,0,nubSize*1.1)}):Play()

                if mouseMoveConn then mouseMoveConn:Disconnect() end;
                if mouseReleaseConn then mouseReleaseConn:Disconnect() end;
                mouseMoveConn=RunService.RenderStepped:Connect(onMouseMove);
                mouseReleaseConn=UserInputService.InputEnded:Connect(onMouseRelease)

                -- If it wasn't a drag (just a click), finalize immediately
                task.delay(0, function() if not isDragging then finalizeValue() end end)
            end
        end)

        uv(cv, false); -- Initial setup
        local sliderObj={Frame=sf,Set=function(nv, instant) local clamped = math.clamp(nv, min, max); local rv = rti(clamped); if cv~=rv then uv(rv, instant or false); pcall(cb,rv) end end,Get=function()return cv end};
        parentObject.Elements[t]=sliderObj;return sliderObj
    end

