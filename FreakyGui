        local nb=Create("Frame",{Name="Nb", Size=UDim2.new(0,nbs,0,nbs), Position=UDim2.new(0,2.5,0.5,-nbs/2), BackgroundColor3=FreakyGui.Theme.TextDisabled, BorderSizePixel=0, Parent=sw}); ApplyCorner(nb, FreakyGui.Theme.CornerRadius/2)
