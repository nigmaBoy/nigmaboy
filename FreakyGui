                uv(cv, true) -- Ensure visual matches exactly
                TweenService:Create(sn, TweenInfo.new(0.1), {BackgroundColor3=FreakyGui.Theme.SliderNubDragging, Size=UDim2.new(0,nubSize*1.1,0,nubSize*1.1)}):Play() -- Highlight nub

                if mouseMoveConn then mouseMoveConn:Disconnect() end;
                if mouseReleaseConn then mouseReleaseConn:Disconnect() end;
                mouseMoveConn=RunService.RenderStepped:Connect(onMouseMove);
                mouseReleaseConn=UserInputService.InputEnded:Connect(onMouseRelease)

                -- Also finalize value immediately on click (if not dragging)
                task.delay(0, function() if not isDragging then finalizeValue() end end)
            end
        end)

        uv(cv, false); -- Initial setup
        local sliderObj={Frame=sf,Set=function(nv, instant) local rv = rti(math.clamp(nv, min, max)); if cv~=rv then uv(rv, false); pcall(cb,rv) end end,Get=function()return cv end};
        parentObject.Elements[t]=sliderObj;return sliderObj
    end

