function getRoot_(v)
    if not v.Character:FindFirstChild(v.Name) then
        if v.Character:FindFirstChild('HumanoidRootPart') then
            return v.Character.HumanoidRootPart
        else
            return v.Character.UpperTorso
        end
    else
        if not v.Character:FindFirstChild('HumanoidRootPart') then
            return v.Character:FindFirstChild(v.Name).HumanoidRootPart
        else
            return v.Character.HumanoidRootPart
        end
    end
end

function Collision(X,Bool)
    for _, v in X.Character:GetDescendants() do
        if (v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Part")) and v.CanCollide == true and not string.match(v.Name, "Fake") and not string.match(v.Name, "Arm") and not string.match(v.Name, "Leg") then
            v.CanCollide = Bool
        end
    end
end

function AnimPlay(ID, SPEED, Time, Smoothing)
	for i,v in OWNER.Character:WaitForChild("Humanoid"):GetPlayingAnimationTracks() do if (v.Animation.AnimationId:match("rbxassetid://"..ID)) then v:Stop() end end
	local animation = Instance.new('Animation', game:GetService("workspace"))
	animation.AnimationId = 'rbxassetid://'..ID
	playing = OWNER.Character:WaitForChild("Humanoid"):LoadAnimation(animation)
	playing.Priority = Enum.AnimationPriority.Action4
	if tonumber(Smoothing) then
		playing:Play(Smoothing) 
	else
		playing:Play() 
	end
	if tonumber(SPEED) then
		playing:AdjustSpeed(SPEED)
	else
		playing:AdjustSpeed(1)
	end
	if tonumber(Time) then
		playing.TimePosition = Time
	end
	animation:Destroy()
end

function AnimStop(ID, SPEED)
	for i,v in OWNER.Character:WaitForChild("Humanoid"):GetPlayingAnimationTracks() do
		if (v.Animation.AnimationId:match("rbxassetid://"..ID)) then
			if tonumber(SPEED) then
				v:Stop(SPEED)
			else
				v:Stop()
			end
		end 
	end
end

function Trail(Bool)
    if Bool then
        for i = 1,5 do
            for _, v in OWNER.Character:GetChildren() do
                if v:IsA("BasePart") and not string.match(v.Name, "Fake") then
                    local Trail = Instance.new("Trail")
                    Trail.Texture = "rbxassetid://1390780157"
                    Trail.Name = "SFXTRAIL"
                    local Attachment0 = Instance.new("Attachment",v)
                    Attachment0.Name = "Attachment0"
                    local Attachment1 = Instance.new("Attachment",getRoot_(OWNER))
                    Attachment1.Name = "Attachment1"
                    Trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Settings["Visual"]["Trail"]["Color"]),ColorSequenceKeypoint.new(1, Settings["Visual"]["Trail"]["Color"])})
                    Trail.Lifetime = Settings["Visual"]["Trail"]["Lifetime"]
                    Trail.Attachment0 = Attachment0
                    Trail.Attachment1 = Attachment1
                    Trail.Parent = v
                end
            end
        end
    else
        for _, a in OWNER.Character:GetDescendants() do
            if a.Name == "SFXTRAIL" or a.Name == "Attachment0" or a.Name == "Attachment1" then
                a:Destroy()
            end
        end
    end
end

function HitEffect(Player, Type)
    if not Asset["HitAsset"] or not Asset["HitAsset"][Type] then return end

    local Attachment
    if Type == "Tornado" then
        Attachment = Instance.new("Attachment", Player.Character:FindFirstChild("LowerTorso"))
        Attachment.Orientation = Vector3.new(-90, 0, 0)
        Attachment.Position = Vector3.new(0, -1.5, 0)
    else
        Attachment = Instance.new("Attachment", Player.Character:FindFirstChild("HumanoidRootPart"))
        Attachment.Orientation = Vector3.new(0, 0, 0)
    end

    if Type == "Pulse" then
        Player.Character.Archivable = true
        local Clone = Player.Character:Clone()
        Clone.Parent = workspace
        Clone.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        for _, v in Clone:GetDescendants() do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.ForceField
                v.Color = Color3.fromRGB(255,255,255)
                v.CanCollide = false
                v.Anchored = true
                TweenService:Create(v, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {Transparency = 1}):Play()
            end
            if v:IsA("Accessory") or v:IsA("Tool") then
                v:Destroy()
            end
            if v.Name == "Head" and v:FindFirstChild("face") then
                v.face:Destroy()
            end
        end
        for i,v in Player.Character:GetDescendants() do
            if v:IsA("BasePart") then
                if Clone:FindFirstChild(v.Name) then
                    Clone:FindFirstChild(v.Name).CFrame = v.CFrame
                end
            end
        end
        Clone:PivotTo(Player.Character.PrimaryPart.CFrame)
        Player.Character.Archivable = false
        game:GetService('Debris'):AddItem(Clone, 2)
    elseif Type == "Shard" then
        local object = game:GetObjects("rbxassetid://125115196741368")[1]
        local wisp = game:GetObjects("rbxassetid://139168481251179")[1]
        local explosion = game:GetObjects("rbxassetid://77298741007658")[1]
        
        object.Parent = workspace
