-- Modified weapon purchase function with auto-equip
function BuyWeapon(weaponName, price)
    repeat RunService.Heartbeat:Wait()
        CustomOffsets(workspace.Ignored.Shop[weaponName.." - $"..price].Head.CFrame * CFrame.new(0,-5,0))
        fireclickdetector(workspace.Ignored.Shop[weaponName.." - $"..price].ClickDetector)
    until OWNER.Backpack:FindFirstChild(weaponName)
    
    -- Immediately equip the weapon
    local tool = OWNER.Backpack:FindFirstChild(weaponName)
    if tool then
        tool.Parent = OWNER.Character
    end
end

-- Tool positioning function
function PositionTool(toolName, grips)
    local count = 0
    -- Get tools from both backpack and character
    for _, v in pairs(OWNER.Backpack:GetChildren()) do
        if v.Name == toolName then
            v.Parent = OWNER.Character
            v.Grip = grips[count + 1]
            count = count + 1
            if count >= #grips then break end
        end
    end
    for _, v in pairs(OWNER.Character:GetChildren()) do
        if v.Name == toolName and v:IsA("Tool") then
            v.Grip = grips[count + 1]
            count = count + 1
            if count >= #grips then break end
        end
    end
end

