                        getRoot_(OWNER).Velocity = getRoot_(OWNER).Velocity + Vector3.new(0, 60, 0)
                    end
                end)
            else
                Disconnect(Settings["Cache"]["Connection"]["RagdollMove"])
                Disconnect(Settings["Cache"]["Connection"]["RagdollJump"])
                getRoot_(OWNER).Shape = Enum.PartType.Block
