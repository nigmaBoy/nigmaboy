                        getRoot_(OWNER).RotVelocity -= workspace.CurrentCamera.CFrame.RightVector * delta * Settings["Player"]["RagdollSpeed"]
                    end
                    if UserInputService:IsKeyDown("A") then
                        getRoot_(OWNER).RotVelocity -= workspace.CurrentCamera.CFrame.LookVector * delta * Settings["Player"]["RagdollSpeed"]
                    end
                    if UserInputService:IsKeyDown("S") then
                        getRoot_(OWNER).RotVelocity += workspace.CurrentCamera.CFrame.RightVector * delta * Settings["Player"]["RagdollSpeed"]
                    end
                    if UserInputService:IsKeyDown("D") then
                        getRoot_(OWNER).RotVelocity += workspace.CurrentCamera.CFrame.LookVector * delta * Settings["Player"]["RagdollSpeed"]
                    end
