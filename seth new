function StrafeTypes()
    local moveDir = getHumanoid(TARGET).MoveDirection * Settings["Target"]["Prediction"]
    if Settings["Target"]["OffsetType"] == "X" then moveDir = Vector3.new(moveDir.X, 0, 0)
    elseif Settings["Target"]["OffsetType"] == "Y" then moveDir = Vector3.new(0, moveDir.Y, 0) 
    elseif Settings["Target"]["OffsetType"] == "Z" then moveDir = Vector3.new(0, 0, moveDir.Z) end
    
    if Settings["Target"]["StrafeTypes"] == "CFrame" then
        getRoot_(OWNER).CFrame = CFrame.new(getRoot_(TARGET).Position + moveDir) * CFrame.Angles(0, Settings["Target"]["StrafeSpeed"] * math.pi * Settings["Cache"]["Interger"]["Delta"], 0) * CFrame.new(0, 0, Settings["Target"]["Distance"])
    elseif Settings["Target"]["StrafeTypes"] == "Velocity" then
        getRoot_(OWNER).CFrame = CFrame.new(getRoot_(TARGET).Position + moveDir + moveDir * getRoot_(TARGET).Velocity.Magnitude) * CFrame.Angles(0, Settings["Target"]["StrafeSpeed"] * math.pi * Settings["Cache"]["Interger"]["Delta"], 0) * CFrame.new(0, 0, Settings["Target"]["Distance"])
    elseif Settings["Target"]["StrafeTypes"] == "WalkSpeed" then
        getRoot_(OWNER).CFrame = CFrame.new(getRoot_(TARGET).Position + moveDir + moveDir * getHumanoid(TARGET).WalkSpeed) * CFrame.Angles(0, Settings["Target"]["StrafeSpeed"] * math.pi * Settings["Cache"]["Interger"]["Delta"], 0) * CFrame.new(0, 0, Settings["Target"]["Distance"])
    elseif Settings["Target"]["StrafeTypes"] == "Random" then
        getRoot_(OWNER).CFrame = CFrame.new(getRoot_(TARGET).Position + moveDir + Vector3.new(math.cos(tick() * Settings["Target"]["StrafeSpeed"]) * (Settings["Target"]["Offset"].X + Settings["Target"]["Distance"]) + math.random(-Settings["Target"]["Distance"], Settings["Target"]["Distance"]), Settings["Target"]["Offset"].Y + math.random(-Settings["Target"]["Distance"], Settings["Target"]["Distance"]), math.sin(tick() * Settings["Target"]["StrafeSpeed"]) * (Settings["Target"]["Offset"].Z + Settings["Target"]["Distance"]) + math.random(-Settings["Target"]["Distance"], Settings["Target"]["Distance"]) )) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
    elseif Settings["Target"]["StrafeTypes"] == "Above" then
        getRoot_(OWNER).CFrame = CFrame.new(getRoot_(TARGET).Position + moveDir) * CFrame.new(0, Settings["Target"]["Distance"], 0) * CFrame.Angles(0, math.rad((tick() % .1) / .1 * 360), 0)
    end
end

function CreateClone(player)
    if Settings["Visual"]["Visualizer"]["Storage"] then return end
    if player then
        player.Character.Archivable = true
        local Cloned = player.Character:Clone()
        Settings["Visual"]["Visualizer"]["Storage"] = Cloned
        Cloned.Parent = workspace
        for _, v in Cloned:GetChildren() do
            if v:IsA("BasePart") then
                v.CanCollide = false
                v.Material = Enum.Material.Neon
                v.Color = Settings["Visual"]["Visualizer"]["Color"]
                v.Anchored = true
            else
                v:Destroy()
            end
        end
        if Cloned:FindFirstChild("Head") and Cloned.Head:FindFirstChild("face") then
            Cloned.Head.face:Destroy()
        end
        task.spawn(function()
            while Settings["Visual"]["Visualizer"]["Storage"] do
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    Settings["Visual"]["Visualizer"]["Storage"]:PivotTo(player.Character.HumanoidRootPart.CFrame)
                end
                task.wait()
            end
        end)
    end
end

