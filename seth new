    elseif Type == "Glitch" then
        local Particle = game:GetObjects("rbxassetid://100133891560919")[1]
        Particle.Parent = Attachment
        Particle.Color = ColorSequence.new(Settings["Visual"]["Particle"]["Color1"],Settings["Visual"]["Particle"]["Color2"],Settings["Visual"]["Particle"]["Color3"])
        Particle.Transparency = NumberSequence.new(0, 1)
    elseif Type == "Whirl" then
