-- Function to lock the grabbed player
local function LockPlayer(target, bodyPartConfig)
    if target and target.Character then
        local rootPart = target.Character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local heartbeatConnection
            local jerking = false
            local jerkTime = 0
            local jerkSpeed = 20
            local jerkAmount = 0.5

            heartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
                -- Base position calculation
                local targetPosition = LocalPlayer.Character.HumanoidRootPart.Position + 
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.RightVector * bodyPartConfig["UpperTorso"].Offset.X) + 
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.UpVector * bodyPartConfig["UpperTorso"].Offset.Y) + 
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * bodyPartConfig["UpperTorso"].Offset.Z)

                -- 90-degree rotation for all CFrame grabs
                local rotationOffset = CFrame.Angles(0, math.rad(90), 0)
                rootPart.CFrame = CFrame.new(targetPosition) 
                    * LocalPlayer.Character.HumanoidRootPart.CFrame.Rotation 
                    * rotationOffset

                -- Apply body part offsets
                for partName, config in pairs(bodyPartConfig) do
                    local part = target.Character:FindFirstChild(partName)
                    if part then
                        part.CFrame = rootPart.CFrame:ToWorldSpace(CFrame.new(config.Offset) * config.Rotation)
                    end
                end

                -- Smooth jerking animation (Test Tool and Jerk Off Tool only)
                if bodyPartConfig == TestToolBodyPartConfig or bodyPartConfig == JerkOffBodyPartConfig then
                    jerkTime += deltaTime * jerkSpeed
                    local rightUpperArm = target.Character:FindFirstChild("RightUpperArm")
                    local rightLowerArm = target.Character:FindFirstChild("RightLowerArm")
                    if rightUpperArm and rightLowerArm then
                        local jerkOffset = math.sin(jerkTime) * jerkAmount
                        rightUpperArm.CFrame = rightUpperArm.CFrame * CFrame.new(jerkOffset, 0, 0)
                        rightLowerArm.CFrame = rightLowerArm.CFrame * CFrame.new(jerkOffset, 0, 0)
                    end
                end
            end)

            Grabbed = true
            target.Character.Humanoid.Died:Connect(function()
                heartbeatConnection:Disconnect()
                Grabbed = false
            end)

            game.Players.LocalPlayer.Character.BodyEffects.Grabbed:GetPropertyChangedSignal("Value"):Connect(function()
                if game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value == nil then
                    heartbeatConnection:Disconnect()
                    Grabbed = false
                end
            end)
        end
    end
end

