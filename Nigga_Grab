-- Function to make the grabbed player follow behind the LocalPlayer
local function RegularGrab(target)
    if target and target.Character then
        local upperTorso = target.Character:FindFirstChild("UpperTorso")
        if upperTorso then
            -- Remove existing BodyPosition and BodyGyro if they exist
            if upperTorso:FindFirstChild("BodyPosition") then
                upperTorso:FindFirstChild("BodyPosition"):Destroy()
            end
            if upperTorso:FindFirstChild("BodyGyro") then
                upperTorso:FindFirstChild("BodyGyro"):Destroy()
            end

            -- Create new BodyPosition and BodyGyro
            local bodypos = Instance.new('BodyPosition', upperTorso)
            bodypos.D = 60
            bodypos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

            local bodygyro = Instance.new('BodyGyro', upperTorso)
            bodygyro.D = 50
            bodygyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

            -- Bind to Heartbeat for continuous updates
            local heartbeatConnection
            heartbeatConnection = game:GetService('RunService').Heartbeat:Connect(function()
                -- Calculate the target's position behind and at the specified height
                local offset = Vector3.new(0, HeightOffset, -5) -- 5 studs behind, HeightOffset studs above/below
                local targetPosition = LocalPlayer.Character.HumanoidRootPart.Position + 
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * offset.Z) +
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.UpVector * offset.Y)

                -- Update BodyPosition and BodyGyro
                bodypos.Position = targetPosition
                bodygyro.CFrame = CFrame.new(upperTorso.Position, LocalPlayer.Character.HumanoidRootPart.Position)
            end)

            -- Clean up on release
            Grabbed = true
            target.Character.Humanoid.Died:Connect(function()
                heartbeatConnection:Disconnect()
                Grabbed = false
            end)
        end
    end
end

-- Activate Tool (Grab Tool)
local ActivateTool = Instance.new("Tool", LocalPlayer.Backpack)
ActivateTool.RequiresHandle = false
ActivateTool.Name = "Activate"

ActivateTool.Activated:Connect(function()
    game:GetService("ReplicatedStorage").MainEvent:FireServer('Grabbing', true)
    
    repeat task.wait(0.1) 
    until game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value ~= nil 
    and game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value ~= ''
    
    if game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value ~= nil 
    and game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value ~= '' then
        local target = tostring(game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value)
        Grabbed = true
        
        for _, part in pairs(game.Players[target].Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local grabbingConstraint = game.Players[target].Character:FindFirstChild('GRABBING_CONSTRAINT')
        if grabbingConstraint and grabbingConstraint:FindFirstChild('H') then
            grabbingConstraint.H.Length = 99e99
        end
        
        for _, track in pairs(LocalPlayer.Character.Humanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
        
        GrabMode = "Regular"
        RegularGrab(game.Players[target])
    else
        Grabbed = false
    end
    
    game.Players.LocalPlayer.Character.BodyEffects.Grabbed:GetPropertyChangedSignal('Value'):Connect(function()
        if game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value == nil then
            Grabbed = false
            
            if target and game.Players[target] and game.Players[target].Character then
                for _, part in pairs(game.Players[target].Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end)
end)
