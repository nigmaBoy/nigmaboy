function Invis(v,t)
    local bodyParts = {"Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}

    for _, part in pairs(v:GetDescendants()) do
        if part:IsA("BasePart") and table.find(bodyParts, part.Name) then
            part.Transparency = t and 1 or 0
        elseif part:IsA("Decal") or part:IsA("Texture") then
            if table.find(bodyParts, part.Parent.Name) then
                part.Transparency = t and 1 or 0
            end
        elseif part:IsA("Accessory") then
            if part:FindFirstChild("Handle") then
                part.Handle.Transparency = t and 1 or 0
            end
        end
    end
end

