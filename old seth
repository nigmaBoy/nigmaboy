function CreateTools(name,callback)
	local OldTool = OWNER.Backpack:FindFirstChild(name) or OWNER.Character:FindFirstChild(name)
	if OldTool then OldTool:Destroy()end
	if getgenv().ToolCache[name] then
		getgenv().ToolCache[name]:Disconnect()
		getgenv().ToolCache[name]=nil
	end
	if getgenv().ToolCACache[name] then
		getgenv().ToolCACache[name]:Disconnect()
		getgenv().ToolCACache[name]=nil
	end
	local Tool
	function tools()
		Tool = Instance.new("Tool",OWNER.Backpack)
		Tool.Name = name 
		Tool.RequiresHandle = false 
		getgenv().ToolCache[name]=Tool.Activated:Connect(function()
			callback()
		end)
	end
	tools()
	getgenv().ToolCACache[name]=OWNER.CharacterAdded:connect(function()
		OWNER.Character:WaitForChild("FULLY_LOADED_CHAR")
		tools()
	end)
	return Tool
end

