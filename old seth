    if Conf["Value"]["StrafeType"] == "CFrame" then
        getRoot_(OWNER).CFrame = CFrame.new(Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Position + moveDir) * CFrame.Angles(0, Conf["Value"]["StrafeSpeed"] * math.pi * Conf["Value"]["Delta"], 0) * CFrame.new(0, 0, Conf["Value"]["Distance"])
    elseif Conf["Value"]["StrafeType"] == "Velocity" then
        getRoot_(OWNER).CFrame = CFrame.new(Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Position + moveDir + moveDir * Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Velocity.Magnitude) * CFrame.Angles(0, Conf["Value"]["StrafeSpeed"] * math.pi * Conf["Value"]["Delta"], 0) * CFrame.new(0, 0, Conf["Value"]["Distance"])
    elseif Conf["Value"]["StrafeType"] == "WalkSpeed" then
        getRoot_(OWNER).CFrame = CFrame.new(Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Position + moveDir + moveDir * Conf["Connection"]["TARGET"].Character.Humanoid.WalkSpeed) * CFrame.Angles(0, Conf["Value"]["StrafeSpeed"] * math.pi * Conf["Value"]["Delta"], 0) * CFrame.new(0, 0, Conf["Value"]["Distance"])
    elseif Conf["Value"]["StrafeType"] == "Random" then
        getRoot_(OWNER).CFrame = CFrame.new(Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Position + moveDir + Vector3.new(math.cos(tick() * Conf["Value"]["StrafeSpeed"]) * (Conf["Value"]["Offsets"].X + Conf["Value"]["Distance"]) + math.random(-Conf["Value"]["Distance"], Conf["Value"]["Distance"]),Conf["Value"]["Offsets"].Y + math.random(-Conf["Value"]["Distance"], Conf["Value"]["Distance"]),math.sin(tick() * Conf["Value"]["StrafeSpeed"]) * (Conf["Value"]["Offsets"].Z + Conf["Value"]["Distance"]) + math.random(-Conf["Value"]["Distance"], Conf["Value"]["Distance"]))) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
    elseif Conf["Value"]["StrafeType"] == "Above" then
        getRoot_(OWNER).CFrame = CFrame.new(Conf["Connection"]["TARGET"].Character.HumanoidRootPart.Position + moveDir) * CFrame.new(0, 6, 0) * CFrame.Angles(0, math.rad((tick() % .1) / .1 * 360), 0)
    end
end

