-- =================================================================
-- == High-Performance A* Pathfinding Library by [AI Assistant] ==
-- =================================================================
-- Replaces the slow, inefficient A* library with a version optimized
-- using a binary heap for near-instant node selection.

local astar = {}

-- 🔧 TUNABLE SETTINGS
astar.raycastInterval = Vector3.new(3, 3.5, 3) -- How far apart the pathfinding nodes are.
astar.raycastThickness = 1.5                   -- How "fat" the character is for raycasting.
astar.maxAirMovement = 20                      -- How far the path can travel without touching the ground.
astar.maxTime = 0.5                            -- Max seconds to calculate a path before giving up.
astar.ignoreList = {workspace.Terrain, workspace.Ignore, workspace.Players, workspace.CurrentCamera}

-- Helper Functions
local RunService = game:GetService("RunService")
local function distance(pos0, pos1)
    return (pos0 - pos1).Magnitude
end

-- Raycasting setup
local raycastParams = RaycastParams.new()
raycastParams.IgnoreWater = true

local function thickRaycast(thickness, origin, direction, filterList)
    raycastParams.FilterDescendantsInstances = filterList or astar.ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local hit = workspace:Blockcast(CFrame.new(origin), Vector3.new(thickness, thickness, direction.Magnitude), direction, raycastParams)
    return hit
end

local maxStudsOffGround = 4
local function isGrounded(pos)
    raycastParams.FilterDescendantsInstances = astar.ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    return workspace:Raycast(pos, Vector3.yAxis * -maxStudsOffGround, raycastParams)
end

-- 3D Directional Offsets
local directionOffsets = {}
for x = -1, 1 do
    for y = -1, 1 do
        for z = -1, 1 do
            if x ~= 0 or y ~= 0 or z ~= 0 then
                table.insert(directionOffsets, Vector3.new(x, y, z))
            end
        end
    end
end

-- ⚡ The Core Optimization: A Binary Heap (Priority Queue)
-- This makes finding the node with the lowest F-cost extremely fast.
local function createPriorityQueue()
    local heap = {}
    local queue = {}
    
    function queue:Push(node)
        local index = #heap + 1
        heap[index] = node
        while index > 1 and heap[index].fCost < heap[math.floor(index / 2)].fCost do
            heap[index], heap[math.floor(index / 2)] = heap[math.floor(index / 2)], heap[index]
            index = math.floor(index / 2)
        end
    end
    
    function queue:Pop()
        if #heap == 0 then return nil end
        local top = heap[1]
        heap[1] = heap[#heap]
        table.remove(heap)
        local index = 1
        while true do
            local leftChild, rightChild = index * 2, index * 2 + 1
            local smallest = index
            if leftChild <= #heap and heap[leftChild].fCost < heap[smallest].fCost then
                smallest = leftChild
            end
            if rightChild <= #heap and heap[rightChild].fCost < heap[smallest].fCost then
                smallest = rightChild
            end
            if smallest == index then break end
            heap[index], heap[smallest] = heap[smallest], heap[index]
            index = smallest
        end
        return top
    end
    
    function queue:IsEmpty()
        return #heap == 0
    end
    
    return queue
end

-- Main Pathfinding Function
function astar:findPath(origin, target, pathInterval, maxOffset)
    local startTime = tick()
    local maxTime = startTime + self.maxTime
    
    local openSet = createPriorityQueue()
    local closedSet = {}
    local nodeMap = {}

    maxOffset = math.max(maxOffset or 0, 5) -- Minimum distance to target to finish

    -- Create and add the starting node
    local startNode = {
        position = origin,
        gCost = 0,
        hCost = distance(origin, target),
        fCost = distance(origin, target),
        parent = nil,
        grounded = true,
        airDist = 0
    }
    openSet:Push(startNode)
    nodeMap[origin] = startNode

    while not openSet:IsEmpty() do
        if tick() > maxTime then
            --warn("Pathfinding timed out.")
            return nil, 0, tick() - startTime
        end
        
        local currentNode = openSet:Pop()
        closedSet[currentNode.position] = true
        
        -- Check if we reached the target
        if (currentNode.position - target).Magnitude <= maxOffset then
            local path = {}
            local current = currentNode
            while current do
                table.insert(path, 1, current.position)
                current = current.parent
            end
            if #path > 0 then path[#path] = target end -- Snap to final target
            
            -- Optional: Lengthen path for smoother movement
            local finalPath, totalDist = {path[1]}, 0
            for i = 2, #path do
                local p1, p2 = path[i-1], path[i]
                local segmentDist = (p2 - p1).Magnitude
                local dir = (p2 - p1).Unit
                local steps = math.floor(segmentDist / pathInterval)
                for j = 1, steps do
                    table.insert(finalPath, p1 + dir * (j * pathInterval))
                end
                table.insert(finalPath, p2)
                totalDist = totalDist + segmentDist
            end

            return finalPath, totalDist, tick() - startTime
        end

        -- Explore neighbors
        for _, offsetDir in ipairs(directionOffsets) do
            local neighborPos = currentNode.position + (offsetDir * self.raycastInterval)
            
            if not closedSet[neighborPos] then
                if not thickRaycast(self.raycastThickness, currentNode.position, neighborPos - currentNode.position) then
                    local grounded = isGrounded(neighborPos)
                    local airDist = currentNode.airDist + (grounded and -currentNode.airDist or self.raycastInterval.Magnitude)
                    
                    if airDist <= self.maxAirMovement then
                        local gCost = currentNode.gCost + distance(currentNode.position, neighborPos)
                        local existingNode = nodeMap[neighborPos]

                        if not existingNode or gCost < existingNode.gCost then
                            local hCost = distance(neighborPos, target)
                            local neighborNode = {
                                position = neighborPos,
                                gCost = gCost,
                                hCost = hCost,
                                fCost = gCost + hCost,
                                parent = currentNode,
                                grounded = grounded,
                                airDist = airDist
                            }
                            nodeMap[neighborPos] = neighborNode
                            openSet:Push(neighborNode)
                        end
                    end
                end
            end
        end
    end
    
    --warn("Path not found.")
    return nil, 0, tick() - startTime -- No path found
end

return astar
