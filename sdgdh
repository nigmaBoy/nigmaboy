    --[[ Adds a Group Box container ]]
    function ElementFunctions:AddGroupBox(parentContainer, parentLayout, opts)
        opts = opts or {}; local title = opts.Title; local side = opts.Side -- "Left", "Right", or nil/default
        local order = GetNextLayoutOrder(parentLayout)

        -- Determine width based on side
        local boxWidthScale = (side == "Left" or side == "Right") and 0.5 or 1
        local boxWidthOffset = (side == "Left" or side == "Right") and -(FreakyGui.Theme.Padding * 1.5) or -(FreakyGui.Theme.Padding * 2) -- Adjust padding for half vs full width

        local groupBoxFrame = CreateElement("Frame", {
            Name = (title or "GroupBox") .. "_Frame",
            Size = UDim2.new(boxWidthScale, boxWidthOffset, 0, 0), -- Height is automatic
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = FreakyGui.Theme.Secondary,
            BorderSizePixel = 0,
            LayoutOrder = order,
            Parent = parentContainer,
            ClipsDescendants = true,
        })
        ApplyCorner(groupBoxFrame); ApplyStroke(groupBoxFrame)
        CollectionService:AddTag(groupBoxFrame, "FreakyGui_Theme_Secondary")
        local stroke = groupBoxFrame:FindFirstChildWhichIsA("UIStroke"); if stroke then CollectionService:AddTag(stroke, "FreakyGui_Theme_Outline") end

        local verticalLayout = CreateElement("UIListLayout", {
            Parent = groupBoxFrame,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
            FillDirection = Enum.FillDirection.Vertical,
            HorizontalAlignment = Enum.HorizontalAlignment.Left,
        })
        CreateElement("UIPadding", {
             Parent = groupBoxFrame,
             PaddingTop = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
             PaddingBottom = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
             PaddingLeft = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
             PaddingRight = UDim.new(0, FreakyGui.Theme.GroupBoxPadding),
         })


        local contentContainer = groupBoxFrame -- Default content container is the box itself if no title
        local contentLayout = verticalLayout

        if title then
            local titleFrame = CreateElement("Frame", {
                Name = "TitleFrame",
                Size = UDim2.new(1, 0, 0, FreakyGui.Theme.GroupBoxTitleHeight),
                BackgroundColor3 = FreakyGui.Theme.GroupBoxHeader,
                BorderSizePixel = 0,
                LayoutOrder = 0, -- Title always first
                Parent = groupBoxFrame,
                ClipsDescendants = true,
            })
            ApplyCorner(titleFrame, FreakyGui.Theme.CornerRadius) -- Apply corner only to top? Maybe adjust later. Keep it simple for now.
            CollectionService:AddTag(titleFrame, "FreakyGui_Theme_GroupBoxHeader")

            CreateElement("TextLabel", {
                Name = "TitleLabel",
                Size = UDim2.new(1, -FreakyGui.Theme.Padding*2, 1, 0),
                Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, 0),
                BackgroundTransparency = 1,
                Font = FreakyGui.Theme.Font,
                Text = title,
                TextColor3 = FreakyGui.Theme.Text,
                TextSize = FreakyGui.Theme.FontSize,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = titleFrame,
                ZIndex = titleFrame.ZIndex + 1,
            })
            -- Add padding specific for title frame's bottom
            verticalLayout.Padding = UDim.new(0, FreakyGui.Theme.GroupBoxPadding + (title and FreakyGui.Theme.GroupBoxTitleHeight or 0))

            -- Content should be added below the title, so we might need another frame, but UIListLayout handles order.
            -- Let's adjust PaddingTop of the layout instead.
            verticalLayout.Padding = UDim.new(0, FreakyGui.Theme.GroupBoxPadding) -- Reset padding on layout
            groupBoxFrame.UIPadding.PaddingTop = UDim.new(0, FreakyGui.Theme.GroupBoxTitleHeight + FreakyGui.Theme.GroupBoxPadding) -- Add padding to main frame
        end


        -- Create the GroupBox object table
        local groupBox = {
            Name = title or "GroupBox_"..order,
            Frame = groupBoxFrame,
            ContentContainer = contentContainer, -- Where elements are actually parented
            Layout = contentLayout,             -- The layout controlling the elements
            Elements = {},
            Window = self.Window -- Pass window reference down if needed
        }

        -- Crucially, add the element functions to this specific group box instance
        -- These functions will now correctly use the groupBox's ContentContainer and Layout
        for funcName, func in pairs(ElementFunctions) do
            groupBox[funcName] = function(passedOpts) -- Closure to capture 'groupBox'
                return func(groupBox, groupBox.ContentContainer, groupBox.Layout, passedOpts)
            end
        end

        self.Elements[groupBox.Name] = groupBox; -- Store reference in parent's elements table
        return groupBox
    end


