            local barWidth = sb.AbsoluteSize.X
            if barWidth <= 0 then return end
            local p = Clamp((inputPos.X - barStartX) / barWidth, 0, 1)
            local nv = min + p * (max - min)
            local rv = rti(nv)
            if rv ~= cv then uv(rv, true); pcall(cb, cv) end
        end

        local function onMouseMove() if isDragging then local mousePos = UserInputService:GetMouseLocation(); updateFromInputPos(mousePos) else if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn = nil end end end
        local function onMouseRelease(input) if isDragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then isDragging = false; if mouseMoveConn then mouseMoveConn:Disconnect(); mouseMoveConn = nil end; if mouseReleaseConn then mouseReleaseConn:Disconnect(); mouseReleaseConn = nil end end end

        -- Increased Hitbox size for easier dragging on bar/nub
        local da = CreateElement("TextButton", { Name = "DrgArea", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 10, 0, FreakyGui.Theme.SliderNubSize * 2), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, Text = "", ZIndex = sn.ZIndex + 1, Parent = sb })

        da.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = true; updateFromInputPos(input.Position); if mouseMoveConn then mouseMoveConn:Disconnect() end; if mouseReleaseConn then mouseReleaseConn:Disconnect() end; mouseMoveConn = RunService.RenderStepped:Connect(onMouseMove); mouseReleaseConn = UserInputService.InputEnded:Connect(onMouseRelease) end end)

        uv(cv, false)
        local sliderObj = { Frame = sf, Set = function(nv) if cv ~= nv then uv(nv, false) end end, Get = function() return cv end,
            UpdateTheme = function() -- Add UpdateTheme
                sl.TextColor3 = FreakyGui.Theme.Text
                vl.TextColor3 = FreakyGui.Theme.TextDisabled
                sb.BackgroundColor3 = FreakyGui.Theme.Secondary
                sfll.BackgroundColor3 = FreakyGui.Theme.Primary
                sn.BackgroundColor3 = FreakyGui.Theme.TextActive
                ApplyStroke(sn, FreakyGui.Theme.Outline, 1)
            end
        }
