        local sfll = CreateElement("Frame", { Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = FreakyGui.Theme.Primary, BorderSizePixel = 0, Parent = sb }); ApplyCorner(sfll, FreakyGui.Theme.SliderBarHeight / 2)
        local sn = CreateElement("Frame", { Name = "Nub", Size = UDim2.new(0, FreakyGui.Theme.SliderNubSize, 0, FreakyGui.Theme.SliderNubSize), Position = UDim2.new(0, -FreakyGui.Theme.SliderNubSize / 2, 0.5, -FreakyGui.Theme.SliderNubSize / 2), BackgroundColor3 = FreakyGui.Theme.TextActive, BorderSizePixel = 0, ZIndex = sb.ZIndex + 1, Parent = sb }); ApplyCorner(sn, FreakyGui.Theme.SliderNubSize / 2)
        ApplyStroke(sn, FreakyGui.Theme.Outline, 1)

        local cv = def; local isDragging = false; local mouseMoveConn = nil; local mouseReleaseConn = nil

        local function rti(v) if inc == 0 then return v end; local iv = 1 / (inc); return math.floor(v * iv + 0.5) / iv end
        local decimalPlaces = 0; if inc > 0 and inc < 1 then local match = tostring(inc):match("%.(%d*)"); decimalPlaces = math.max(0, match and #match or 0) end

        local function uv(v, fromDrag)
            v = Clamp(v, min, max); local rv = rti(v)
            local p = (max == min) and 0 or ((rv - min) / (max - min))
            local tf = UDim2.new(p, 0, 1, 0)
            local tn = UDim2.new(p, -FreakyGui.Theme.SliderNubSize / 2, 0.5, -FreakyGui.Theme.SliderNubSize / 2)
            if fromDrag then
                sfll.Size = tf; sn.Position = tn
            else
                local ti = TweenInfo.new(0.1)
                TweenService:Create(sfll, ti, { Size = tf }):Play()
                TweenService:Create(sn, ti, { Position = tn }):Play()
