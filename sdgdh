    -- Tab Bar Scrolling Logic - Updated calculation slightly
    local function updateTabBarScroll()
        task.wait(); -- Allow layout to settle
        local cw = tabLayout.AbsoluteContentSize.X;
        local vw = tabBar.AbsoluteSize.X;
        local maxS = math.max(0, cw - vw);
        local canL = tabBar.CanvasPosition.X > 5;
        local canR = tabBar.CanvasPosition.X < maxS - 5;
        local sbw = 0; -- Scroll button width contribution
        leftScroll.Visible = canL;
        rightScroll.Visible = canR;
        if canL then sbw = sbw + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING end;
        if canR then sbw = sbw + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING end;
        -- Total width reserved for padding, scroll buttons, and settings tab
        local totalReservedWidth = TAB_AREA_PADDING * 2 + sbw + SETTINGS_TAB_WIDTH + TAB_AREA_PADDING;
        tabBar.Size = UDim2.new(1, -totalReservedWidth, 1, 0);
        -- Position depends on left scroll button visibility
        tabBar.Position = UDim2.new(0, TAB_AREA_PADDING + (canL and (SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING) or 0), 0, 0);
        -- Right scroll button position depends on its own visibility
        rightScroll.Position = UDim2.new(1, -TAB_AREA_PADDING*2 - SETTINGS_TAB_WIDTH - (canR and SCROLL_BUTTON_WIDTH or 0), 0, 0)
    end
    leftScroll.MouseButton1Click:Connect(function() local t=TweenService:Create(tabBar,TweenInfo.new(0.2),{CanvasPosition=Vector2.new(math.max(0,tabBar.CanvasPosition.X-FreakyGui.Theme.TabScrollStep),0)});t:Play();t.Completed:Wait();updateTabBarScroll()end)
    rightScroll.MouseButton1Click:Connect(function() local maxS=math.max(0,tabLayout.AbsoluteContentSize.X-tabBar.AbsoluteSize.X);local t=TweenService:Create(tabBar,TweenInfo.new(0.2),{CanvasPosition=Vector2.new(math.min(maxS,tabBar.CanvasPosition.X+FreakyGui.Theme.TabScrollStep),0)});t:Play();t.Completed:Wait();updateTabBarScroll()end)
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() tabBar.CanvasSize=UDim2.new(0,tabLayout.AbsoluteContentSize.X,0,0); updateTabBarScroll() end)
    tabBar:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateTabBarScroll) -- Also update on resize
    windowFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateTabBarScroll); task.delay(0.1, updateTabBarScroll) -- Initial call

    -- Set Active Tab Logic (Handles Styling)
    function window:SetActiveTab(tabToActivate)
        if self.ActiveTab==tabToActivate then return end
        if self.ActiveTab then
            self.ActiveTab.PageContainer.Visible = false; -- Hide old page container
            self.ActiveTab.Button.BackgroundColor3 = FreakyGui.Theme.Secondary;
            self.ActiveTab.Button.TextColor3 = FreakyGui.Theme.TextDisabled;
            ApplyStroke(self.ActiveTab.Button, nil, 0) -- Remove stroke from inactive
        end
        tabToActivate.PageContainer.Visible = true; -- Show new page container
        tabToActivate.Button.BackgroundColor3 = FreakyGui.Theme.Background; -- Match window bg
        tabToActivate.Button.TextColor3 = FreakyGui.Theme.TextActive;
        ApplyStroke(tabToActivate.Button, FreakyGui.Theme.Outline, FreakyGui.Theme.OutlineThickness) -- Add stroke to active
        self.ActiveTab = tabToActivate
    end

    -- Settings Tab Creation (Now includes Keybind Picker & Color Pickers)
    local settingsPageContainer = CreateElement("Frame", { -- Container to hold the scrolling frame
        Name="Settings_PageContainer", Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0, Visible=false, Parent=contentArea
    })
    local settingsPage = CreateElement("ScrollingFrame",{ -- Actual scrollable area
        Name="Settings_Page", Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0, CanvasSize=UDim2.new(0,0,0,0),
        ScrollBarImageColor3=FreakyGui.Theme.Primary, ScrollBarThickness=4, Parent=settingsPageContainer
    })
    local settingsPageLayout = CreateElement("UIListLayout",{
        Parent=settingsPage, SortOrder=Enum.SortOrder.LayoutOrder,
        Padding=UDim.new(0,FreakyGui.Theme.ElementSpacing), FillDirection = Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left, -- Align elements left
    });
    settingsPageLayout.Changed:Connect(function()
        settingsPage.CanvasSize=UDim2.new(0,0,0,settingsPageLayout.AbsoluteContentSize.Y + FreakyGui.Theme.Padding * 2) -- Add padding bottom
    end)

    -- Define the Settings Tab Object (Has ElementFunctions attached like regular tabs)
    window.SettingsTab = {
        Name="Settings", PageContainer=settingsPageContainer, Page=settingsPage, Button=settingsTabButton,
        Layout=settingsPageLayout, Elements={}, IsTab = true -- Flag it as a tab-like object
    }
    window.Tabs["Settings"]=window.SettingsTab -- Add to tabs list
    settingsTabButton.MouseButton1Click:Connect(function()window:SetActiveTab(window.SettingsTab)end)
    settingsTabButton.MouseEnter:Connect(function() if window.ActiveTab~=window.SettingsTab then settingsTabButton.BackgroundColor3=Color3.Lerp(FreakyGui.Theme.Secondary,FreakyGui.Theme.Background,0.3)end end)
    settingsTabButton.MouseLeave:Connect(function() if window.ActiveTab~=window.SettingsTab then settingsTabButton.BackgroundColor3=FreakyGui.Theme.Secondary end end)

    -- Attach element functions directly to the Settings Tab object
    -- (Settings Tab doesn't use GroupBoxes, elements go directly into its layout)
    for name, func in pairs(ElementFunctions) do
        window.SettingsTab[name] = function(tabSelf, ...)
             -- Special case for adding elements to settings: parent directly to settingsPage
            local element = func(tabSelf, ...) -- Call original function
             if element and element.Parent ~= settingsPage then
                 element.Parent = settingsPage -- Ensure parent is the ScrollingFrame
                 element.LayoutOrder = #settingsPageLayout:GetChildren() + 1 -- Recalc layout order
             end
             return element
        end
    end

    -- Add Keybind Picker to Settings Tab
    do
        local keybindFrame = CreateElement("Frame", {
            Name = "KeybindFrame", Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, FreakyGui.Theme.ElementHeight),
            BackgroundTransparency = 1, Parent = settingsPage, LayoutOrder = 1 -- Place it first
        })
        local keybindLabel = CreateElement("TextLabel", {
            Name = "KeybindLabel", Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromOffset(0,0),
            BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize,
            TextColor3 = FreakyGui.Theme.Text, Text = "Toggle Keybind:", TextXAlignment = Enum.TextXAlignment.Left, Parent = keybindFrame
        })
        local keybindButton = CreateElement("TextButton", {
            Name = "KeybindButton", Size = UDim2.new(0.6, -FreakyGui.Theme.Padding, 1, 0), Position = UDim2.new(0.4, FreakyGui.Theme.Padding, 0, 0),
            BackgroundColor3 = FreakyGui.Theme.Secondary, Text = tostring(window.Keybind.Name), Font = FreakyGui.Theme.Font,
            TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.TextActive, Parent = keybindFrame, AutoButtonColor = false
        }); ApplyCorner(keybindButton); ApplyStroke(keybindButton, FreakyGui.Theme.Secondary, 1)

        local isListening = false
        local inputConn = nil

        keybindButton.MouseEnter:Connect(function() if not isListening then keybindButton.BackgroundColor3 = Color3.Lerp(FreakyGui.Theme.Secondary, Color3.new(1,1,1), 0.1) end end)
        keybindButton.MouseLeave:Connect(function() if not isListening then keybindButton.BackgroundColor3 = FreakyGui.Theme.Secondary end end)

        keybindButton.MouseButton1Click:Connect(function()
            if isListening then return end -- Prevent multiple clicks
            isListening = true
            keybindButton.Text = "..."
            keybindButton.BackgroundColor3 = FreakyGui.Theme.Primary -- Indicate listening state

            if inputConn then inputConn:Disconnect() end -- Disconnect previous listener if any

            inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
                    isListening = false
                    inputConn:Disconnect() -- Stop listening
                    inputConn = nil

                    if input.KeyCode == Enum.KeyCode.Escape then
                         -- Cancelled - revert text
                        keybindButton.Text = tostring(window.Keybind.Name)
                        keybindButton.BackgroundColor3 = FreakyGui.Theme.Secondary
                        return
                    end

                    -- Update Keybind
                    window.Keybind = input.KeyCode
                    keybindButton.Text = tostring(window.Keybind.Name)
                    keybindButton.BackgroundColor3 = FreakyGui.Theme.Secondary

                    -- Update the master keybind connection
                    if FreakyGui.KeybindConnections[screenGui] then
                        FreakyGui.KeybindConnections[screenGui]:Disconnect()
                    end
                    local newConn = UserInputService.InputBegan:Connect(function(i,gp)
                        if not gp and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==window.Keybind then
                            if FreakyGui.Windows[screenGui] then FreakyGui.Windows[screenGui]:ToggleVisibility() end
                        end
                    end)
                    FreakyGui.KeybindConnections[screenGui] = newConn
                 elseif input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.MouseWheel then
                     -- If any other non-keyboard input happens while listening, cancel
                     isListening = false
                     inputConn:Disconnect()
                     inputConn = nil
                     keybindButton.Text = tostring(window.Keybind.Name)
                     keybindButton.BackgroundColor3 = FreakyGui.Theme.Secondary
                end
            end)
        end)
    end -- End Keybind Picker

    -- Add Theme Color Pickers to Settings Tab
    do
        window.SettingsTab:AddSeparator() -- Add separator before colors
        local colorPickerOrder = 10 -- Start layout order after keybind/separator

        local function updateThemeColor(key, newColor)
            FreakyGui.Theme[key] = newColor
            -- Note: This only updates the theme table. Existing elements won't change
            -- unless they explicitly re-read the theme (like sliders/toggles on update).
            -- A full dynamic update would require iterating through all UI elements
            -- or implementing an event system, which is much more complex.
            print("[FreakyGui] Theme."..key.." updated. Changes apply to new elements or on refresh/recalc.")
        end

        -- Sort theme keys for consistent order (optional)
        local sortedThemeKeys = {}
        for k, v in pairs(FreakyGui.Theme) do
            if typeof(v) == "Color3" then
                table.insert(sortedThemeKeys, k)
            end
        end
        table.sort(sortedThemeKeys)

        for _, key in ipairs(sortedThemeKeys) do
            local value = FreakyGui.Theme[key]
            if typeof(value) == "Color3" then
                local colorFrame = CreateElement("Frame", {
                    Name = key.."_ColorFrame", Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, FreakyGui.Theme.ElementHeight + 5), -- Extra height for spacing
                    BackgroundTransparency = 1, Parent = settingsPage, LayoutOrder = colorPickerOrder
                })
                colorPickerOrder = colorPickerOrder + 1

                local colorLabel = CreateElement("TextLabel", {
                    Name = key.."_Label", Size = UDim2.new(1, -80, 0, FreakyGui.Theme.FontSize), Position = UDim2.fromOffset(0,0),
                    BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize,
                    TextColor3 = FreakyGui.Theme.Text, Text = key..":", TextXAlignment = Enum.TextXAlignment.Left, Parent = colorFrame
                })
                local colorPreview = CreateElement("Frame", {
                    Name = key.."_Preview", Size = UDim2.new(0, 60, 0, FreakyGui.Theme.ElementHeight - 10), Position = UDim2.new(1,-70, 0.5, -(FreakyGui.Theme.ElementHeight - 10)/2),
                    BackgroundColor3 = value, BorderSizePixel = 1, BorderColor3 = FreakyGui.Theme.Outline, Parent = colorFrame
                }); ApplyCorner(colorPreview)

                local rgbFrame = CreateElement("Frame", {
                    Name = key.."_RGBFrame", Size = UDim2.new(1, -80, 0, FreakyGui.Theme.ElementHeight - FreakyGui.Theme.FontSize - 2), Position = UDim2.new(0,0,0, FreakyGui.Theme.FontSize + 2),
                    BackgroundTransparency = 1, Parent = colorFrame
                })
                local rgbLayout = CreateElement("UIListLayout", {Parent=rgbFrame, FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0, 3), VerticalAlignment=Enum.VerticalAlignment.Center})

                local components = {R=math.floor(value.R*255), G=math.floor(value.G*255), B=math.floor(value.B*255)}
                local textboxes = {}

                for _, comp in ipairs({"R", "G", "B"}) do
                    local tb = CreateElement("TextBox", {
                        Name = key.."_"..comp.."_Input", Size = UDim2.new(0.333, -5, 1, 0),
                        BackgroundColor3 = FreakyGui.Theme.Secondary, BorderColor3 = FreakyGui.Theme.Outline, BorderSizePixel=1,
                        Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize - 2, TextColor3 = FreakyGui.Theme.TextActive,
                        Text = tostring(components[comp]), PlaceholderText = comp, TextXAlignment = Enum.TextXAlignment.Center,
                        ClearTextOnFocus = false, NumbersOnly = true, Parent = rgbFrame
                    }); ApplyCorner(tb, 3)
                    textboxes[comp] = tb

                    tb.FocusLost:Connect(function(enterPressed)
                        local r_val = tonumber(textboxes.R.Text) or 0
                        local g_val = tonumber(textboxes.G.Text) or 0
                        local b_val = tonumber(textboxes.B.Text) or 0
                        r_val = math.clamp(math.floor(r_val), 0, 255)
                        g_val = math.clamp(math.floor(g_val), 0, 255)
                        b_val = math.clamp(math.floor(b_val), 0, 255)
                        -- Update textboxes immediately to clamped values
                        textboxes.R.Text = tostring(r_val)
                        textboxes.G.Text = tostring(g_val)
                        textboxes.B.Text = tostring(b_val)

                        local newColor = Color3.fromRGB(r_val, g_val, b_val)
                        colorPreview.BackgroundColor3 = newColor
                        updateThemeColor(key, newColor) -- Update the actual theme table
                    end)
                end
            end
        end

    end -- End Color Pickers


    -- Tab Creation Function (Now supports Group Boxes)
    function window:AddTab(tabName)
        local tabIndex = #self.TabButtons + 1
        local tabTextWidth = CalculateTextWidth(tabName, FreakyGui.Theme.FontSize, FreakyGui.Theme.Font)
        local buttonWidth = tabTextWidth + FreakyGui.Theme.TabButtonPadding * 2

        local tabButton = CreateElement("TextButton",{
            Name=tabName.."_Button", Size=UDim2.new(0,buttonWidth,1,0), Text=tabName, Font=FreakyGui.Theme.Font,
            TextSize=FreakyGui.Theme.FontSize, TextColor3=FreakyGui.Theme.TextDisabled, BackgroundColor3=FreakyGui.Theme.Secondary,
            BorderSizePixel=0, LayoutOrder=tabIndex, Parent=self.TabBar, AutoButtonColor=false
        }); ApplyCorner(tabButton,3); ApplyStroke(tabButton,nil,0);

        -- Main container for the tab's content (holds the page)
        local tabPageContainer = CreateElement("Frame", {
            Name=tabName.."_PageContainer", Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
            BackgroundTransparency=1, BorderSizePixel=0, Visible=false, Parent=self.ContentArea
        })

        -- The scrollable page itself
        local tabPage = CreateElement("ScrollingFrame",{
            Name=tabName.."_Page", Size=UDim2.new(1,0,1,0), Position=UDim2.new(0,0,0,0),
            BackgroundTransparency=1, BorderSizePixel=0, CanvasSize=UDim2.new(0,0,0,0),
            ScrollBarImageColor3=FreakyGui.Theme.Primary, ScrollBarThickness=4, Parent=tabPageContainer
        })

        -- Horizontal layout *inside* the ScrollingFrame's Canvas, to hold GroupBoxes
        local pageLayout = CreateElement("UIListLayout",{
            Parent=tabPage, SortOrder=Enum.SortOrder.LayoutOrder, FillDirection=Enum.FillDirection.Horizontal,
            Padding=UDim.new(0, FreakyGui.Theme.Padding), VerticalAlignment = Enum.VerticalAlignment.Top, -- Align group boxes horizontally
        });

        -- Automatically create a default, full-width GroupBox for elements added directly to the tab
        local defaultGroupBoxFrame = CreateElement("Frame", {
            Name = tabName.."_DefaultGroup",
            Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, 100), -- Initial height, will grow. Width scales.
            BackgroundTransparency = 1, -- No visible background for the default group container itself
            Parent = tabPage,
            LayoutOrder = 0 -- Default group always comes first unless others specify lower
        })
        local defaultGroupBoxLayout = CreateElement("UIListLayout", {
            Parent = defaultGroupBoxFrame, SortOrder=Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, FreakyGui.Theme.ElementSpacing), HorizontalAlignment = Enum.HorizontalAlignment.Center
        })

        -- Update ScrollingFrame CanvasSize based on the *horizontal* layout containing group boxes
        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            -- Height should be the max height of any groupbox + padding
            local maxHeight = 0
            for _, child in ipairs(tabPage:GetChildren()) do
                if child:IsA("Frame") and child:FindFirstChildWhichIsA("UIListLayout") then
                   maxHeight = math.max(maxHeight, child.AbsoluteSize.Y)
                end
            end
            tabPage.CanvasSize = UDim2.new(0, pageLayout.AbsoluteContentSize.X, 0, maxHeight + FreakyGui.Theme.Padding * 2)
        end)
        -- Also update individual group box height based on their *vertical* content size
        defaultGroupBoxLayout.Changed:Connect(function()
            defaultGroupBoxFrame.Size = UDim2.new(defaultGroupBoxFrame.Size.X.Scale, defaultGroupBoxFrame.Size.X.Offset, 0, defaultGroupBoxLayout.AbsoluteContentSize.Y + FreakyGui.Theme.GroupBoxPadding * 2)
            -- Trigger canvas update
             task.wait() -- Allow layout to settle before recalculating canvas
             pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Fire()
         end)

        -- The Tab Object
        local tab = {
            Name=tabName, PageContainer=tabPageContainer, Page=tabPage, Button=tabButton,
            Layout=pageLayout, -- The HORIZONTAL layout for groups
            DefaultGroupBox = { -- Store reference to the default group
                Frame = defaultGroupBoxFrame,
                Layout = defaultGroupBoxLayout,
                Elements = {},
                Name = "DefaultGroup"
            },
            GroupOrderCounter = 1, -- To order added group boxes
            Groups = {}, -- Store explicitly added group boxes
            Elements={}, -- Legacy? Keep for now, but elements really live in groups.
            IsTab = true -- Flag it as a tab-like object
        }
        self.Tabs[tabName]=tab;
        self.TabButtons[tabIndex]=tab;

        -- Function to add a new Group Box to this tab
        function tab:AddGroupBox(opts)
            opts = opts or {}
            local groupName = opts.Name or "GroupBox"..self.GroupOrderCounter
            local title = opts.Title or groupName
            local widthScale = opts.WidthScale or 0.48 -- Default to slightly less than half width
            local widthOffset = opts.WidthOffset or 0

            local groupBoxFrame = CreateElement("Frame", {
                Name = groupName.."_Group",
                Size = UDim2.new(widthScale, widthOffset, 0, 50), -- Start height, grows with content
                BackgroundColor3 = FreakyGui.Theme.Secondary, -- Give groupbox a background
                BorderSizePixel = 0,
                Parent = self.Page, -- Parent to the main ScrollingFrame (canvas)
                LayoutOrder = self.GroupOrderCounter
            }); ApplyCorner(groupBoxFrame); ApplyStroke(groupBoxFrame)

            local groupBoxLayout = CreateElement("UIListLayout", {
                Parent = groupBoxFrame, SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Vertical,
                Padding = UDim.new(0, FreakyGui.Theme.ElementSpacing), HorizontalAlignment = Enum.HorizontalAlignment.Center,
                -- Add Padding from top for title
                Padding = UDim.new(0, FreakyGui.Theme.GroupBoxPadding)
            })

            local groupTitleLabel = CreateElement("TextLabel", {
                Name = "TitleLabel",
                Size = UDim2.new(1, -FreakyGui.Theme.GroupBoxPadding*2, 0, FreakyGui.Theme.GroupBoxTitleHeight),
                Position = UDim2.new(0, FreakyGui.Theme.GroupBoxPadding, 0, FreakyGui.Theme.GroupBoxPadding / 2),
                BackgroundTransparency = 1,
                Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.TextHeader,
                Text = title, TextXAlignment = Enum.TextXAlignment.Left,
                Parent = groupBoxFrame, ZIndex = groupBoxFrame.ZIndex + 1 -- Above layout elements
            })

             -- Add padding below title and above first element
             local topPadding = CreateElement("Frame", {
                 Name="TopPadding", Size=UDim2.new(1,0,0,FreakyGui.Theme.GroupBoxTitleHeight + 5),
                 BackgroundTransparency=1, Parent=groupBoxFrame, LayoutOrder=0
             })

            local groupBox = {
                Name = groupName,
                Title = title,
                Frame = groupBoxFrame,
                Layout = groupBoxLayout, -- The VERTICAL layout for elements INSIDE this group
                Elements = {} -- Store elements specific to this group
            }
            self.Groups[groupName] = groupBox
            self.GroupOrderCounter = self.GroupOrderCounter + 1

            -- Update GroupBox height when content changes
            groupBoxLayout.Changed:Connect(function()
                local contentHeight = groupBoxLayout.AbsoluteContentSize.Y + topPadding.AbsoluteSize.Y + FreakyGui.Theme.GroupBoxPadding * 2
                groupBoxFrame.Size = UDim2.new(groupBoxFrame.Size.X.Scale, groupBoxFrame.Size.X.Offset, 0, contentHeight)
                -- Trigger page canvas update
                task.wait()
                pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Fire()
            end)


            -- Attach Element Functions to the GroupBox Object
            for elName, elFunc in pairs(ElementFunctions) do
                groupBox[elName] = function(grpSelf, ...)
                    local element = elFunc(grpSelf, ...) -- Call original, passing group as 'self'
                    if element and element.Parent ~= groupBoxFrame then
                        element.Parent = groupBoxFrame -- Ensure it's parented to the frame
                        element.LayoutOrder = #groupBoxLayout:GetChildren() + 1
                        if not grpSelf.Elements[element.Name] and not (element:FindFirstChild("Lbl") or element:FindFirstChildWhichIsA("TextLabel")) then
                           -- Try to find a name if possible
                           local elNameKey = element.Name or tostring(element)
                           grpSelf.Elements[elNameKey] = element -- Store element reference
                        end
                    end
                    return element
                end
            end

            return groupBox -- Return the created groupbox object
        end


        -- Attach Element Functions to the Tab Object (defaulting to DefaultGroupBox)
        for elName, elFunc in pairs(ElementFunctions) do
            tab[elName] = function(tabSelf, ...)
                 -- When called on the tab, use the DefaultGroupBox as the context
                local element = elFunc(tabSelf.DefaultGroupBox, ...)
                if element then
                     -- Store a reference maybe?
                     local elNameKey = element.Name or (element.Frame and element.Frame.Name) or tostring(element)
                     tabSelf.Elements[elNameKey] = element -- Store reference on main tab element list too
                end
                return element
            end
        end

        tabButton.MouseButton1Click:Connect(function() self:SetActiveTab(tab) end)
        tabButton.MouseEnter:Connect(function() if self.ActiveTab~=tab then tabButton.BackgroundColor3=Color3.Lerp(FreakyGui.Theme.Secondary,FreakyGui.Theme.Background,0.3)end end)
        tabButton.MouseLeave:Connect(function() if self.ActiveTab~=tab then tabButton.BackgroundColor3=FreakyGui.Theme.Secondary end end)

        if not self.ActiveTab then self:SetActiveTab(tab) end;
        updateTabBarScroll(); -- Update scrollbar visibility etc.

        return tab -- Return the created tab object
    end

    -- Window Control Functions
    function window:ToggleVisibility() self:SetVisibility(not self.IsVisible) end
    function window:SetVisibility(v) self.IsVisible=v; self.Frame.Visible=v; self.ScreenGui.Enabled=v end
    function window:Destroy()
        if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end;
        FreakyGui.Windows[screenGui]=nil;
        if FreakyGui.KeybindConnections[screenGui] then
             pcall(FreakyGui.KeybindConnections[screenGui].Disconnect, FreakyGui.KeybindConnections[screenGui])
             FreakyGui.KeybindConnections[screenGui]=nil;
        end
        -- Disconnect drag listeners if active
        if windowMouseMoveConn then windowMouseMoveConn:Disconnect() end;
        if windowMouseReleaseConn then windowMouseReleaseConn:Disconnect() end;
    end

    closeButton.MouseButton1Click:Connect(function() window:SetVisibility(false) end)

    -- Initial Keybind Connection Setup
    if keybindCode and UserInputService then
        local c=UserInputService.InputBegan:Connect(function(i,gp)
            if not gp and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==window.Keybind then -- Check against window.Keybind dynamically
                if FreakyGui.Windows[screenGui] then FreakyGui.Windows[screenGui]:ToggleVisibility() end
            end
        end)
        FreakyGui.KeybindConnections[screenGui]=c -- Store initial connection
    end

    -- Make sure settings tab is visible if it's the only tab or needs to be activated
    task.wait(0.1) -- Give tabs time to potentially be added
    if not window.ActiveTab and window.SettingsTab then
        window:SetActiveTab(window.SettingsTab)
    end

    return window
end -- End of CreateWindow

-- Return the library table for use
return FreakyGui
