    function ElementFunctions:AddSlider(opts)
        opts = opts or {}
        local t = opts.Text or "Slider"
        local min = opts.Min or 0
        local max = opts.Max or 100
        local def = opts.Default or min
        local inc = opts.Increment or 1
        local sfx = opts.Suffix or ""
        local cb = opts.Callback or function(v) print(t .. " value: " .. v) end
        local layout, parent = getLayoutAndParent(self)
        local currentElementIndex = #layout:GetChildren() + 1

        local fh = FreakyGui.Theme.SliderBarHeight + FreakyGui.Theme.FontSize + FreakyGui.Theme.Padding + 4 -- Extra space
        local sf = CreateElement("Frame", { Name = t .. "_SldFrm", Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, fh), BackgroundTransparency = 1, LayoutOrder = currentElementIndex, Parent = parent })
        local sl = CreateElement("TextLabel", { Name = "Lbl", Size = UDim2.new(0.7, -FreakyGui.Theme.Padding, 0, FreakyGui.Theme.FontSize), Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, 2), BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.Text, Text = t, TextXAlignment = Enum.TextXAlignment.Left, Parent = sf })
        local vl = CreateElement("TextLabel", { Name = "ValLbl", Size = UDim2.new(0.3, -FreakyGui.Theme.Padding, 0, FreakyGui.Theme.FontSize), Position = UDim2.new(0.7, FreakyGui.Theme.Padding, 0, 2), BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.TextDisabled, Text = "", TextXAlignment = Enum.TextXAlignment.Right, Parent = sf })
