             box.BackgroundColor3 = FreakyGui.Theme.Secondary
             ApplyStroke(box, FreakyGui.Theme.Outline, 1)
             titleLabel.TextColor3 = FreakyGui.Theme.Text
             line.BackgroundColor3 = FreakyGui.Theme.Outline
             container.ScrollBarImageColor3 = FreakyGui.Theme.Primary
             -- Update child elements
             for _, element in pairs(groupBox.Elements) do
                 if element.UpdateTheme then element.UpdateTheme() end
             end
        end
    }

    -- Auto-resize based on content
    layout.Changed:Connect(function()
        local contentHeight = layout.AbsoluteContentSize.Y
        container.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
        local totalHeight = FreakyGui.Theme.GroupBoxTitleHeight + contentHeight + FreakyGui.Theme.GroupBoxPadding * 2 + 5
        groupBoxFrame.Size = UDim2.new(groupBoxFrame.Size.X.Scale, groupBoxFrame.Size.X.Offset, 0, totalHeight)
    end)

    -- Add element functions to the groupbox object
    for name, func in pairs(GroupBoxFunctions) do
        groupBox[name] = func
    end

    parentTab.Elements[title] = groupBox -- Store reference in parent tab
    return groupBox
end


-- Window Creation
function FreakyGui:CreateWindow(options)
    options = options or {}
    local windowTitle = options.Title or "FreakyGui Window"

    -- Dynamic Sizing Logic
    local screenWidth, screenHeight
    pcall(function() -- Wrap in pcall in case CurrentCamera isn't ready
        local viewport = workspace.CurrentCamera.ViewportSize
        screenWidth = viewport.X
        screenHeight = viewport.Y
    end)
    screenWidth = screenWidth or 1024 -- Fallback if couldn't get viewport
    screenHeight = screenHeight or 768

    local defaultWidth = math.floor(screenWidth / 4)
    local defaultHeight = math.floor(defaultWidth / 2.5) -- Adjusted ratio, 1/3 of width looked too squashed

    local width = options.Width or FreakyGui.Theme.WindowWidth or defaultWidth
    local height = options.Height or FreakyGui.Theme.WindowHeight or defaultHeight

    local keybindCode = options.Keybind or Enum.KeyCode.RightShift

    -- Main GUI Setup
    local screenGui = CreateElement("ScreenGui", { Name = "FreakyGui_" .. windowTitle:gsub("%s+", ""), Parent = CoreGui, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, ResetOnSpawn = false, Enabled = options.AutoShow == nil or options.AutoShow })
    local windowFrame = CreateElement("Frame", { Name = "WindowFrame", Size = UDim2.new(0, width, 0, height), Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2), BackgroundColor3 = FreakyGui.Theme.Background, BorderSizePixel = 0, ClipsDescendants = true, Parent = screenGui, Active = true, Visible = screenGui.Enabled }); ApplyCorner(windowFrame); ApplyStroke(windowFrame)
    ApplyGradient(windowFrame, Color3.Lerp(FreakyGui.Theme.Background, Color3.new(1,1,1), 0.03), FreakyGui.Theme.Background, 90) -- Subtle top-down gradient

    local topBar = CreateElement("Frame", { Name = "TopBar", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = FreakyGui.Theme.Header, BorderSizePixel = 0, Parent = windowFrame })
    ApplyGradient(topBar, Color3.Lerp(FreakyGui.Theme.Header, Color3.new(1,1,1), 0.1), FreakyGui.Theme.Header, 90) -- Subtle gradient on header too
    CreateElement("Frame", { Name = "TopBarCornerFix", Size = UDim2.new(1, 0, 0, FreakyGui.Theme.CornerRadius), Position = UDim2.new(0, 0, 1, -FreakyGui.Theme.CornerRadius), BackgroundColor3 = FreakyGui.Theme.Header, BorderSizePixel = 0, ZIndex = topBar.ZIndex - 1, Parent = topBar })
    local titleLabel = CreateElement("TextLabel", { Name = "Title", Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.TitleFontSize, TextColor3 = FreakyGui.Theme.Text, Text = windowTitle, TextXAlignment = Enum.TextXAlignment.Left, Parent = topBar })
    local closeButton = CreateElement("TextButton", { Name = "CloseButton", Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -25, 0.5, -10), BackgroundColor3 = FreakyGui.Theme.Error, Text = "X", Font = FreakyGui.Theme.Font, TextSize = 14, TextColor3 = FreakyGui.Theme.TextActive, Parent = topBar, AutoButtonColor = false }); ApplyCorner(closeButton, 3)

    -- Tab Area Setup
    local TAB_AREA_PADDING = 5; local SCROLL_BUTTON_WIDTH = 20; local SETTINGS_TAB_WIDTH = 80
    local tabArea = CreateElement("Frame", { Name = "TabArea", Size = UDim2.new(1, 0, 0, FreakyGui.Theme.TabHeight), Position = UDim2.new(0, 0, 0, topBar.Size.Y.Offset), BackgroundColor3 = FreakyGui.Theme.Background, Parent = windowFrame }) -- Match background
    local leftScroll = CreateElement("TextButton", { Name = "LeftScroll", Size = UDim2.new(0, SCROLL_BUTTON_WIDTH, 1, -4), Position = UDim2.new(0, TAB_AREA_PADDING, 0, 2), BackgroundColor3 = FreakyGui.Theme.Secondary, Text = "<", Font = FreakyGui.Theme.Font, TextSize = 16, TextColor3 = FreakyGui.Theme.Text, Visible = false, ZIndex = 2, Parent = tabArea, AutoButtonColor = false }); ApplyCorner(leftScroll, 3)
    local rightScroll = CreateElement("TextButton", { Name = "RightScroll", Size = UDim2.new(0, SCROLL_BUTTON_WIDTH, 1, -4), Position = UDim2.new(1, -TAB_AREA_PADDING * 2 - SCROLL_BUTTON_WIDTH - SETTINGS_TAB_WIDTH, 0, 2), BackgroundColor3 = FreakyGui.Theme.Secondary, Text = ">", Font = FreakyGui.Theme.Font, TextSize = 16, TextColor3 = FreakyGui.Theme.Text, Visible = false, ZIndex = 2, Parent = tabArea, AutoButtonColor = false }); ApplyCorner(rightScroll, 3)
    local tabBar = CreateElement("ScrollingFrame", { Name = "TabBar", Size = UDim2.new(1, -(TAB_AREA_PADDING * 3 + SCROLL_BUTTON_WIDTH * 2 + SETTINGS_TAB_WIDTH), 1, -4), Position = UDim2.new(0, TAB_AREA_PADDING * 2 + SCROLL_BUTTON_WIDTH, 0, 2), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollingDirection = Enum.ScrollingDirection.X, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 0, Parent = tabArea })
    local tabLayout = CreateElement("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, FreakyGui.Theme.Padding / 2), VerticalAlignment = Enum.VerticalAlignment.Center, Parent = tabBar })
    local settingsTabButton = CreateElement("TextButton", { Name = "Settings_Button", Size = UDim2.new(0, SETTINGS_TAB_WIDTH, 1, -4), Text = "Settings", Font = FreakyGui.Theme.Font, Position = UDim2.new(1, -SETTINGS_TAB_WIDTH - TAB_AREA_PADDING, 0, 2), TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.TextDisabled, BackgroundColor3 = FreakyGui.Theme.Secondary, BorderSizePixel = 0, ZIndex = 2, Parent = tabArea, AutoButtonColor = false }); ApplyCorner(settingsTabButton, 3); ApplyStroke(settingsTabButton, nil, 0)
    CreateElement("Frame", { Name = "TabLine", Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = FreakyGui.Theme.Outline, BorderSizePixel = 0, ZIndex = 3, Parent = tabArea })
    local contentArea = CreateElement("Frame", { Name = "ContentArea", Size = UDim2.new(1, -FreakyGui.Theme.Padding*2, 1, -(topBar.Size.Y.Offset + tabArea.Size.Y.Offset + FreakyGui.Theme.Padding*2)), Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, topBar.Size.Y.Offset + tabArea.Size.Y.Offset + FreakyGui.Theme.Padding), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Parent = windowFrame })

    -- Window Dragging Logic (Remains the Same)
    local isWindowDragging = false; local windowDragStartMouse = nil; local windowDragStartPos = nil; local windowMouseMoveConn = nil; local windowMouseReleaseConn = nil
    local function onWindowMouseMove() if isWindowDragging then local cM = UserInputService:GetMouseLocation(); local d = cM - windowDragStartMouse; windowFrame.Position = UDim2.new(windowDragStartPos.X.Scale, windowDragStartPos.X.Offset + d.X, windowDragStartPos.Y.Scale, windowDragStartPos.Y.Offset + d.Y) else if windowMouseMoveConn then windowMouseMoveConn:Disconnect(); windowMouseMoveConn = nil end end end
    local function onWindowMouseRelease(input) if isWindowDragging and input.UserInputType == Enum.UserInputType.MouseButton1 then isWindowDragging = false; if windowMouseMoveConn then windowMouseMoveConn:Disconnect(); windowMouseMoveConn = nil end; if windowMouseReleaseConn then windowMouseReleaseConn:Disconnect(); windowMouseReleaseConn = nil end end end
    topBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then isWindowDragging = true; windowDragStartMouse = UserInputService:GetMouseLocation(); windowDragStartPos = windowFrame.Position; if windowMouseMoveConn then windowMouseMoveConn:Disconnect() end; if windowMouseReleaseConn then windowMouseReleaseConn:Disconnect() end; windowMouseMoveConn = RunService.RenderStepped:Connect(onWindowMouseMove); windowMouseReleaseConn = UserInputService.InputEnded:Connect(onWindowMouseRelease) end end)

    -- Window Object Definition
    local window = {
        ScreenGui = screenGui, Frame = windowFrame, ContentArea = contentArea, TabBar = tabBar,
        TabLayout = tabLayout, Tabs = {}, TabButtons = {}, ActiveTab = nil, Keybind = keybindCode,
        IsVisible = windowFrame.Visible, SettingsTab = nil, AllElements = {} -- Track all elements for theme updates
    }
    FreakyGui.Windows[screenGui] = window

    -- Tab Bar Scrolling Logic (Remains Similar)
    local function updateTabBarScroll()
        task.wait(); local cw = tabLayout.AbsoluteContentSize.X; local vw = tabBar.AbsoluteSize.X; local maxS = math.max(0, cw - vw)
        local canL = tabBar.CanvasPosition.X > 5; local canR = tabBar.CanvasPosition.X < maxS - 5
        leftScroll.Visible = canL; rightScroll.Visible = canR
        local sbw = 0; if canL then sbw = sbw + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING / 2 end
        if canR then sbw = sbw + SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING / 2 end
        local totalReservedWidth = TAB_AREA_PADDING * 2 + sbw + SETTINGS_TAB_WIDTH + TAB_AREA_PADDING
        tabBar.Size = UDim2.new(1, -totalReservedWidth, 1, -4);
        tabBar.Position = UDim2.new(0, TAB_AREA_PADDING + (canL and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING / 2 or 0), 0, 2)
        rightScroll.Position = UDim2.new(1, -TAB_AREA_PADDING * 2 - SETTINGS_TAB_WIDTH - (canR and SCROLL_BUTTON_WIDTH + TAB_AREA_PADDING / 2 or 0), 0, 2)
    end
    leftScroll.MouseButton1Click:Connect(function() local t = TweenService:Create(tabBar, TweenInfo.new(0.2), { CanvasPosition = Vector2.new(math.max(0, tabBar.CanvasPosition.X - FreakyGui.Theme.TabScrollStep), 0) }); t:Play(); t.Completed:Wait(); updateTabBarScroll() end)
    rightScroll.MouseButton1Click:Connect(function() local maxS = math.max(0, tabLayout.AbsoluteContentSize.X - tabBar.AbsoluteSize.X); local t = TweenService:Create(tabBar, TweenInfo.new(0.2), { CanvasPosition = Vector2.new(math.min(maxS, tabBar.CanvasPosition.X + FreakyGui.Theme.TabScrollStep), 0) }); t:Play(); t.Completed:Wait(); updateTabBarScroll() end)
    tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() tabBar.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X, 0, 0); updateTabBarScroll() end)
    windowFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateTabBarScroll); task.delay(0.1, updateTabBarScroll)


    -- Tab Switching Logic
    function window:SetActiveTab(tabToActivate)
        if self.ActiveTab == tabToActivate then return end
        if self.ActiveTab then
            self.ActiveTab.Page.Visible = false
            self.ActiveTab.Button.BackgroundColor3 = FreakyGui.Theme.Secondary
            self.ActiveTab.Button.TextColor3 = FreakyGui.Theme.TextDisabled
            ApplyStroke(self.ActiveTab.Button, nil, 0) -- Remove stroke from inactive
        end
        tabToActivate.Page.Visible = true
        tabToActivate.Button.BackgroundColor3 = FreakyGui.Theme.Background -- Match window background
        tabToActivate.Button.TextColor3 = FreakyGui.Theme.TextActive
        ApplyStroke(tabToActivate.Button, FreakyGui.Theme.Outline, 1) -- Add stroke to active
        self.ActiveTab = tabToActivate
    end

    -- Settings Tab Setup
    local settingsPage = CreateElement("ScrollingFrame", { Name = "Settings_Page", Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarImageColor3 = FreakyGui.Theme.Primary, ScrollBarThickness = 4, Parent = contentArea })
    local settingsPageLayout = CreateElement("UIListLayout", { Parent = settingsPage, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, FreakyGui.Theme.Padding) });
    settingsPageLayout.Changed:Connect(function() settingsPage.CanvasSize = UDim2.new(0, 0, 0, settingsPageLayout.AbsoluteContentSize.Y) end)

    window.SettingsTab = { Name = "Settings", Page = settingsPage, Button = settingsTabButton, Layout = settingsPageLayout, Elements = {}, IsGroupBox = false }
    window.Tabs["Settings"] = window.SettingsTab

    settingsTabButton.MouseButton1Click:Connect(function() window:SetActiveTab(window.SettingsTab) end)
    settingsTabButton.MouseEnter:Connect(function() if window.ActiveTab ~= window.SettingsTab then settingsTabButton.BackgroundColor3 = Color3.Lerp(FreakyGui.Theme.Secondary, FreakyGui.Theme.Background, 0.3) end end)
    settingsTabButton.MouseLeave:Connect(function() if window.ActiveTab ~= window.SettingsTab then settingsTabButton.BackgroundColor3 = FreakyGui.Theme.Secondary end end)

    -- Add Element Functions to Settings Tab
    for name, func in pairs(ElementFunctions) do
        window.SettingsTab[name] = func
    end

    -- Add Keybind Picker and Color Pickers to Settings Tab
    local keybindPicker = window.SettingsTab:AddKeybindPicker({ Text="Toggle UI Key", CurrentKey=window.Keybind, Window=window })
    window.AllElements["KeybindPicker"] = keybindPicker -- Track for theme updates

    local themeGroupBox = window.SettingsTab:AddGroupBox({ Title = "Theme Colors" }) -- Group color pickers
    window.AllElements["ThemeGroupBox"] = themeGroupBox -- Track groupbox too

    for key, value in pairs(FreakyGui.Theme) do
        if typeof(value) == "Color3" then
            local picker = themeGroupBox:AddColorPicker({ -- Add to groupbox
                Text = key .. " Color",
                ThemeKey = key,
                DefaultColor = value,
                Window = window
            })
            window.AllElements["ColorPicker_"..key] = picker -- Track for theme updates
        end
    end

    -- Tab Creation Function
    function window:AddTab(tabName)
        if self.Tabs[tabName] then return self.Tabs[tabName] end -- Avoid duplicate tabs

        local ti = #self.TabButtons + 1
        local ts = TextService:GetTextSize(tabName, FreakyGui.Theme.FontSize, FreakyGui.Theme.Font, Vector2.new(math.huge, FreakyGui.Theme.TabHeight))
        local bw = math.max(60, ts.X + FreakyGui.Theme.TabButtonPadding * 2) -- Min width for tabs
        local tb = CreateElement("TextButton", { Name = tabName .. "_Button", Size = UDim2.new(0, bw, 1, -4), Text = tabName, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.TextDisabled, BackgroundColor3 = FreakyGui.Theme.Secondary, BorderSizePixel = 0, LayoutOrder = ti, Parent = self.TabBar, AutoButtonColor = false }); ApplyCorner(tb, 3); ApplyStroke(tb, nil, 0)
        local tp = CreateElement("ScrollingFrame", { Name = tabName .. "_Page", Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarImageColor3 = FreakyGui.Theme.Primary, ScrollBarThickness = 4, Parent = self.ContentArea })
        local pl = CreateElement("UIListLayout", { Parent = tp, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, FreakyGui.Theme.Padding) });
        pl.Changed:Connect(function() tp.CanvasSize = UDim2.new(0, 0, 0, pl.AbsoluteContentSize.Y) end)

        local tab = { Name = tabName, Page = tp, Button = tb, Layout = pl, Elements = {}, IsGroupBox = false } -- Added Elements table
        self.Tabs[tabName] = tab
        self.TabButtons[ti] = tab

        tb.MouseButton1Click:Connect(function() self:SetActiveTab(tab) end)
        tb.MouseEnter:Connect(function() if self.ActiveTab ~= tab then tb.BackgroundColor3 = Color3.Lerp(FreakyGui.Theme.Secondary, FreakyGui.Theme.Background, 0.3) end end)
        tb.MouseLeave:Connect(function() if self.ActiveTab ~= tab then tb.BackgroundColor3 = FreakyGui.Theme.Secondary end end)

        if not self.ActiveTab then self:SetActiveTab(tab) end -- Activate first tab added
        updateTabBarScroll()

        -- Add Element Functions and GroupBox function to the Tab
        for name, func in pairs(ElementFunctions) do tab[name] = func end
        tab.AddGroupBox = function(opts) return FreakyGui.CreateGroupBox(tab, opts) end -- Add groupbox creator method

        return tab
    end

    -- Window Visibility and Destruction
    function window:ToggleVisibility() self:SetVisibility(not self.IsVisible) end
    function window:SetVisibility(v) self.IsVisible = v; self.Frame.Visible = v; self.ScreenGui.Enabled = v end
    function window:Destroy()
        local keybindInfo = FreakyGui.KeybindConnections[screenGui]
        if keybindInfo and keybindInfo.UIS_Connection then pcall(keybindInfo.UIS_Connection.Disconnect, keybindInfo.UIS_Connection) end
        FreakyGui.KeybindConnections[screenGui] = nil
        FreakyGui.Windows[screenGui] = nil
        if windowMouseMoveConn then windowMouseMoveConn:Disconnect() end
        if windowMouseReleaseConn then windowMouseReleaseConn:Disconnect() end
        if self.ScreenGui then pcall(self.ScreenGui.Destroy, self.ScreenGui) end
    end

    -- Close Button Action
    closeButton.MouseButton1Click:Connect(function() window:SetVisibility(false) end)

    -- Keybind Listener Setup
    local function createKeybindConnection(keyCode)
        local oldKeybindInfo = FreakyGui.KeybindConnections[screenGui]
        if oldKeybindInfo and oldKeybindInfo.UIS_Connection then
             pcall(oldKeybindInfo.UIS_Connection.Disconnect, oldKeybindInfo.UIS_Connection)
        end

        local conn = UserInputService.InputBegan:Connect(function(i, gp)
            if not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == keyCode then
                if FreakyGui.Windows[screenGui] then FreakyGui.Windows[screenGui]:ToggleVisibility() end
            end
        end)
        FreakyGui.KeybindConnections[screenGui] = { UIS_Connection = conn, KeyCode = keyCode }
    end

    function window:UpdateKeybind(newKeyCode) -- Method to update the keybind
        self.Keybind = newKeyCode
        createKeybindConnection(newKeyCode)
    end
    createKeybindConnection(window.Keybind) -- Initial setup

    -- Theme Update Application Function
    function window:ApplyThemeUpdates()
        -- Update core window elements
        windowFrame.BackgroundColor3 = FreakyGui.Theme.Background
        ApplyStroke(windowFrame, FreakyGui.Theme.Outline, 1)
        ApplyGradient(windowFrame, Color3.Lerp(FreakyGui.Theme.Background, Color3.new(1,1,1), 0.03), FreakyGui.Theme.Background, 90)
        topBar.BackgroundColor3 = FreakyGui.Theme.Header
        ApplyGradient(topBar, Color3.Lerp(FreakyGui.Theme.Header, Color3.new(1,1,1), 0.1), FreakyGui.Theme.Header, 90)
        topBar:FindFirstChild("TopBarCornerFix").BackgroundColor3 = FreakyGui.Theme.Header
        titleLabel.TextColor3 = FreakyGui.Theme.Text
        closeButton.BackgroundColor3 = FreakyGui.Theme.Error
        closeButton.TextColor3 = FreakyGui.Theme.TextActive
        tabArea.BackgroundColor3 = FreakyGui.Theme.Background
        tabArea:FindFirstChild("TabLine").BackgroundColor3 = FreakyGui.Theme.Outline
        leftScroll.BackgroundColor3 = FreakyGui.Theme.Secondary
        leftScroll.TextColor3 = FreakyGui.Theme.Text
        rightScroll.BackgroundColor3 = FreakyGui.Theme.Secondary
        rightScroll.TextColor3 = FreakyGui.Theme.Text

        -- Update Tab Buttons and Pages
        for _, tab in pairs(self.Tabs) do
             if tab.Button then -- Check if it's a real tab (not just Settings initially)
                 if self.ActiveTab == tab then
                     tab.Button.BackgroundColor3 = FreakyGui.Theme.Background
                     tab.Button.TextColor3 = FreakyGui.Theme.TextActive
                     ApplyStroke(tab.Button, FreakyGui.Theme.Outline, 1)
                 else
                     tab.Button.BackgroundColor3 = FreakyGui.Theme.Secondary
                     tab.Button.TextColor3 = FreakyGui.Theme.TextDisabled
                     ApplyStroke(tab.Button, nil, 0)
                 end
            end
            if tab.Page then
                 tab.Page.ScrollBarImageColor3 = FreakyGui.Theme.Primary
            end
             -- Update elements within the tab (including group boxes)
             for _, element in pairs(tab.Elements) do
                if element.UpdateTheme then pcall(element.UpdateTheme) end -- Call the element's own update function
             end
        end
    end

    -- Apply initial theme to potentially existing settings elements just in case
    window:ApplyThemeUpdates()

    return window
end

-- Return the library table for use
return FreakyGui
