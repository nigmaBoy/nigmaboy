-- Core Tool Grip Logic
local gripConfig = { Position = Vector3.new(0, 0, 0), Rotation = Vector3.new(0, 0, 0) }
local currentTool = nil
local uiElements = {}

local function updateToolGrip(toolInstance)
    local toolToUpdate = toolInstance or currentTool
    if toolToUpdate and toolToUpdate:IsA("Tool") and toolToUpdate.Parent then
        pcall(function() toolToUpdate.Grip = CFrame.new(gripConfig.Position)*CFrame.Angles(math.rad(gripConfig.Rotation.X),math.rad(gripConfig.Rotation.Y),math.rad(gripConfig.Rotation.Z)) end)
    end
end

