-- Internal Helper Functions
local function GetScreenSize()
    local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1024, 768) -- Fallback size
    return viewportSize
end

local function CreateElement(elementType, properties)
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        pcall(function() element[prop] = value end)
    end
    return element
end

local function ApplyCorner(guiObject, radius)
    if not guiObject then return end
    local corner = guiObject:FindFirstChildWhichIsA("UICorner")
    if not corner then corner = Instance.new("UICorner"); corner.Parent = guiObject end
    corner.CornerRadius = UDim.new(0, radius or FreakyGui.Theme.CornerRadius); return corner
end

local function ApplyStroke(guiObject, color, thickness)
    if not guiObject then return end
    local stroke = guiObject:FindFirstChildWhichIsA("UIStroke")
    if not stroke then stroke = Instance.new("UIStroke"); stroke.Parent = guiObject end
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or FreakyGui.Theme.Outline
    stroke.Thickness = thickness or 1
    stroke.Enabled = (thickness or 1) > 0
    CollectionService:AddTag(stroke, "FreakyGui_Theme_Outline") -- Tag for dynamic updates
    return stroke
end

-- Helper to update theme color dynamically (Basic Implementation)
local function UpdateElementThemeColor(element, propertyName, themeColorKey)
    if element and propertyName and themeColorKey and FreakyGui.Theme[themeColorKey] then
        pcall(function() element[propertyName] = FreakyGui.Theme[themeColorKey] end)
    end
end

