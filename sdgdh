    local function AddElementToLayout(self, element)
        -- 'self' here can be a Tab object or a GroupBox object
        local targetLayout = self.Layout -- GroupBoxes have Layout, Tabs have MainGroupLayout
        if not targetLayout then
             -- If called on Tab, use its default group's layout
             if self.IsTab and self.DefaultGroupBox then
                 targetLayout = self.DefaultGroupBox.Layout
             else
                 warn("[FreakyGui] Cannot determine layout for element:", element.Name, "Parent:", self.Name)
                 element.Parent = nil -- Prevent adding to wrong place
                 return
             end
        end
        element.Parent = targetLayout.Parent -- Parent to the Frame containing the layout
        element.LayoutOrder = #targetLayout:GetChildren() + 1
        return element
    end

