    local function updateTabBarScroll() task.wait();local cw=tabLayout.AbsoluteContentSize.X;local vw=tabBar.AbsoluteSize.X;local maxS=math.max(0,cw-vw);local canL=tabBar.CanvasPosition.X>5;local canR=tabBar.CanvasPosition.X<maxS-5;local sbw=0;leftScroll.Visible=canL;rightScroll.Visible=canR;if canL then sbw=sbw+SCROLL_BUTTON_WIDTH+TAB_AREA_PADDING end;if canR then sbw=sbw+SCROLL_BUTTON_WIDTH+TAB_AREA_PADDING end;local totalReservedWidth=TAB_AREA_PADDING*2+sbw+SETTINGS_TAB_WIDTH+TAB_AREA_PADDING;tabBar.Size=UDim2.new(1,-totalReservedWidth,1,0);tabBar.Position=UDim2.new(0,TAB_AREA_PADDING+(canL and SCROLL_BUTTON_WIDTH+TAB_AREA_PADDING or 0),0,0);rightScroll.Position=UDim2.new(1,-TAB_AREA_PADDING*2-SETTINGS_TAB_WIDTH-(canR and SCROLL_BUTTON_WIDTH or 0),0,0)end
