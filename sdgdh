            if typeof(FreakyGui.InputCaptureConnections[screenGui]) == "Instance" and FreakyGui.InputCaptureConnections[screenGui]:IsA("TextButton") then
                 -- If it was a keybind picker, reset its state visually
                 local keybindButton = FreakyGui.InputCaptureConnections[screenGui]
                 local keybindObj = self.SettingsTab.Elements["Toggle UI Key"] -- Assumes default name
                 if keybindObj and keybindButton == keybindObj.Button then
                    keybindButton.Text = "Set: "..tostring(self.Keybind):gsub("KeyCode.","")
                    keybindButton.BackgroundColor3 = FreakyGui.Theme.Secondary
                    local stroke = keybindButton:FindFirstChildWhichIsA("UIStroke")
                    if stroke then stroke.Color = FreakyGui.Theme.Outline; stroke.Thickness = 1 end
                 end
             end
            FreakyGui.InputCaptureConnections[screenGui] = nil -- Release capture
        end
    end
    function window:Destroy()
        if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end;
        FreakyGui.Windows[screenGui]=nil;
        if FreakyGui.KeybindConnections[screenGui] then
            pcall(FreakyGui.KeybindConnections[screenGui].Disconnect, FreakyGui.KeybindConnections[screenGui])
            FreakyGui.KeybindConnections[screenGui]=nil;
        end
        -- Clean up input capture state if window is destroyed while capturing
        if FreakyGui.InputCaptureConnections[screenGui] then FreakyGui.InputCaptureConnections[screenGui] = nil end
        -- Disconnect drag listeners
        if windowMouseMoveConn then pcall(windowMouseMoveConn.Disconnect, windowMouseMoveConn) end
        if windowMouseReleaseConn then pcall(windowMouseReleaseConn.Disconnect, windowMouseReleaseConn) end
        -- TODO: Add cleanup for any other connections if necessary (e.g., theme update listeners if implemented)
    end

    closeButton.MouseButton1Click:Connect(function() window:SetVisibility(false) end)

    -- Initial Keybind Setup
    if keybindCode and UserInputService then
         local c=UserInputService.InputBegan:Connect(function(i,gp)
             if not gp and i.UserInputType==Enum.UserInputType.Keyboard and i.KeyCode==window.Keybind then
                 -- Only toggle if no input element has focus within this GUI
                 if not FreakyGui.InputCaptureConnections[screenGui] then
                     if FreakyGui.Windows[screenGui] then FreakyGui.Windows[screenGui]:ToggleVisibility() end
                 end
             end
         end)
         FreakyGui.KeybindConnections[screenGui]=c
     end

    return window
end

-- Return the library table for use
return FreakyGui
