-- Calculate Default Window Size (if not set) based on Screen Size
local function GetDefaultWindowSize()
    local viewportSize = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1024, 768) -- Fallback
    local defaultWidth = math.floor(viewportSize.X / 4)
    local defaultHeight = math.floor(defaultWidth / 3)
    return defaultWidth, defaultHeight
end

if FreakyGui.Theme.WindowWidth <= 0 or FreakyGui.Theme.WindowHeight <= 0 then
    FreakyGui.Theme.WindowWidth, FreakyGui.Theme.WindowHeight = GetDefaultWindowSize()
end


-- Internal Helper Functions
local function CreateElement(elementType, properties)
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        pcall(function() element[prop] = value end)
    end
    return element
end

local function ApplyCorner(guiObject, radius)
    if not guiObject then return end
    local corner = guiObject:FindFirstChildWhichIsA("UICorner")
    if not corner then corner = Instance.new("UICorner"); corner.Parent = guiObject end
    corner.CornerRadius = UDim.new(0, radius or FreakyGui.Theme.CornerRadius); return corner
end

local function ApplyStroke(guiObject, color, thickness)
    if not guiObject then return end
    local stroke = guiObject:FindFirstChildWhichIsA("UIStroke")
    if not stroke then stroke = Instance.new("UIStroke"); stroke.Parent = guiObject end
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or FreakyGui.Theme.Outline
    stroke.Thickness = thickness or FreakyGui.Theme.OutlineThickness
    stroke.Enabled = (thickness or FreakyGui.Theme.OutlineThickness) > 0
    return stroke
end

local function CalculateTextWidth(text, size, font)
    local textSize = TextService:GetTextSize(text, size, font, Vector2.new(math.huge, math.huge))
    return textSize.X
end

