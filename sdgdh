-- Internal Helper Functions
local function CreateElement(elementType, properties)
    local element = Instance.new(elementType)
    for prop, value in pairs(properties or {}) do
        pcall(function() element[prop] = value end)
    end
    return element
end

local function ApplyCorner(guiObject, radius)
    if not guiObject then return end
    local corner = guiObject:FindFirstChildWhichIsA("UICorner")
    if not corner then corner = Instance.new("UICorner"); corner.Parent = guiObject end
    corner.CornerRadius = UDim.new(0, radius or FreakyGui.Theme.CornerRadius)
    return corner
end

local function ApplyStroke(guiObject, color, thickness)
    if not guiObject then return end
    local stroke = guiObject:FindFirstChildWhichIsA("UIStroke")
    if not stroke then stroke = Instance.new("UIStroke"); stroke.Parent = guiObject end
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color or FreakyGui.Theme.Outline
    stroke.Thickness = thickness or 1
    stroke.Enabled = (thickness or 1) > 0
    return stroke
end

local function ApplyGradient(guiObject, color1, color2, rotation)
    if not guiObject then return end
    local gradient = guiObject:FindFirstChildWhichIsA("UIGradient")
    if not gradient then gradient = Instance.new("UIGradient"); gradient.Parent = guiObject end
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color1 or FreakyGui.Theme.Header),
        ColorSequenceKeypoint.new(1, color2 or FreakyGui.Theme.Background)
    })
    gradient.Rotation = rotation or 90 -- Default vertical
    return gradient
end

-- Clamp function needed for color sliders
local function Clamp(value, min, max)
    return math.max(min, math.min(max, value))
end

