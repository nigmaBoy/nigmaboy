    -- Keybind Picker (Specific to Settings Tab usually)
    function ElementFunctions:AddKeybindPicker(opts)
        opts = opts or {}
        local t = opts.Text or "Toggle Keybind"
        local currentKey = opts.CurrentKey or Enum.KeyCode.RightShift
        local windowRef = opts.Window -- IMPORTANT: Pass the window object here!
        local cb = opts.Callback or function(newKey) print(t .. " set to: " .. newKey.Name) end
        local layout, parent = getLayoutAndParent(self)
        local currentElementIndex = #layout:GetChildren() + 1

        local kbButton = CreateElement("TextButton", {
            Name = t .. "_KeybindButton",
            Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, FreakyGui.Theme.ElementHeight),
            Text = t .. " [" .. currentKey.Name .. "]",
            BackgroundColor3 = FreakyGui.Theme.Secondary,
            TextColor3 = FreakyGui.Theme.Text,
            Font = FreakyGui.Theme.Font,
            TextSize = FreakyGui.Theme.FontSize,
            LayoutOrder = currentElementIndex,
            Parent = parent,
            AutoButtonColor = false
        })
        ApplyCorner(kbButton)
        ApplyStroke(kbButton)

        local isBinding = false

        kbButton.MouseButton1Click:Connect(function()
            if isBinding or FreakyGui.ActiveKeybindListener then return end -- Prevent multiple bindings
            isBinding = true
            FreakyGui.ActiveKeybindListener = windowRef.ScreenGui -- Mark that *a* bind is active
            kbButton.Text = t .. " [Press Key...]"
            kbButton.TextColor3 = FreakyGui.Theme.Primary

            local inputConn
            inputConn = UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end -- Ignore game processed events
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    local newKey = input.KeyCode
                    if newKey == Enum.KeyCode.Unknown or newKey == Enum.KeyCode.Escape then -- Allow Esc to cancel
                       kbButton.Text = t .. " [" .. currentKey.Name .. "]"
                       kbButton.TextColor3 = FreakyGui.Theme.Text
                    else
                        currentKey = newKey
                        kbButton.Text = t .. " [" .. currentKey.Name .. "]"
                        kbButton.TextColor3 = FreakyGui.Theme.Text
                        windowRef:UpdateKeybind(currentKey) -- Call window method to update listener
                        pcall(cb, currentKey)
                    end
                    isBinding = false
                    FreakyGui.ActiveKeybindListener = nil
                    if inputConn then inputConn:Disconnect() end
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 then -- Cancel on click elsewhere
                    kbButton.Text = t .. " [" .. currentKey.Name .. "]"
                    kbButton.TextColor3 = FreakyGui.Theme.Text
                    isBinding = false
                    FreakyGui.ActiveKeybindListener = nil
                    if inputConn then inputConn:Disconnect() end
                end
            end)
        end)

        local keybindObj = { Button=kbButton, Get=function() return currentKey end,
            UpdateTheme = function() -- Add UpdateTheme
                if not isBinding then kbButton.TextColor3 = FreakyGui.Theme.Text end
                kbButton.BackgroundColor3 = FreakyGui.Theme.Secondary
                ApplyStroke(kbButton, FreakyGui.Theme.Outline, 1)
            end
         }
        self.Elements[t] = keybindObj
        return keybindObj
    end

    -- Color Picker (RGB Sliders)
    function ElementFunctions:AddColorPicker(opts)
        opts = opts or {}
        local t = opts.Text or "Color Setting"
        local themeKey = opts.ThemeKey -- e.g., "Background", "Primary"
        local defaultColor = opts.DefaultColor or FreakyGui.Theme[themeKey] or Color3.new(1,1,1)
        local windowRef = opts.Window -- Pass the window object
        local cb = opts.Callback or function(color) print(t.." set to:", color) end
        local layout, parent = getLayoutAndParent(self)
        local currentElementIndex = #layout:GetChildren() + 1

        local frameHeight = FreakyGui.Theme.ElementHeight * 2.5 -- Needs more space for sliders
        local cpFrame = CreateElement("Frame", {
            Name = t .. "_ColorPickerFrame",
            Size = UDim2.new(1, -FreakyGui.Theme.Padding * 2, 0, frameHeight),
            BackgroundTransparency = 1,
            LayoutOrder = currentElementIndex,
            Parent = parent,
        })

        local cpLabel = CreateElement("TextLabel", { Name = "Label", Size = UDim2.new(0.7, -FreakyGui.Theme.Padding, 0, FreakyGui.Theme.FontSize), Position = UDim2.new(0, FreakyGui.Theme.Padding, 0, 2), BackgroundTransparency = 1, Font = FreakyGui.Theme.Font, TextSize = FreakyGui.Theme.FontSize, TextColor3 = FreakyGui.Theme.Text, Text = t, TextXAlignment = Enum.TextXAlignment.Left, Parent = cpFrame })
        local cpSwatch = CreateElement("Frame", { Name = "Swatch", Size = UDim2.new(0.3, -FreakyGui.Theme.Padding, 0, FreakyGui.Theme.FontSize + 4), Position = UDim2.new(0.7, FreakyGui.Theme.Padding, 0, 0), BackgroundColor3 = defaultColor, Parent = cpFrame }); ApplyCorner(cpSwatch); ApplyStroke(cpSwatch)

        local sliderContainer = CreateElement("Frame", { Name = "SliderContainer", Size = UDim2.new(1, 0, 1, -FreakyGui.Theme.FontSize - 8), Position = UDim2.new(0, 0, 0, FreakyGui.Theme.FontSize + 8), BackgroundTransparency = 1, Parent = cpFrame })
        local sliderLayout = CreateElement("UIListLayout", { Parent = sliderContainer, FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) })

        local sliders = {}
        local currentColor = defaultColor

        local function updateColor(sourceSlider)
            local r = Clamp(sliders.R:Get(), 0, 255)
            local g = Clamp(sliders.G:Get(), 0, 255)
            local b = Clamp(sliders.B:Get(), 0, 255)
            currentColor = Color3.fromRGB(r, g, b)
            cpSwatch.BackgroundColor3 = currentColor

            -- Update Theme and trigger window refresh ONLY IF the color actually changed
            if FreakyGui.Theme[themeKey] ~= currentColor then
                 FreakyGui.Theme[themeKey] = currentColor
                 if windowRef and windowRef.ApplyThemeUpdates then
                     windowRef:ApplyThemeUpdates() -- Update the GUI visuals
                 end
                 pcall(cb, currentColor)
            end
        end

        for i, comp in ipairs({"R", "G", "B"}) do
            local slider = self:AddSlider({ -- Use AddSlider internally
                Text = comp,
                Min = 0,
                Max = 255,
                Default = defaultColor[comp] * 255,
                Increment = 1,
                Suffix = "",
                Callback = updateColor -- Use the combined update function
            })
            -- Need to adjust the slider frame's parent and size slightly
            slider.Frame.Parent = sliderContainer
            slider.Frame.Size = UDim2.new(1, 0, 0, slider.Frame.Size.Y.Offset) -- Use calculated height, full width
            slider.Frame.LayoutOrder = i
            sliders[comp] = slider -- Store the slider object itself
        end

        local cpObject = { Frame = cpFrame, Get = function() return currentColor end,
            UpdateTheme = function() -- Only need to update swatch stroke and label color here
                 cpLabel.TextColor3 = FreakyGui.Theme.Text
                 ApplyStroke(cpSwatch, FreakyGui.Theme.Outline, 1)
                 -- Individual sliders update themselves via their own UpdateTheme
                 for _, slider in pairs(sliders) do
                     if slider.UpdateTheme then slider.UpdateTheme() end
                 end
            end
        }
        self.Elements[t] = cpObject
        return cpObject
    end
end

