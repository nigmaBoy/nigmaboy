-- Tool Activations (REVISED)
local function ConnectTool(tool, config)
    tool.Activated:Connect(function()
        if Grabbed and LocalPlayer.Character.BodyEffects.Grabbed.Value ~= nil then
            local targetName = tostring(LocalPlayer.Character.BodyEffects.Grabbed.Value)
            LockPlayer(game:GetService("Players")[targetName], config)
        end
    end)
end
-- Function to make the grabbed player follow behind (MISSING FROM YOUR SCRIPT)
local function RegularGrab(target)
    if target and target.Character then
        local upperTorso = target.Character:FindFirstChild("UpperTorso")
        if upperTorso then
            local bodypos = Instance.new('BodyPosition', upperTorso)
            bodypos.D = 60
            bodypos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

            local bodygyro = Instance.new('BodyGyro', upperTorso)
            bodygyro.D = 50
            bodygyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

            game:GetService('RunService').Heartbeat:Connect(function()
                local offset = Vector3.new(0, HeightOffset, -5)
                local targetPosition = LocalPlayer.Character.HumanoidRootPart.Position + 
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * offset.Z) +
                    (LocalPlayer.Character.HumanoidRootPart.CFrame.UpVector * offset.Y)
                
                bodypos.Position = targetPosition
                bodygyro.CFrame = CFrame.new(upperTorso.Position, LocalPlayer.Character.HumanoidRootPart.Position)
            end)
        end
    end
end
