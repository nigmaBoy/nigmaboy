-- Function to lock the grabbed player
-- Modified LockPlayer function with heartbeat tracking
local function LockPlayer(target, bodyPartConfig)
    if target and target.Character then
        -- Disconnect existing connection
        if activeHeartbeatConnection then
            activeHeartbeatConnection:Disconnect()
            activeHeartbeatConnection = nil
        end
        -- Add safety check for LocalPlayer's character
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            return
        end

        local heartbeatConnection
        local jerking = false
        local jerkTime = 0
        local jerkSpeed = 20
        local jerkAmount = 0.5

        -- Disable target's physics
        local humanoid = target.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end

        activeHeartbeatConnection = game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
            -- Calculate base rotation
            local playerHRP = LocalPlayer.Character.HumanoidRootPart
            local baseCFrame = playerHRP.CFrame * CFrame.Angles(0, math.rad(90), 0)

            -- Position each part INDEPENDENTLY relative to your character
            for partName, config in pairs(bodyPartConfig) do
                local part = target.Character:FindFirstChild(partName)
                if part then
                    -- Calculate position relative to YOUR character
                    part.CFrame = baseCFrame
                        * CFrame.new(config.Offset)
                        * config.Rotation
                    
                    -- Zero out velocities
                    part.Velocity = Vector3.new()
                    part.RotVelocity = Vector3.new()
                end
            end

            -- Jerking animation (Test Tool only)
            if bodyPartConfig == TestToolBodyPartConfig then
                jerkTime += deltaTime * jerkSpeed
                local rightUpperArm = target.Character:FindFirstChild("RightUpperArm")
                local rightLowerArm = target.Character:FindFirstChild("RightLowerArm")
                if rightUpperArm and rightLowerArm then
                    local jerkOffset = math.sin(jerkTime) * jerkAmount
                    rightUpperArm.CFrame = rightUpperArm.CFrame * CFrame.new(jerkOffset, 0, 0)
                    rightLowerArm.CFrame = rightLowerArm.CFrame * CFrame.new(jerkOffset, 0, 0)
                end
            end
        end)

        -- Modified cleanup connections to use activeHeartbeatConnection
        target.Character.Humanoid.Died:Connect(function()
            if activeHeartbeatConnection then
                activeHeartbeatConnection:Disconnect()
                activeHeartbeatConnection = nil
            end
            Grabbed = false
        end)

        game.Players.LocalPlayer.Character.BodyEffects.Grabbed:GetPropertyChangedSignal("Value"):Connect(function()
            if game.Players.LocalPlayer.Character.BodyEffects.Grabbed.Value == nil then
                if activeHeartbeatConnection then
                    activeHeartbeatConnection:Disconnect()
                    activeHeartbeatConnection = nil
                end
                Grabbed = false
                -- Restore physics
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end)
    end
end

-- Create Tools PROPERLY
local function CreateTool(name)
    local tool = Instance.new("Tool")
    tool.RequiresHandle = false
    tool.Name = name
    tool.Parent = LocalPlayer:WaitForChild("Backpack")
    return tool
end

